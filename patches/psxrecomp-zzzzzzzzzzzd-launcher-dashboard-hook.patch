+/* Console-style launcher front end, registered by a title's own code (see
+ * mod_plugins.h). Copied so the registrant's struct need not outlive the call;
+ * the strings it points at must. */
+static PsxLauncherDashboard g_launcher_dashboard;
+static bool g_launcher_dashboard_set = false;
+extern "C" int psx_mod_set_launcher_dashboard(const PsxLauncherDashboard* dashboard) {
+    if (!dashboard) return 0;
+    g_launcher_dashboard = *dashboard;
+    g_launcher_dashboard_set = true;
+    return 1;
+}
+#if defined(RECOMP_LAUNCHER)
+static void apply_launcher_dashboard_to_game_info(RecompLauncherCGameInfo* gi) {
+    if (!gi || !g_launcher_dashboard_set) return;
+    gi->console_dashboard      = g_launcher_dashboard.console_dashboard;
+    gi->dashboard_logo_path    = g_launcher_dashboard.logo_path;
+    gi->dashboard_backdrop_path = g_launcher_dashboard.backdrop_path;
+    gi->dashboard_accent       = g_launcher_dashboard.accent;
+    gi->dashboard_footer_text  = g_launcher_dashboard.footer_text;
+    gi->save_summary           = g_launcher_dashboard.save_summary;
+}
+#endif
