+void ModPackageManager::set_option_defaults(std::vector<OptionDefault> defaults) {
+    option_defaults_ = std::move(defaults);
+    apply_option_defaults();
+}
+
+void ModPackageManager::apply_option_defaults() {
+    for (const OptionDefault& d : option_defaults_) {
+        const auto by_id = packages_.find(d.package_id);
+        if (by_id == packages_.end()) {
+            std::fprintf(stderr,
+                "psxrecomp: mod_option_default: no package %s installed\n",
+                d.package_id.c_str());
+            continue;
+        }
+        for (auto& by_version : by_id->second) {
+            ModPackage& package = by_version.second;
+            ModOption* option = nullptr;
+            for (ModOption& o : package.options)
+                if (o.feature_id == d.feature_id && o.id == d.option_id) { option = &o; break; }
+            if (!option) {
+                std::fprintf(stderr,
+                    "psxrecomp: mod_option_default: %s %s has no option %s\n",
+                    d.package_id.c_str(), d.feature_id.c_str(), d.option_id.c_str());
+                continue;
+            }
+            bool ok = false;
+            switch (option->type) {
+            case ModOptionType::Boolean:
+                ok = d.value == "true" || d.value == "false";
+                break;
+            case ModOptionType::Choice:
+                for (const ModChoice& c : option->choices)
+                    if (c.value == d.value) { ok = true; break; }
+                break;
+            case ModOptionType::Integer: {
+                char* end = nullptr;
+                const long long v = std::strtoll(d.value.c_str(), &end, 10);
+                ok = end && *end == '\0' && !d.value.empty() &&
+                     v >= option->min_value && v <= option->max_value;
+                break;
+            }
+            default:
+                break;
+            }
+            if (!ok) {
+                std::fprintf(stderr,
+                    "psxrecomp: mod_option_default: %s/%s/%s rejects value \"%s\"\n",
+                    d.package_id.c_str(), d.feature_id.c_str(), d.option_id.c_str(),
+                    d.value.c_str());
+                continue;
+            }
+            option->default_value = d.value;
+        }
+    }
+}
