 recompiler/src/config_loader.cpp |  17 +++--
 recompiler/src/config_loader.h   |   5 +-
 runtime/src/debug_server.c       |  10 ++-
 runtime/src/gpu_gl_renderer.c    | 121 ++++++++++++++++++++++---------
 runtime/src/main.cpp             |  12 +--
 5 files changed, 117 insertions(+), 48 deletions(-)

