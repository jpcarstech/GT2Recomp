+// One preset, one meaning: ORIGINAL is the 1999 game - picture settings as the
+// PlayStation drew them AND every enhancement off; ENHANCED is the modern
+// picture AND the game's Enhanced mod set. Applying either does both. The
+// Mods page and Settings > Display show the same two pills, lit when both
+// halves match.
+static const RecompLauncherCFeaturePreset* console_mod_preset(LauncherModel* m, int enhanced) {
+    const char* want = enhanced ? "Enhanced" : "Original";
+    for (int pi = 0; pi < m->num_feature_presets; ++pi) {
+        const RecompLauncherCFeaturePreset* pr = &m->feature_presets[pi];
+        if (pr->label && SDL_strcasecmp(pr->label, want) == 0) return pr;
+    }
+    return NULL;
+}
+static void console_apply_preset(LauncherModel* m, int enhanced) {
+    launcher_model_apply_display_preset(m, enhanced);
+    if (const RecompLauncherCFeaturePreset* pr = console_mod_preset(m, enhanced)) {
+        const int keep = m->mod_group_filter;
+        m->mod_group_filter = m->mods && mods_have_cheat_features(m) ? 1 : 0;   /* the Mods scope, never cheats */
+        apply_feature_preset(m, pr);
+        m->mod_group_filter = keep;
+    }
+}
+static int console_preset_active(LauncherModel* m) {
+    const int disp = launcher_model_display_preset_active(m);
+    if (disp < 0) return -1;
+    const char* mods = console_mods_value(m);
+    const RecompLauncherCFeaturePreset* pr = console_mod_preset(m, disp);
+    if (!pr) return disp;                                   /* no mod presets: the picture decides */
+    return (mods && pr->label && SDL_strcasecmp(mods, pr->label) == 0) ? disp : -1;
+}
+static const char* console_preset_name(LauncherModel* m) {
+    const int a = console_preset_active(m);
+    return a == 1 ? ui_text("Enhanced") : a == 0 ? ui_text("Original") : ui_text("Custom");
+}
+static const char* const kPresetLabels[2] = { "ORIGINAL", "ENHANCED" };
+static const char* const kPresetHelps[2] = {
+    "The 1999 game: the picture as the PlayStation drew it and every enhancement off.",
+    "The modern setup: 4x supersampling, filtered textures, FXAA and cropped movies, plus the "
+    "Enhanced enhancement set (widescreen, geometry correction, longer draw distance, full-detail AI, "
+    "CPU overclock, fast loading)." };
+static void console_preset_pills(LauncherModel* m, const LauncherTheme& th) {
+    const int pick = console_pill_pair("preset_pills", kPresetLabels, console_preset_active(m), kPresetHelps, th);
+    if (pick >= 0) console_apply_preset(m, pick);
+}
+
+// The same pair as a block for the main menu: an eyebrow over two pills that
+// share the menu's width. Returns the block's height so the caller can
+// anchor it.
+static float console_preset_block_height() { return ImGui::GetTextLineHeight() * 0.78f + px(2.0f) + px(38.0f); }
+static void console_preset_block(LauncherModel* m, const LauncherTheme& th, float w) {
+    console_eyebrow(ui_text("GRAPHICS"), th);
+    ImGui::Dummy(ImVec2(0, px(2.0f)));
+    const float pw = (w - px(6.0f)) * 0.5f;
+    const int pick = console_pill_pair("preset_block", kPresetLabels, console_preset_active(m), kPresetHelps, th, pw, px(38.0f));
+    if (pick >= 0) console_apply_preset(m, pick);
+}
