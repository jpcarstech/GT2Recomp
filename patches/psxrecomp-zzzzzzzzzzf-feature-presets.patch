     };
     std::vector<FeaturedFeatureRow> featured_feature_rows;
 
+    // feature_preset: a one-click enhancement preset offered on the launcher's
+    // mods page beside Enable all / Disable all. Applying one clears the page
+    // in view and switches on exactly what it names, so "play it like 1999"
+    // and "play it enhanced" are one button each instead of a page of
+    // checkboxes the player has to understand the dependencies of.
+    //   [[runtime.feature_preset]]
+    //   label = "Enhanced"
+    //   description = "Widescreen, 60 FPS, longer draw distance..."
+    //   enable = ["gt2.silent-enhancements/aspect", "..."]   # package/feature
+    struct FeaturePreset {
+        std::string label;
+        std::string description;
+        std::vector<std::string> enable;
+    };
+    std::vector<FeaturePreset> feature_presets;
