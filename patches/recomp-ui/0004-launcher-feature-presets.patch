+/* One-click enhancement preset (GameInfo.feature_presets). A preset is the
+ * answer to a page of checkboxes: "play it like 1999" and "play it enhanced"
+ * are the two things most players actually want, and expecting them to know
+ * which features depend on which is a losing bet. Applying one turns off
+ * every feature on the page in view (exactly what Disable all does, so the
+ * scope is one the player already understands), then enables the named ones.
+ * Each entry in `enable` is "package_id/feature_id". */
+typedef struct RecompLauncherCFeaturePreset {
+    const char* label;        /* button text, e.g. "Authentic 1999" */
+    const char* description;  /* tooltip: what this preset turns on */
+    const char* const* enable;
+    int num_enable;
+} RecompLauncherCFeaturePreset;
