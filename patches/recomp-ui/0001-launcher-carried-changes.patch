         if ((feature.enabled != 0) == enabled) continue;
         if (!mods->feature_enable(mods->ctx, feature.package_id, feature.id,
                                   enabled ? 1 : 0)) {
@@ -7065,9 +7149,11 @@ static bool set_all_mod_features(LauncherModel* m, bool enabled) {
