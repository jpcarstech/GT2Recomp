 }
 
+static std::vector<std::vector<const char*>> g_preset_enable_ptrs;
+static std::vector<RecompLauncherCFeaturePreset> g_presets_abi;
+static void apply_feature_presets_to_game_info(RecompLauncherCGameInfo* gi) {
+    if (!gi || g_feature_presets_cfg.empty()) return;
+    if (g_presets_abi.empty()) {
+        g_preset_enable_ptrs.clear();
+        g_preset_enable_ptrs.reserve(g_feature_presets_cfg.size());
+        for (const auto& p : g_feature_presets_cfg) {
+            g_preset_enable_ptrs.emplace_back();
+            auto& ids = g_preset_enable_ptrs.back();
+            for (const auto& e : p.enable) ids.push_back(e.c_str());
+        }
+        for (size_t i = 0; i < g_feature_presets_cfg.size(); ++i) {
+            const auto& p = g_feature_presets_cfg[i];
+            RecompLauncherCFeaturePreset out{};
+            out.label = p.label.c_str();
+            out.description =
+                p.description.empty() ? nullptr : p.description.c_str();
+            out.enable = g_preset_enable_ptrs[i].empty()
+                ? nullptr : g_preset_enable_ptrs[i].data();
+            out.num_enable = (int)g_preset_enable_ptrs[i].size();
+            g_presets_abi.push_back(out);
+        }
+    }
+    gi->feature_presets = g_presets_abi.data();
+    gi->num_feature_presets = (int)g_presets_abi.size();
+}
