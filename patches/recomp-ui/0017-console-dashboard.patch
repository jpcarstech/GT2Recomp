+static void track_restore_rect(LauncherPlatform* p) {
+    if (!p || !p->window) return;
+    const SDL_WindowFlags fl = SDL_GetWindowFlags(p->window);
+    if (p->fullscreen) return;
+    if (fl & (SDL_WINDOW_MAXIMIZED | SDL_WINDOW_FULLSCREEN | SDL_WINDOW_MINIMIZED)) return;
+    int x = 0, y = 0, w = 0, h = 0;
