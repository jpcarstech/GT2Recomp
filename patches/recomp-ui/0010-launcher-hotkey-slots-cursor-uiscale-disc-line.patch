+/* [KeyMap] values are a comma-separated list the runtime matches any of
+ * ("F8, Ctrl+R"); the launcher shows the first two as Primary / Secondary.
+ * Writing one slot keeps the other. keycode 0 clears the slot. */
+void launcher_binds_hotkey_slot_label(const LauncherModel* m, LngHotkey h, int slot,
+                                      char* out, size_t cap) {
+    out[0] = 0;
+    if (!m || h < 0 || h >= LNG_HK_COUNT) return;
+    const char* v = m->hotkeys[h];
+    if (!v[0] || !strcmp(v, "(unbound)")) return;
+    const char* comma = strchr(v, ',');
+    const char* p = v; size_t n;
+    if (slot == 0) n = comma ? (size_t)(comma - v) : strlen(v);
+    else { if (!comma) return; p = comma + 1; while (*p == ' ') ++p; n = strlen(p);
+           const char* c2 = strchr(p, ','); if (c2) n = (size_t)(c2 - p); }
+    while (n && (p[n-1] == ' ' || p[n-1] == '\t')) --n;
+    if (n >= cap) n = cap - 1;
+    memcpy(out, p, n); out[n] = 0;
+}
+
+void launcher_binds_set_hotkey_slot(LauncherModel* m, LngHotkey h, int slot, int keycode, int kmod) {
