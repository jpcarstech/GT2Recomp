index 00000000..ac129bb4
--- /dev/null
+++ b/tools/port_duckstation_texfilters.py
@@ -0,0 +1,97 @@
+#!/usr/bin/env python3
+"""port_duckstation_texfilters.py - regenerate runtime/src/gpu_gl_texfilters.h
+
+    port_duckstation_texfilters.py <path to duckstation src/core/gpu_hw_shadergen.cpp> [out.h]
+
+Lifts the xBR, Scale2x, Scale3x, MMPX, MMPX Enhanced and MMPX Advanced
+blocks out of GPU_HW_ShaderGen::WriteBatchTextureFilter (the raw-string
+bodies plus the plain-string #define lines in front of them) and writes each
+as a C string constant. Two edits are applied on the way: the xBR block's
+I.w coverage test reads texel I (upstream reads H - a typo), and MMPX's
+#define src, which upstream splits across two C string pieces, is rejoined
+onto one line so the GLSL preprocessor accepts it, and a uint sample
+compared with a bare 0 gets the 0u GLSL 3.30 needs (4.00 converts
+implicitly, which is why upstream compiles). Everything else is verbatim; the HLSL-style names the blocks use (float4, lerp, frac,
+VECTOR_EQ, SampleFromVRAM, packUnorm4x8 ...) are supplied by TEX_FS_COMPAT
+in gpu_gl_renderer.c.
+"""
+import re, sys
+
+ORDER = [('xBR', 5, 'XBR'), ('Scale2x', 6, 'SCALE2X'), ('Scale3x', 7, 'SCALE3X'),
+         ('MMPX', 8, 'MMPX'), ('MMPXEnhanced', 9, 'MMPX_ENHANCED'),
+         ('MMPXAdvanced', 10, 'MMPX_ADVANCED')]
+
+def extract(lines):
+    idx = []
+    for i, l in enumerate(lines):
+        m = re.search(r'texture_filter == GPUTextureFilter::(\w+)', l)
+        if m and ('else if' in l or (('if (' in l) and not idx)):
+            idx.append((m.group(1), i))
+    end = [i for i, l in enumerate(lines)
+           if 'GPU_HW_ShaderGen::GenerateBatchFragmentShader' in l][0]
+    bounds = {}
+    for k, (name, i) in enumerate(idx):
+        bounds[name] = (i, idx[k + 1][1] if k + 1 < len(idx) else end)
+    out = {}
+    for name, _, _ in ORDER:
+        i, j = bounds[name]; seg = lines[i:j]; text = []; k = 0
+        while k < len(seg):
+            l = seg[k]
+            if 'R"(' in l:
+                after = l.split('R"(', 1)[1]; buf = [after] if after.strip() else []; k += 1
+                while k < len(seg) and ')"' not in seg[k]:
+                    buf.append(seg[k]); k += 1
+                if k < len(seg):
+                    last = seg[k].split(')"')[0]
+                    if last.strip(): buf.append(last)
+                text.extend(buf)
+            elif l.strip().startswith('ss << "') or (l.strip().startswith('"') and 'uv_limits' in l):
+                for piece in re.findall(r'"((?:[^"\\]|\\.)*)"', l):
+                    text.append(piece.encode().decode('unicode_escape'))
+            k += 1
+        out[name] = '\n'.join(text)
+    return out
+
+def main():
+    if len(sys.argv) < 2:
+        print(__doc__.strip(), file=sys.stderr); return 2
+    src = open(sys.argv[1], encoding='utf-8').read().split('\n')
+    dst = sys.argv[2] if len(sys.argv) > 2 else 'runtime/src/gpu_gl_texfilters.h'
+    d = extract(src)
+    out = ['/* Texture-filter fragment-shader blocks ported from DuckStation\n'
+           ' * (src/core/gpu_hw_shadergen.cpp, GPU_HW_ShaderGen::WriteBatchTextureFilter),\n'
+           ' * verbatim apart from: (1) the xBR I.w coverage test reading texel I rather\n'
+           ' * than H (an upstream typo); (2) MMPX\'s #define src rejoined onto one line;\n'
+           ' * (3) uint samples compared with a bare 0 spelled 0u (GLSL 3.30).\n'
+           ' * Each block defines FilteredSampleFromVRAM(texpage, coords, uv_limits,\n'
+           ' * out texcol, out ialpha) against the HLSL-style names (float4, lerp, frac,\n'
+           ' * VECTOR_EQ, SampleFromVRAM, packUnorm4x8 ...) that gpu_gl_renderer.c\'s\n'
+           ' * TEX_FS_COMPAT maps onto GLSL 3.30. Licences: xBR (C) Hyllian, MIT;\n'
+           ' * MMPX (C) Morgan McGuire & Mara Gagiu, MIT; MMPX Enhanced/Advanced\n'
+           ' * (C) crashGG, MIT; Scale2x/3x after scale2x.it. Generated by\n'
+           ' * tools/port_duckstation_texfilters.py - edit that, not this. */\n'
+           '#ifndef GPU_GL_TEXFILTERS_H\n#define GPU_GL_TEXFILTERS_H\n']
+    for name, mode, cname in ORDER:
+        t = d[name]
+        if name == 'xBR':
+            bad = 'I.w = float(VECTOR_NEQ(H, TRANSPARENT_PIXEL_COLOR));'
+            assert t.count(bad) == 1, 'xBR I.w line moved upstream - re-check the typo fix'
+            t = t.replace(bad, 'I.w = float(VECTOR_NEQ(I, TRANSPARENT_PIXEL_COLOR));')
+        t = t.replace(', \nuv_limits))', ', uv_limits))')
+        # GLSL 3.30 has no implicit int->uint conversion (4.00 does, which is
+        # why upstream compiles): a uint sample compared against a bare 0.
+        t = re.sub(r'\b([A-Z][A-Za-z0-9]*)(\s*(?:==|!=)\s*)0(?![u.\d])', r'\1\g<2>0u', t)
+        lines = t.split('\n')
+        while lines and not lines[-1].strip(): lines.pop()
+        out.append(f'/* mode {mode}: DuckStation {name} */\nstatic const char *TEXFILTER_{cname}_SRC =\n')
+        for l in lines:
+            l = l.replace('\t', '    ')
+            out.append('    "' + l.replace('\\', '\\\\').replace('"', '\\"') + '\\n"\n')
+        out.append('    ;\n\n')
+    out.append('#endif /* GPU_GL_TEXFILTERS_H */\n')
+    open(dst, 'w', encoding='utf-8').write(''.join(out))
+    print(f'{dst}: {sum(len(d[n].splitlines()) for n, _, _ in ORDER)} shader lines')
+    return 0
+
+if __name__ == '__main__':
+    sys.exit(main())
