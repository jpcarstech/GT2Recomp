+ * takes the same share of the screen instead of shrinking as monitors grow. */
+static float ui_scale_target(SDL_Window* win) {
+    SDL_DisplayID display = win ? SDL_GetDisplayForWindow(win)
+                                : SDL_GetPrimaryDisplay();
+    float s = win ? SDL_GetWindowDisplayScale(win)
+                  : (display ? SDL_GetDisplayContentScale(display) : 1.0f);
+    if (s <= 0.0f) s = 1.0f;
+    if (s <= 1.001f) {
+        const SDL_DisplayMode* dm = SDL_GetDesktopDisplayMode(display);
+        if (dm && dm->h > 1100) s = (float)dm->h / 1080.0f;
+    }
+    /* Test hook: LNG_FORCE_SCALE=<0.5..4> pins the scale on any display, which
+     * is how the Deck/HiDPI layouts are checked without that hardware. */
+    const char* fs = SDL_getenv("LNG_FORCE_SCALE");
+    if (fs && fs[0]) {
+        float v = (float)SDL_atof(fs);
+        if (v >= 0.25f && v <= 4.0f) s = v;
+    }
+    if (s > LNG_MAX_UI_SCALE) s = LNG_MAX_UI_SCALE;
+    return s;
