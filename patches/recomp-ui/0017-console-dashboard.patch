+// Two pills at the right of the title row (the display presets). `on` marks
+// the active one (-1 for none); returns the one picked this frame or -1.
+// `fixed_w` > 0 lays both pills out at that width from the current cursor
+// (the dashboard block); otherwise they size to their text and sit at the
+// right of the page title row, and the top row hands ▲ to them.
+static int console_pill_pair(const char* id, const char* const labels[2], int on, const char* const helps[2],
+                             const LauncherTheme& th, float fixed_w = 0.0f, float fixed_h = 0.0f) {
+    ImDrawList* dl = ImGui::GetWindowDrawList();
+    const float availw = ImGui::GetContentRegionAvail().x;
+    const float ph = fixed_h > 0.0f ? fixed_h : px(30.0f), pgap = px(6.0f);
+    push_bold_font();
+    ImGui::SetWindowFontScale(0.85f);
+    float pw[2];
+    for (int i = 0; i < 2; ++i) pw[i] = fixed_w > 0.0f ? fixed_w : ImGui::CalcTextSize(ui_text(labels[i])).x + px(32.0f);
+    ImGui::SetWindowFontScale(1.0f);
+    pop_bold_font();
+    int picked = -1;
+    if (fixed_w <= 0.0f) {
+        s_console_pills_drawn = true;
+        ImGui::SetCursorPos(ImVec2(ImGui::GetCursorStartPos().x + availw - pw[0] - pw[1] - pgap, s_page_title_top + px(8.0f)));
+    }
+    ImGui::PushID(id);
+    for (int i = 0; i < 2; ++i) {
+        if (i) ImGui::SameLine(0, pgap);
+        char bid[16]; snprintf(bid, sizeof(bid), "##p%d", i);
+        ImVec2 p = ImGui::GetCursorScreenPos();
+        const bool clk = ImGui::InvisibleButton(bid, ImVec2(pw[i], ph), ImGuiButtonFlags_EnableNav);
+        bool foc = ImGui::IsItemFocused();
+        // ▲ from the top row lands on the lit pill (or the first). Set nav
+        // directly: a SetKeyboardFocusHere() request from here is cancelled
+        // when the row that still holds focus is drawn later this frame in
+        // its own child window.
+        if (s_console_focus_pill && (i == (on >= 0 ? on : 0))) {
+            ImGuiContext& g = *ImGui::GetCurrentContext();
+            ImGuiWindow* win = ImGui::GetCurrentWindow();
+            ImGui::SetNavWindow(win);
+            ImGui::SetNavID(ImGui::GetItemID(), ImGuiNavLayer_Main, g.CurrentFocusScopeId,
+                            ImGui::WindowRectAbsToRel(win, g.LastItemData.NavRect));
+            g.NavCursorVisible = true;
+            s_console_focus_pill = false;
+            foc = true;
+        }
+        if (foc) {
+            s_console_focus_in_body = true;
+            // ▼ from a pill: back down to the first row
+            const ImGuiID pid = ImGui::GetItemID();
+            ImGui::SetKeyOwner(ImGuiKey_DownArrow, pid);
+            ImGui::SetKeyOwner(ImGuiKey_GamepadDpadDown, pid);
+            ImGui::SetKeyOwner(ImGuiKey_GamepadLStickDown, pid);
+            if (ImGui::IsKeyPressed(ImGuiKey_DownArrow, false) || ImGui::IsKeyPressed(ImGuiKey_GamepadDpadDown, false) ||
+                ImGui::IsKeyPressed(ImGuiKey_GamepadLStickDown, false))
+                s_console_enter_body = true;
+        }
+        const bool hov = ImGui::IsItemHovered() || foc;
+        const bool is_on = (i == on);
+        ImVec2 mx(p.x + pw[i], p.y + ph);
+        if (is_on) dl->AddRectFilled(p, mx, imcol(th.accent), ph * 0.5f);
+        else { dl->AddRectFilled(p, mx, imcol(th.panel), ph * 0.5f); dl->AddRect(p, mx, imcol(hov ? th.accent : th.border), ph * 0.5f, 0, px(1)); }
+        push_bold_font();
+        ImGui::SetWindowFontScale(0.85f);
+        ImVec2 ts = ImGui::CalcTextSize(ui_text(labels[i]));
+        dl->AddText(ImVec2(p.x + (pw[i] - ts.x) * 0.5f, p.y + (ph - ts.y) * 0.5f),
+                    is_on ? imcol(th.accent_text) : imcol(hov ? th.text : th.text_muted), ui_text(labels[i]));
+        ImGui::SetWindowFontScale(1.0f);
+        pop_bold_font();
+        if (hov && helps && helps[i] && helps[i][0]) srow_publish_help(helps[i], true);
+        if (clk) picked = i;
+    }
+    ImGui::PopID();
+    return picked;
+}
