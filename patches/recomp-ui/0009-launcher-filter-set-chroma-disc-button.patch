+/* Renderer modes: 0 nearest, 1 bilinear, 2 3-point (N64), 3 trilinear,
+ * 4 JINC2, 5 xBR, 6 Scale2x, 7 Scale3x, 8 MMPX, 9 MMPX Enhanced, 10 MMPX
+ * Advanced - DuckStation's set. Trilinear is dropped from the cycle by user
+ * choice (on PS1 content it read as a blurrier bilinear); a settings file
+ * that carries it shows and cycles as Bilinear. */
+static int texfilter_cycle_index(int mode) {          /* mode -> 0..9 */
+    if (mode >= 4 && mode <= 10) return mode - 1;
+    return (mode >= 0 && mode <= 2) ? mode : 1;
+}
+static int texfilter_cycle_mode(int idx) {            /* 0..9 -> mode */
+    return (idx >= 3) ? idx + 1 : idx;
+}
