+/* Persistence of the Advanced rows: the [pgxp] section of settings.toml.
+ * g_pgxp_user holds what the file said (or, after an edit, what the engine
+ * now runs); g_pgxp_user.has_pgxp false = no section = the PGXP mod's shipped
+ * defaults rule. Applied at boot AFTER the mod's activation so it wins, and
+ * every settings write stamps it back in so the launcher's saves keep it. */
+static PSXRecompV4::UserSettings g_pgxp_user;
+static void pgxp_user_capture_engine(void) {
+    g_pgxp_user.has_pgxp = true;
+    g_pgxp_user.pgxp_geometry = gte_geometry_correction_enabled() != 0;
+    g_pgxp_user.pgxp_texture = gpu_texture_correction_enabled() != 0;
+    g_pgxp_user.pgxp_culling = gte_pgxp_culling_enabled() != 0;
+    g_pgxp_user.pgxp_preserve = gte_preserve_proj_enabled() != 0;
+    g_pgxp_user.pgxp_color = gpu_pgxp_color_correction() != 0;
+    g_pgxp_user.pgxp_tolerance = pgxp_tolerance();
+    g_pgxp_user.pgxp_disable_2d = gpu_pgxp_disable_2d() != 0;
+    g_pgxp_user.pgxp_vertex_cache = pgxp_vertex_cache() != 0;
+    g_pgxp_user.pgxp_cpu_mode = pgxp_cpu_mode() != 0;
+    g_pgxp_user.pgxp_depth = gpu_pgxp_depth_enabled() != 0;
+    g_pgxp_user.pgxp_transparent_depth = gpu_pgxp_depth_transparent() != 0;
+}
+static void pgxp_user_apply_engine(void) {
+    if (!g_pgxp_user.has_pgxp) return;
+    gte_geometry_correction_set(g_pgxp_user.pgxp_geometry);
+    gpu_texture_correction_set(g_pgxp_user.pgxp_texture);
+    gte_pgxp_culling_set(g_pgxp_user.pgxp_culling);
+    gte_preserve_proj_set(g_pgxp_user.pgxp_preserve);
+    gpu_pgxp_color_correction_set(g_pgxp_user.pgxp_color);
+    pgxp_set_tolerance(g_pgxp_user.pgxp_tolerance);
+    gpu_pgxp_disable_2d_set(g_pgxp_user.pgxp_disable_2d);
+    pgxp_set_vertex_cache(g_pgxp_user.pgxp_vertex_cache);
+    pgxp_set_cpu_mode(g_pgxp_user.pgxp_cpu_mode);
+    gpu_pgxp_depth_set(g_pgxp_user.pgxp_depth);
+    gpu_pgxp_depth_transparent_set(g_pgxp_user.pgxp_transparent_depth);
+}
+static void pgxp_user_stamp(PSXRecompV4::UserSettings& s) {
+    s.has_pgxp = g_pgxp_user.has_pgxp;
+    if (!s.has_pgxp) return;
+    s.pgxp_geometry = g_pgxp_user.pgxp_geometry;   s.pgxp_texture = g_pgxp_user.pgxp_texture;
+    s.pgxp_culling = g_pgxp_user.pgxp_culling;     s.pgxp_preserve = g_pgxp_user.pgxp_preserve;
+    s.pgxp_color = g_pgxp_user.pgxp_color;         s.pgxp_tolerance = g_pgxp_user.pgxp_tolerance;
+    s.pgxp_disable_2d = g_pgxp_user.pgxp_disable_2d; s.pgxp_vertex_cache = g_pgxp_user.pgxp_vertex_cache;
+    s.pgxp_cpu_mode = g_pgxp_user.pgxp_cpu_mode;   s.pgxp_depth = g_pgxp_user.pgxp_depth;
+    s.pgxp_transparent_depth = g_pgxp_user.pgxp_transparent_depth;
+}
 static int pgxp_ui_get(const char *key, int *out) {
     if (std::strcmp(key, kPgxpGeometry) == 0)    *out = gte_geometry_correction_enabled() ? 1 : 0;
     else if (std::strcmp(key, kPgxpTexture) == 0)     *out = gpu_texture_correction_enabled() ? 1 : 0;
@@ -6666,6 +6710,7 @@ static void pgxp_ui_reset_to_gt2_defaults(void) {
     pgxp_set_cpu_mode(0);
     gpu_pgxp_depth_set(0);
     gpu_pgxp_depth_transparent_set(0);
+    g_pgxp_user.has_pgxp = false;   /* no [pgxp] section: the mod's defaults rule again */
 }
 static int pgxp_ui_set(const char *key, int v) {
     if (std::strcmp(key, kPgxpGeometry) == 0) {
@@ -6686,6 +6731,7 @@ static int pgxp_ui_set(const char *key, int v) {
     else if (std::strcmp(key, kPgxpDepth) == 0)       gpu_pgxp_depth_set(v != 0);
     else if (std::strcmp(key, kPgxpTransDepth) == 0)  gpu_pgxp_depth_transparent_set(v != 0);
     else return 0;
+    pgxp_user_capture_engine();
     return 1;
 }
 
