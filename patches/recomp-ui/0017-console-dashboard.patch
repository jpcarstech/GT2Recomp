+// Header: the game's logo (or the classic brand + title when there is none),
+// a small "what this is" line, and at the right the page name or Back.
+static void draw_console_header(LauncherModel* m, const LauncherTheme& th) {
+    const float hdr_h = px(84.0f);
+    const float top = ImGui::GetCursorPosY();
+    const float right = ImGui::GetWindowContentRegionMax().x;
+    ImDrawList* dl = ImGui::GetWindowDrawList();
+    ImVec2 p = ImGui::GetCursorScreenPos();
+    float x = p.x;
+    if (g_dash_logo.id && g_dash_logo.w > 0) {
+        // The logo's soft edge lets it run a little past the header band.
+        const float lh = hdr_h + px(24.0f);
+        const float lw = lh * (float)g_dash_logo.w / (float)g_dash_logo.h;
+        const ImVec2 a(p.x - px(14.0f), p.y - px(18.0f));
+        dl->AddImage(tid(g_dash_logo), a, ImVec2(a.x + lw, a.y + lh));
+        x += lw - px(2.0f);
+    } else {
+        if (g_brand.id && g_brand.w > 0) {
+            float bh = px(36.0f), bw = bh * (float)g_brand.w / (float)g_brand.h;
+            dl->AddImage(tid(g_brand), ImVec2(p.x, p.y + (hdr_h - bh) * 0.5f), ImVec2(p.x + bw, p.y + (hdr_h + bh) * 0.5f));
+            x += bw + px(14.0f);
+        }
+        push_display_font();
+        ImVec2 ts = ImGui::CalcTextSize(m->game_name ? m->game_name : "");
+        dl->AddText(ImVec2(x, p.y + (hdr_h - ts.y) * 0.5f), imcol(th.text), m->game_name ? m->game_name : "");
+        pop_display_font();
+        x += ts.x + px(14.0f);
+    }
+    // the eyebrow beside the logo
+    {
+        ImGui::SetWindowFontScale(0.78f);
+        const char* tag = ui_text("RECOMPILED");
+        float lh = ImGui::GetTextLineHeight();
+        float xx = x + px(4.0f);
+        char buf[2] = {0, 0};
+        for (const char* q = tag; *q; ++q) {
+            buf[0] = *q;
+            dl->AddText(ImVec2(xx, p.y + hdr_h - lh - px(16.0f)), imcol(th.text_muted), buf);
+            xx += ImGui::CalcTextSize(buf).x + px(2.0f);
+        }
+        ImGui::SetWindowFontScale(1.0f);
+    }
+    // right side
+    if (m->view == LNG_VIEW_DASHBOARD) {
+        // "Disc  Simulation  ·  Arcade installed" over "Disc verified  SCUS-94488  NTSC-U"
+        const float rx = p.x + (right - ImGui::GetCursorPosX());
+        float y = p.y + px(14.0f);
+        const char* disc = (m->num_titles > 1 && m->title_labels && m->active_title >= 0 &&
+                            m->active_title < m->num_titles && m->title_labels[m->active_title])
+                           ? m->title_labels[m->active_title] : "";
+        char others[160]; others[0] = 0;
+        for (int i = 0; m->num_titles > 1 && i < m->num_titles; ++i) {
+            if (i == m->active_title || !launcher_model_title_installed(m, i) || !m->title_labels[i]) continue;
+            if (others[0]) strncat(others, ", ", sizeof(others) - strlen(others) - 1);
+            strncat(others, m->title_labels[i], sizeof(others) - strlen(others) - 1);
+        }
+        if (disc[0]) {
+            // right-aligned, three runs: "Disc " muted, name bold, " · others installed" muted
+            char tail[200]; tail[0] = 0;
+            if (others[0]) snprintf(tail, sizeof(tail), "  \xC2\xB7  %s %s", others, ui_text("installed"));
+            const char* head = ui_text("Disc ");
+            push_bold_font(); ImVec2 ns = ImGui::CalcTextSize(disc); pop_bold_font();
+            ImVec2 hs = ImGui::CalcTextSize(head), tsz = ImGui::CalcTextSize(tail);
+            float x = rx - hs.x - ns.x - tsz.x;
+            dl->AddText(ImVec2(x, y), imcol(th.text_muted), head); x += hs.x;
+            push_bold_font(); dl->AddText(ImVec2(x, y - px(1.0f)), imcol(th.text), disc); pop_bold_font(); x += ns.x;
+            dl->AddText(ImVec2(x, y), imcol(th.text_muted), tail);
+            y += hs.y + px(4.0f);
+        } else if (m->platform && m->platform[0]) {
+            ImVec2 ps = ImGui::CalcTextSize(m->platform);
+            dl->AddText(ImVec2(rx - ps.x, y), imcol(th.text_muted), m->platform);
+            y += ps.y + px(4.0f);
+        }
+        if (m->profile && m->profile->verify.mode == 1 && m->verify.verdict) {
+            const char* v = m->verify.verdict == 1 ? ui_text("Disc verified")
+                          : m->verify.verdict == 2 ? ui_text("Disc unverified") : ui_text("Wrong disc");
+            char line[96];
+            snprintf(line, sizeof(line), "%s  %s  %s", v, m->verify.serial, m->verify.region);
+            ImGui::SetWindowFontScale(0.85f);
+            ImVec2 ls = ImGui::CalcTextSize(line);
+            dl->AddText(ImVec2(rx - ls.x, y), m->verify.verdict == 1 ? imcol(th.text_muted) : imcol(th.warn), line);
+            ImGui::SetWindowFontScale(1.0f);
+        }
+    } else {
+        const char* name = m->view == LNG_VIEW_SETTINGS ? "SETTINGS"
+                         : m->view == LNG_VIEW_MODS ? (m->mod_group_filter == 2 ? "CHEATS" : "MODS")
+                         : m->view == LNG_VIEW_CONTROLLER ? "CONTROLLER"
+                         : m->view == LNG_VIEW_NETPLAY ? "NETPLAY"
+                         : m->view == LNG_VIEW_ASSIST_TOOLS ? "ASSIST TOOLS"
+                         : m->view == LNG_VIEW_CREDITS ? "CREDITS" : "";
+        // Pages with their own BACK row (Settings, Mods, Cheats) carry no
+        // header button; the rest keep one so the mouse can leave them.
+        const bool own_back = m->view == LNG_VIEW_SETTINGS || m->view == LNG_VIEW_MODS;
+        const float bw = own_back ? 0.0f : px(110.0f), bh = px(34.0f);
+        push_display_font();
+        ImVec2 ts = ImGui::CalcTextSize(ui_text(name));
+        const float name_x = p.x + (right - ImGui::GetCursorPosX()) - bw - (own_back ? 0.0f : px(18.0f)) - ts.x;
+        dl->AddText(ImVec2(name_x, p.y + (hdr_h - ts.y) * 0.5f), imcol(th.accent), ui_text(name));
+        pop_display_font();
+        if (!own_back) {
+            ImGui::SetCursorPos(ImVec2(right - bw, top + (hdr_h - bh) * 0.5f));
+            if (ImGui::Button(ui_text("< Back"), ImVec2(bw, bh)))
+                launcher_model_set_view(m, LNG_VIEW_DASHBOARD);
+        }
+    }
+    ImGui::SetCursorPos(ImVec2(ImGui::GetCursorStartPos().x, top + hdr_h));
+    // accent rule
+    {
+        ImVec2 u = ImGui::GetCursorScreenPos();
+        float fw = ImGui::GetContentRegionAvail().x;
+        dl->AddRectFilled(u, ImVec2(u.x + fw * 0.62f, u.y + px(2.0f)), imcol(th.accent));
+        dl->AddRectFilled(ImVec2(u.x + fw * 0.62f, u.y), ImVec2(u.x + fw, u.y + px(2.0f)), imcol(th.border));
+    }
+    ImGui::Dummy(ImVec2(0, px(14.0f)));
+}
