             ImGuiIO& io = ImGui::GetIO();
             io.DisplaySize = ImVec2((float)p->logical_w, (float)p->logical_h);
             io.DisplayFramebufferScale = ImVec2(p->display_scale, p->display_scale);
+            // The SDL backend's focused-window fallback (UpdateMouseData, run
+            // by the backend NewFrame above) queues the GLOBAL mouse position
+            // in raw pixels every frame, overriding the de-scaled motion
+            // events — every click landed offset by the scale factor. Queue
+            // the corrected position after it: ImGui merges consecutive
+            // mouse-position events, so the logical one wins. Skip while a
+            // button is held — the backend skips its fallback then too, and
+            // the (already de-scaled) motion events drive the drag.
+            if (p->display_scale > 1.001f) {
+                bool any_down = false;
+                for (int b = 0; b < IM_ARRAYSIZE(io.MouseDown); ++b)
