+/* Resolved-corner ring: every triangle the PGXP path prepares, with the
+ * INTEGER corner the game supplied and the SUB-PIXEL corner we resolved it to
+ * (16.16), per corner tier. Holds a few frames. Read back over the debug
+ * server (pgxp_tris) and analysed offline: group corners by integer pixel; a
+ * pixel where two triangles resolved to DIFFERENT sub-pixel positions is a
+ * seam candidate by construction - either one copy resolved and the other
+ * fell back (mixed), or both resolved to different fractions. This measures
+ * the mechanism directly, from data, without needing a screenshot. */
+typedef struct {
+    uint32_t seq, src, cmd0;
+    int16_t  ix[3], iy[3];     /* integer corners (post draw-offset)          */
+    int32_t  fx[3], fy[3];     /* resolved 16.16 corners (== ix<<16 if native) */
+    uint8_t  tier[3], any;
+} PgxpTriRec;
+#define PGXP_TRI_RING 8192
+static PgxpTriRec s_tri_ring[PGXP_TRI_RING];
+static uint32_t   s_tri_ring_w = 0;
+static uint32_t   s_tri_seq = 0;
+static inline void tri_ring_note(uint32_t src, const int32_t vx[3], const int32_t vy[3],
+                                 const int32_t fx[3], const int32_t fy[3],
+                                 const int tier[3], int any) {
+    PgxpTriRec *r = &s_tri_ring[s_tri_ring_w & (PGXP_TRI_RING - 1)];
+    s_tri_ring_w++;
+    r->seq = ++s_tri_seq; r->src = src; r->cmd0 = gp0_cmd_buf[0];
+    for (int i = 0; i < 3; i++) {
+        r->ix[i] = (int16_t)vx[i]; r->iy[i] = (int16_t)vy[i];
+        r->fx[i] = any ? fx[i] : (vx[i] << 16);
+        r->fy[i] = any ? fy[i] : (vy[i] << 16);
+        r->tier[i] = (uint8_t)tier[i];
+    }
+    r->any = (uint8_t)any;
+}
+int gpu_pgxp_tri_ring_read(void *out, int max_recs, uint32_t *total) {
+    int n = s_tri_ring_w < PGXP_TRI_RING ? (int)s_tri_ring_w : PGXP_TRI_RING;
+    if (n > max_recs) n = max_recs;
+    /* oldest-first */
+    uint32_t start = (s_tri_ring_w >= PGXP_TRI_RING) ? (s_tri_ring_w - PGXP_TRI_RING) : 0;
+    PgxpTriRec *o = (PgxpTriRec *)out;
+    for (int i = 0; i < n; i++) o[i] = s_tri_ring[(start + (uint32_t)i) & (PGXP_TRI_RING - 1)];
+    if (total) *total = s_tri_ring_w;
+    return n;
+}
+size_t gpu_pgxp_tri_rec_size(void) { return sizeof(PgxpTriRec); }
+
 static void prepare_precise_triangle(int i0, int i1, int i2,
                                      const int32_t vx[3], const int32_t vy[3]) {
     gr_set_perspective_triangle(0, 0.0f, 0.0f, 0.0f);
@@ -3762,6 +3806,7 @@ static void prepare_precise_triangle(int i0, int i1, int i2,
     if (s_pgxp_disable_2d && (!sz[0] || !sz[1] || !sz[2]))
         any_precise = 0;
     if (!any_precise) {
+        tri_ring_note(gp0_cmd_source_addr, vx, vy, fx, fy, tier, 0);
         gr_set_precise_triangle(0, 0,0, 0,0, 0,0);
