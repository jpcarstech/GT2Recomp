+/* LAB diagnostic: present-synchronized frame burst state (consumed by the GL
+ * renderer right before SwapWindow — see gl_swap_with_osd). Armed with the
+ * "framerec" command: {"cmd":"framerec","dir":"/path","count":N}. */
+volatile int g_framerec_n = 0;
+int g_framerec_div = 2;
+char g_framerec_dir[256] = "/tmp";
+unsigned g_framerec_seq = 0;
+int gl_framerec_write_png(const char *path, const unsigned char *rgb,
+                          int w, int h)
+{
+    FILE *f = fopen(path, "wb");
+    int ok;
+    if (!f) return 0;
+    ok = png_write_rgb(f, rgb, w, h);
+    fclose(f);
+    return ok;
+}
+static void handle_framerec(int id, const char *json)
+{
+    char dir[256];
+    if (json_get_str(json, "dir", dir, sizeof dir)) {
+        snprintf(g_framerec_dir, sizeof g_framerec_dir, "%s", dir);
+        g_framerec_seq = 0;
+    }
+    {
+        int dv = json_get_int(json, "div", -1);
+        if (dv >= 1 && dv <= 8) g_framerec_div = dv;
+        int n = json_get_int(json, "count", -1);
+        if (n >= 0) g_framerec_n = n;
+    }
+    send_fmt("{\"id\":%d,\"ok\":true,\"remaining\":%d,\"seq\":%u,\"div\":%d,"
+             "\"frame\":%llu,\"dir\":\"%s\"}",
+             id, g_framerec_n, g_framerec_seq, g_framerec_div,
+             (unsigned long long)s_frame_count, g_framerec_dir);
+}
