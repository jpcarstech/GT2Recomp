+/* Rolling card backups. Numbered rather than timestamped so no directory
+ * listing is needed (the two platforms disagree about that) and the set stays
+ * bounded by construction: .1 is the most recent, .N the oldest. */
+static int s_backup_count = 10;
+static unsigned char s_backup_prev[MEMCARD_SIZE];
+
+void memcard_set_backup_count(int count) {
+    if (count < 0) count = 0;
+    if (count > 50) count = 50;
+    s_backup_count = count;
+}
+
+static void memcard_backup(const char* dir, const char* filepath,
+                           const unsigned char* data) {
+    char bdir[512], stem[160], newest[700], from[700], to[700];
+    const char* base;
+    const char* alt;
+    char* dot;
+    FILE* f;
+    int i;
+
+    if (s_backup_count <= 0 || !dir || !dir[0] || !filepath || !filepath[0])
+        return;
+    snprintf(bdir, sizeof(bdir), "%s/backups", dir);
+    memcard_ensure_dir(bdir);
+
+    base = strrchr(filepath, '/');
+    alt = strrchr(filepath, '\\');
+    if (alt > base) base = alt;
+    base = base ? base + 1 : filepath;
+    snprintf(stem, sizeof(stem), "%s", base);
+    dot = strrchr(stem, '.');
+    if (dot) *dot = '\0';
+
+    snprintf(newest, sizeof(newest), "%s/%s.1.mcd", bdir, stem);
+    f = fopen(newest, "rb");
+    if (f) {
+        size_t n = fread(s_backup_prev, 1, MEMCARD_SIZE, f);
+        fclose(f);
+        /* Nothing has changed since the last session - don't push a
+         * duplicate in and age a genuinely different card off the end. */
+        if (n == MEMCARD_SIZE &&
+            memcmp(s_backup_prev, data, MEMCARD_SIZE) == 0)
+            return;
+    }
+
+    snprintf(to, sizeof(to), "%s/%s.%d.mcd", bdir, stem, s_backup_count);
+    remove(to);
+    for (i = s_backup_count - 1; i >= 1; --i) {
+        snprintf(from, sizeof(from), "%s/%s.%d.mcd", bdir, stem, i);
+        snprintf(to, sizeof(to), "%s/%s.%d.mcd", bdir, stem, i + 1);
+        rename(from, to);        /* absent slots fail harmlessly */
+    }
+    f = fopen(newest, "wb");
+    if (f) {
+        fwrite(data, 1, MEMCARD_SIZE, f);
+        fclose(f);
+    }
+}
+
 void memcard_init_slots(const char* dir, const MemcardSlotConfig slots[2]) {
     memset(cards, 0, sizeof(cards));
     memcard_ensure_dir(dir);
@@ -187,6 +247,8 @@ void memcard_init_slots(const char* dir, const MemcardSlotConfig slots[2]) {
             if (n == MEMCARD_SIZE) {
