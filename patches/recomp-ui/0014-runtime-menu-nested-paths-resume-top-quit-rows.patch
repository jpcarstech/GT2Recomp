+/* ---- section paths --------------------------------------------------------
+ * A section is a '/'-separated path ("Settings/Graphics/Advanced/PGXP"). The
+ * menu browses that tree one LEVEL at a time: the items whose section is
+ * exactly the current path, then a row per direct child path. Nothing here
+ * knows how deep a particular menu goes, so a host buries a setting simply by
+ * giving it a longer path. */
+
+/* Start and length of `path`'s segment at `depth` (0-based); NULL past the end. */
+static const char *path_segment(const char *path, size_t depth, size_t *len) {
+    const char *p = path;
+    for (size_t d = 0; d < depth; ++d) {
+        const char *slash = strchr(p, '/');
+        if (!slash) { *len = 0; return NULL; }
+        p = slash + 1;
+    }
+    const char *slash = strchr(p, '/');
+    *len = slash ? (size_t)(slash - p) : strlen(p);
+    return *len ? p : NULL;
+}
+
+static size_t path_depth(const char *path) {
+    if (!path || !*path) return 0;
+    size_t d = 1;
+    for (const char *p = path; *p; ++p) if (*p == '/') ++d;
+    return d;
+}
+
+/* Is `section` at or below `prefix`? ("" is above everything.) */
+static int path_under(const char *section, const char *prefix) {
+    if (!prefix || !*prefix) return 1;
+    size_t n = strlen(prefix);
+    if (strncmp(section, prefix, n) != 0) return 0;
+    return section[n] == '\0' || section[n] == '/';
+}
+
+static const char *item_section(const RecompRuntimeUiItem *item) {
+    const char *sec = item->section;
+    return (sec && *sec) ? sec : "Settings";
+}
+
+size_t recomp_runtime_ui_level_items(const RecompRuntimeUi *ui) {
+    size_t n = 0;
+    if (!ui) return 0;
