+/* pgxp_tri — vertex-coverage census: triangles by number of precise corners
+ * (mixed = crack candidates), plus up to 64 sampled mixed triangles with
+ * per-vertex source address / word / tier. {"reset":1} clears the samples. */
+typedef struct {
+    uint32_t addr[3], word[3];
+    uint8_t  tier[3];
+    uint8_t  rstate[3];
+    uint32_t frame;
+} DbgMixedTriSample;
+/* Fully-native sample: the 3D-untracked population (see gpu.c). */
+typedef struct {
+    uint32_t word[3];
+    int32_t  x[3], y[3];
+    uint32_t addr;
+    uint32_t seq_delta;
+    uint32_t frame;
+    uint8_t  textured;
+    uint8_t  rstate[3];
+    uint8_t  ambig[3];
+} DbgNativeTriSample;
+extern void gpu_pgxp_tri_census(uint64_t out[4]);
+extern int gpu_pgxp_mixed_samples(const void **out);
+extern void gpu_pgxp_mixed_reset(void);
+extern void gpu_pgxp_native_census(uint64_t *n3d, uint64_t *n2d);
+extern int gpu_pgxp_native_samples(const void **out);
+extern void gpu_pgxp_native_reset(void);
+extern uint64_t gpu_pgxp_whole_count(void);
+static void handle_pgxp_tri(int id, const char *json)
+{
+    if (json_get_int(json, "reset", 0)) {
+        gpu_pgxp_mixed_reset();
+        gpu_pgxp_native_reset();
+    }
+    uint64_t c[4];
+    gpu_pgxp_tri_census(c);
+    uint64_t n3d = 0, n2d = 0;
+    gpu_pgxp_native_census(&n3d, &n2d);
+    const void *nraw = NULL;
+    int nn = gpu_pgxp_native_samples(&nraw);
+    const DbgNativeTriSample *nt = (const DbgNativeTriSample *)nraw;
+    const void *raw = NULL;
+    int n = gpu_pgxp_mixed_samples(&raw);
+    const DbgMixedTriSample *m = (const DbgMixedTriSample *)raw;
+    char buf[16384];
+    int off = snprintf(buf, sizeof buf,
+        "{\"id\":%d,\"ok\":true,\"census\":[%llu,%llu,%llu,%llu],"
+        "\"native3d\":%llu,\"native2d\":%llu,\"whole_done\":%llu,\"nat\":[",
+        id,
+        (unsigned long long)c[0], (unsigned long long)c[1],
+        (unsigned long long)c[2], (unsigned long long)c[3],
+        (unsigned long long)n3d, (unsigned long long)n2d,
+        (unsigned long long)gpu_pgxp_whole_count());
+    int ncap = nn < 16 ? nn : 16;
+    for (int i = 0; i < ncap; i++) {
+        off += snprintf(buf + off, sizeof buf - (size_t)off,
+            "%s{\"f\":%u,\"a\":\"0x%08X\",\"d\":%u,\"tx\":%u,"
+            "\"rs\":[%u,%u,%u],\"amb\":[%u,%u,%u],"
+            "\"p\":[[%d,%d],[%d,%d],[%d,%d]]}",
+            i ? "," : "", nt[i].frame, nt[i].addr, nt[i].seq_delta,
+            nt[i].textured,
+            nt[i].rstate[0], nt[i].rstate[1], nt[i].rstate[2],
+            nt[i].ambig[0], nt[i].ambig[1], nt[i].ambig[2],
+            nt[i].x[0], nt[i].y[0], nt[i].x[1], nt[i].y[1],
+            nt[i].x[2], nt[i].y[2]);
+        if (off >= (int)sizeof buf - 512) break;
+    }
+    off += snprintf(buf + off, sizeof buf - (size_t)off, "],\"mixed\":[");
+    int cap = n < 24 ? n : 24;
+    for (int i = 0; i < cap; i++) {
+        off += snprintf(buf + off, sizeof buf - (size_t)off,
+            "%s{\"f\":%u,\"v\":["
+            "{\"a\":\"0x%08X\",\"w\":\"0x%08X\",\"t\":%u,\"r\":%u},"
+            "{\"a\":\"0x%08X\",\"w\":\"0x%08X\",\"t\":%u,\"r\":%u},"
+            "{\"a\":\"0x%08X\",\"w\":\"0x%08X\",\"t\":%u,\"r\":%u}]}",
+            i ? "," : "", m[i].frame,
+            m[i].addr[0], m[i].word[0], m[i].tier[0], m[i].rstate[0],
+            m[i].addr[1], m[i].word[1], m[i].tier[1], m[i].rstate[1],
+            m[i].addr[2], m[i].word[2], m[i].tier[2], m[i].rstate[2]);
+        if (off >= (int)sizeof buf - 256) break;
+    }
+    snprintf(buf + off, sizeof buf - (size_t)off, "]}");
+    send_line(buf);
+}
