+/* vk_renderer_probe: can this machine run the Vulkan backend at all? Called
+ * BEFORE the window exists, so a request for Vulkan on a machine with no
+ * loader, no ICD or no Vulkan-capable device (a VM, a remote desktop session,
+ * an old iGPU) is turned into an OpenGL window instead of a
+ * SDL_WINDOW_VULKAN window that SDL refuses to create - the player would
+ * otherwise be left with a game that exits at start until they change the
+ * launcher's Renderer row back. Loads the library, creates a throwaway
+ * instance with no extensions and counts physical devices; init_context
+ * does the real setup (surface, device, swapchain) afterwards. */
+static int vk_probe_inner(void) {
+#if defined(PSX_SDL3)
+    if (!SDL_Vulkan_LoadLibrary(NULL))
+#else
+    if (SDL_Vulkan_LoadLibrary(NULL) != 0)
+#endif
+        return 0;
+    PFN_vkGetInstanceProcAddr gipa =
+        (PFN_vkGetInstanceProcAddr)SDL_Vulkan_GetVkGetInstanceProcAddr();
+    if (!gipa) return 0;
+    PFN_vkCreateInstance pci = (PFN_vkCreateInstance)gipa(NULL, "vkCreateInstance");
+    if (!pci) return 0;
+    VkApplicationInfo app = { VK_STRUCTURE_TYPE_APPLICATION_INFO };
+    app.pApplicationName = "psxrecomp";
+    app.apiVersion = VK_API_VERSION_1_1;
+    VkInstanceCreateInfo ci = { VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO };
+    ci.pApplicationInfo = &app;
+    VkInstance inst = VK_NULL_HANDLE;
+    if (pci(&ci, NULL, &inst) != VK_SUCCESS || !inst) return 0;
+    PFN_vkEnumeratePhysicalDevices penum =
+        (PFN_vkEnumeratePhysicalDevices)gipa(inst, "vkEnumeratePhysicalDevices");
+    PFN_vkDestroyInstance pdi = (PFN_vkDestroyInstance)gipa(inst, "vkDestroyInstance");
+    uint32_t n = 0;
+    int ok = penum && penum(inst, &n, NULL) == VK_SUCCESS && n > 0;
+    if (pdi) pdi(inst, NULL);
+    return ok;
+}
+
+int vk_renderer_probe(void) {
+    /* SDL_Vulkan_LoadLibrary needs the video subsystem; when the launcher
+     * was skipped it is not up yet at this point, so bring it up for the
+     * probe only (SDL refcounts subsystems - the real init follows). */
+    const int had_video = SDL_WasInit(SDL_INIT_VIDEO) != 0;
+    if (!had_video) {
+        /* psx_sdl.h gives SDL_InitSubSystem SDL2's 0-on-success on both SDLs. */
+        if (SDL_InitSubSystem(SDL_INIT_VIDEO) != 0) return 0;
+    }
+    const int ok = vk_probe_inner();
+    if (!had_video) {
+        SDL_Vulkan_UnloadLibrary();
+        SDL_QuitSubSystem(SDL_INIT_VIDEO);
+    }
+    return ok;
+}
+
 int vk_renderer_init_context(SDL_Window *win) {
     s_win = win;
 #if defined(PSX_SDL3)
