+// Which preset the Mods page currently matches, for the menu row's value:
+// a preset's label when the enabled set (Mods scope) is exactly its list,
+// "Custom" when something else is on, "" when nothing is.
+static const char* console_mods_value(LauncherModel* m) {
+    const auto* mods = m->mods;
+    if (!mods || !mods->feature_count || !mods->feature_get) return "";
+    const int count = mods->feature_count(mods->ctx);
+    std::vector<std::string> on;
+    for (int i = 0; i < count; ++i) {
+        RecompLauncherCModFeature f{};
+        if (!mods->feature_get(mods->ctx, i, &f) || !f.enabled) continue;
+        if (mod_feature_is_cheat(f)) continue;
+        on.push_back(std::string(f.package_id) + "/" + f.id);
+    }
+    std::sort(on.begin(), on.end());
+    for (int pi = 0; pi < m->num_feature_presets; ++pi) {
+        const RecompLauncherCFeaturePreset* pr = &m->feature_presets[pi];
+        std::vector<std::string> want;
+        for (int k = 0; k < pr->num_enable; ++k)
+            if (pr->enable && pr->enable[k] && pr->enable[k][0]) want.push_back(pr->enable[k]);
+        std::sort(want.begin(), want.end());
+        // a preset entry the disc does not have cannot be on; drop those
+        std::vector<std::string> have;
+        for (const auto& w : want) {
+            const char* slash = strchr(w.c_str(), '/');
+            bool exists = false;
+            for (int i = 0; i < count && !exists; ++i) {
+                RecompLauncherCModFeature f{};
+                if (mods->feature_get(mods->ctx, i, &f) && slash &&
+                    strncmp(f.package_id, w.c_str(), (size_t)(slash - w.c_str())) == 0 &&
+                    f.package_id[slash - w.c_str()] == 0 && strcmp(f.id, slash + 1) == 0)
+                    exists = true;
+            }
+            if (exists) have.push_back(w);
+        }
+        if (have == on && pr->label && pr->label[0]) return pr->label;
+    }
+    return on.empty() ? "" : ui_text("Custom");
+}
