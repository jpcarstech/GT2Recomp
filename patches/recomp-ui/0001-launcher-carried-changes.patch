     return haystack.find(needle) != std::string::npos;
 }
 
+/* "Cheats" is a reserved feature-group name: when any installed feature uses
+ * it, the dashboard splits the single Mods entry into "Patches" (every other
+ * group — enhancements, fixes, performance) and "Cheats" (this group), so
+ * gameplay-altering unlocks are never mixed in between enhancement patches.
+ * Group matching is case-insensitive. */
+static bool mod_feature_is_cheat(const RecompLauncherCModFeature& feature) {
+    static const char kCheats[] = "cheats";
+    const char* g = feature.group;
+    size_t i = 0;
+    for (; g[i] && kCheats[i]; ++i) {
+        if ((char)std::tolower((unsigned char)g[i]) != kCheats[i]) return false;
+    }
+    return !g[i] && !kCheats[i];
+}
+
+static bool mod_feature_in_scope(const LauncherModel* m,
+                                 const RecompLauncherCModFeature& feature) {
+    if (m->mod_group_filter == 1) return !mod_feature_is_cheat(feature);
+    if (m->mod_group_filter == 2) return mod_feature_is_cheat(feature);
+    return true;
+}
+
+static bool mods_have_cheat_features(const LauncherModel* m) {
+    const auto* mods = m ? m->mods : nullptr;
+    if (!mods || !mods->feature_count || !mods->feature_get) return false;
+    const int count = mods->feature_count(mods->ctx);
+    for (int index = 0; index < count; ++index) {
+        RecompLauncherCModFeature feature{};
+        if (!mods->feature_get(mods->ctx, index, &feature)) continue;
+        if (feature.hidden && !feature.enabled) continue;
+        if (mod_feature_is_cheat(feature)) return true;
+    }
+    return false;
+}
+
