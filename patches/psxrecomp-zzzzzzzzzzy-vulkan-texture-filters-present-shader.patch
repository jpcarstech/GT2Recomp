diff --git a/runtime/shaders/present.frag b/runtime/shaders/present.frag
new file mode 100644
index 00000000..3fad45bc
--- /dev/null
+++ b/runtime/shaders/present.frag
@@ -0,0 +1,102 @@
+#version 450
+/* Present pass fragment stage: the scaling and post-processing the OpenGL
+ * backend does in PRESENT_FS, ported line for line so a frame looks the same
+ * on either renderer.
+ *   u_sharp 0  plain sample (the sampler's own nearest/linear)
+ *           1  sharp-bilinear - flat texel interiors like nearest with the
+ *              ramp confined to one output pixel, which is what stops the
+ *              +-1px beating at non-integer magnification
+ *           2  Catmull-Rom bicubic via 9 bilinear taps (the launcher's
+ *              "FMV filtering: Bicubic")
+ *           3  FXAA 3.11 compact - 5-tap luma cross, edge-direction estimate,
+ *              two blended probes with an inner/outer acceptance test
+ * Not ported: the PGXP crack-fill branches, which need their own coverage
+ * texture and stay OpenGL-only. */
+layout(set = 0, binding = 0) uniform sampler2D u_tex;
+layout(push_constant) uniform PC {
+    vec4  u_dst;
+    vec4  u_uv_rect;
+    vec2  u_tex_size;
+    vec2  u_sharp_scale;
+    int   u_sharp;
+} pc;
+layout(location = 0) in  vec2 v_uv;
+layout(location = 0) out vec4 frag;
+
+vec4 bicubic(vec2 uv) {
+    vec2 sp = uv * pc.u_tex_size;
+    vec2 t1 = floor(sp - 0.5) + 0.5;
+    vec2 f  = sp - t1;
+    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
+    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
+    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
+    vec2 w3 = f * f * (-0.5 + 0.5 * f);
+    vec2 w12 = w1 + w2;
+    vec2 t0 = (t1 - 1.0) / pc.u_tex_size;
+    vec2 t3 = (t1 + 2.0) / pc.u_tex_size;
+    vec2 t12 = (t1 + w2 / w12) / pc.u_tex_size;
+    vec4 r = vec4(0.0);
+    r += texture(u_tex, vec2(t0.x , t0.y )) * (w0.x  * w0.y );
+    r += texture(u_tex, vec2(t12.x, t0.y )) * (w12.x * w0.y );
+    r += texture(u_tex, vec2(t3.x , t0.y )) * (w3.x  * w0.y );
+    r += texture(u_tex, vec2(t0.x , t12.y)) * (w0.x  * w12.y);
+    r += texture(u_tex, vec2(t12.x, t12.y)) * (w12.x * w12.y);
+    r += texture(u_tex, vec2(t3.x , t12.y)) * (w3.x  * w12.y);
+    r += texture(u_tex, vec2(t0.x , t3.y )) * (w0.x  * w3.y );
+    r += texture(u_tex, vec2(t12.x, t3.y )) * (w12.x * w3.y );
+    r += texture(u_tex, vec2(t3.x , t3.y )) * (w3.x  * w3.y );
+    return r;
+}
+
+vec2 fxaa_clamp(vec2 uv) {
+    vec2 lo = min(pc.u_uv_rect.xy, pc.u_uv_rect.zw);
+    vec2 hi = max(pc.u_uv_rect.xy, pc.u_uv_rect.zw);
+    return clamp(uv, lo, hi);
+}
+vec4 fxaa(vec2 uv) {
+    vec2 px = 1.0 / pc.u_tex_size;
+    const vec3 lw = vec3(0.299, 0.587, 0.114);
+    vec3 rgbNW = texture(u_tex, fxaa_clamp(uv + vec2(-1.0,-1.0)*px)).rgb;
+    vec3 rgbNE = texture(u_tex, fxaa_clamp(uv + vec2( 1.0,-1.0)*px)).rgb;
+    vec3 rgbSW = texture(u_tex, fxaa_clamp(uv + vec2(-1.0, 1.0)*px)).rgb;
+    vec3 rgbSE = texture(u_tex, fxaa_clamp(uv + vec2( 1.0, 1.0)*px)).rgb;
+    vec4 texM  = texture(u_tex, uv);
+    float lNW = dot(rgbNW, lw), lNE = dot(rgbNE, lw);
+    float lSW = dot(rgbSW, lw), lSE = dot(rgbSE, lw);
+    float lM  = dot(texM.rgb, lw);
+    float lMin = min(lM, min(min(lNW, lNE), min(lSW, lSE)));
+    float lMax = max(lM, max(max(lNW, lNE), max(lSW, lSE)));
+    vec2 dir = vec2(-((lNW + lNE) - (lSW + lSE)),
+                     ((lNW + lSW) - (lNE + lSE)));
+    float dirReduce = max((lNW + lNE + lSW + lSE) * 0.25 * 0.125, 1.0/128.0);
+    float rcpDirMin = 1.0 / (min(abs(dir.x), abs(dir.y)) + dirReduce);
+    dir = clamp(dir * rcpDirMin, vec2(-8.0), vec2(8.0)) * px;
+    vec3 rgbA = 0.5 * (
+        texture(u_tex, fxaa_clamp(uv + dir * (1.0/3.0 - 0.5))).rgb +
+        texture(u_tex, fxaa_clamp(uv + dir * (2.0/3.0 - 0.5))).rgb);
+    vec3 rgbB = rgbA * 0.5 + 0.25 * (
+        texture(u_tex, fxaa_clamp(uv + dir * -0.5)).rgb +
+        texture(u_tex, fxaa_clamp(uv + dir *  0.5)).rgb);
+    float lB = dot(rgbB, lw);
+    vec3 rgb = (lB < lMin || lB > lMax) ? rgbA : rgbB;
+    return vec4(rgb, texM.a);
+}
+
+void main() {
+    vec2 uv = v_uv;
+    if (pc.u_sharp == 3) { frag = vec4(fxaa(uv).rgb, 1.0); return; }
+    if (pc.u_sharp == 2) { frag = vec4(bicubic(uv).rgb, 1.0); return; }
+    if (pc.u_sharp == 1) {
+        vec2 scale = max(pc.u_sharp_scale, vec2(1.0));
+        vec2 texel = uv * pc.u_tex_size;
