+// Disc & BIOS as rows: the upstream game panel's facts (which disc, the
+// verdict and its checklist, the image file) and the two files a player
+// may point at (disc image, BIOS), each a row the cursor can land on -
+// confirm opens the picker. The box art sits beside it.
+static void draw_console_disc_rows(LauncherModel* m, const LauncherTheme& th) {
+    const VerifyResult& v = m->verify;
+    const bool pending = !m->rom_present;
+    const char* noun = (m->rom_noun && m->rom_noun[0]) ? m->rom_noun : "ROM";
+    const char* dash = "\xE2\x80\x94";
+    // which disc (sibling titles)
+    if (m->num_titles > 1 && m->title_labels) {
+        const int active = m->active_title;
+        int next = -1;
+        for (int k = 1; k < m->num_titles && next < 0; ++k) {
+            const int i = (active + k) % m->num_titles;
+            if (launcher_model_title_installed(m, i)) next = i;
+        }
+        const char* cur = (active >= 0 && active < m->num_titles && m->title_labels[active]) ? m->title_labels[active] : "";
+        char help[200];
+        if (next >= 0) snprintf(help, sizeof(help), "%s %s %s", ui_text("Confirm restarts into the"), m->title_labels[next] ? m->title_labels[next] : "", ui_text("disc. Your settings are kept."));
+        else snprintf(help, sizeof(help), "%s", ui_text("No other disc is installed."));
+        if (srow_value("disc_title", "Disc", cur, help, th, 150, next < 0) && next >= 0)
+            launcher_model_switch_title(m, next);
+    }
+    // verdict + checklist
+    const char* headline = pending ? "No disc selected" : v.verdict == 1 ? "Verified" : v.verdict == 2 ? "Verified (warnings)"
+                         : v.verdict == 3 ? "Verification failed" : "Not recognized";
+    const LngColor hc = pending ? th.text_muted : v.verdict == 1 ? th.good
+                      : v.verdict == 3 ? lng_rgba(0.945f, 0.322f, 0.322f, 1.0f) : th.warn;
+    srow_info("disc_status", "Status", ui_text(headline), hc, nullptr, th);
+    srow_info("disc_serial", "Serial", pending ? dash : (v.serial[0] ? v.serial : dash), th.text, nullptr, th);
+    srow_info("disc_region", "Region", pending ? dash : (v.region[0] ? v.region : dash), th.text, nullptr, th);
+    srow_info("disc_iso", "ISO header", pending ? dash : (v.iso_ok ? "OK" : "Mismatch"),
+              pending ? th.text : v.iso_ok ? th.good : th.warn, nullptr, th);
+    // multi-image title (GameInfo.discs): which image is mounted; ◀▶ cycle,
+    // the same choice upstream's Disc Selection dropdown makes
+    const int disc_count = launcher_model_disc_count(m);
+    if (disc_count > 1) {
+        const int sel = launcher_model_disc_selected(m);
+        const int d = srow_value("disc_sel", "Disc selection", sel >= 0 ? launcher_model_disc_label(m, sel) : "",
+                                 ui_text("Which image the game boots from. The verdict above is for the one selected."), th, 220);
+        if (d) launcher_model_select_disc(m, ((sel < 0 ? 0 : sel) + d + disc_count) % disc_count);
+    }
+    // the image file
+    {
+        const int disc_no = disc_count > 1 ? launcher_model_disc_number(m, launcher_model_disc_selected(m)) : 0;
+        char lbl[48];
+        if (disc_no > 0) snprintf(lbl, sizeof(lbl), "%s %d %s", ui_text(noun), disc_no, ui_text("image"));
+        else             snprintf(lbl, sizeof(lbl), "%s %s", ui_text(noun), ui_text("image"));
+        char help[200];
+        snprintf(help, sizeof(help), "%s %s %s", ui_text("The file this"), ui_text(noun),
+                 ui_text("boots from. Confirm opens a file picker to point it at another image."));
+        if (srow_value("disc_file", lbl, m->rom_file[0] ? m->rom_file : ui_text("Browse..."), help, th, 220)) {
+            const SystemProfile* prof = (const SystemProfile*)m->profile;
+            char title[64];
+            if (disc_no > 0) snprintf(title, sizeof(title), "Select %s %d", noun, disc_no);
+            else             snprintf(title, sizeof(title), "Select %s", noun);
+            if (prof && prof->rom_filter.patterns && prof->rom_filter.pattern_count > 0)
+                request_rom_picker(m, title, prof->rom_filter.patterns, prof->rom_filter.pattern_count, prof->rom_filter.desc, false);
+            else
+                request_rom_picker(m, title, NULL, 0, NULL, false);
+        }
+    }
+    // BIOS (the rows upstream's SYSTEM panel shows; a product build with only
+    // the bundled OpenBIOS has nothing to pick, like upstream's has_bios gate)
+    if (m->has_bios) {
+        const SystemProfile* prof = (const SystemProfile*)m->profile;
+        const bool is_gba = prof && prof->id && std::strcmp(prof->id, "gba") == 0;
+        const bool has_pick = m->s.bios_path[0] != 0;
+        const char* name = m->s.bios_path;
+        for (const char* c = m->s.bios_path; *c; ++c) if ((*c == '/' || *c == '\\') && c[1]) name = c + 1;
+        char help[300];
+        snprintf(help, sizeof(help), "%s", has_pick ? m->s.bios_path
+                 : is_gba ? ui_text("A retail GBA BIOS is required. Confirm picks the file.")
+                          : ui_text("The bundled OpenBIOS boots the game as it is; a retail BIOS is optional. Confirm picks one."));
+        if (srow_value("bios_file", "BIOS", has_pick ? name : (is_gba ? ui_text("Not selected") : "OpenBIOS"), help, th, 220))
+            request_bios_picker(m, is_gba ? "Select Game Boy Advance BIOS (gba_bios.bin)" : "Select BIOS file", false);
+        if (has_pick) {
+            if (srow_value("bios_clear", is_gba ? "Clear BIOS" : "Back to OpenBIOS", is_gba ? ui_text("Clear") : ui_text("Switch"),
+                           is_gba ? ui_text("Remove this selection. A retail GBA BIOS is required before the game can launch.")
+                                  : ui_text("Stop using this BIOS and boot with the bundled OpenBIOS (no rebuild)."), th, 150))
+                launcher_model_request_bios_path(m, "");
+        }
+    }
+}
