      * Borrowed; must outlive run_window. */
     const RecompLauncherCFeaturePreset* feature_presets;
     int  num_feature_presets;
+
+    /* ---- Cheats page, even when empty (appended additively) --------------
+     * The dashboard offers a separate "Cheats" entry only while some listed
+     * feature sits in the reserved "Cheats" group; with none, it collapses
+     * back to the single "Mods" entry. A multi-disc port whose cheats exist
+     * for one disc and not another would then change shape between discs -
+     * "Patches" + "Cheats" here, "Mods" there - and a player who had cheats
+     * yesterday sees them vanish with no word why. Set this to keep the
+     * Cheats page in place; the text is what the page says while it has
+     * nothing to list (why, and where the cheats went). NULL => today's
+     * behavior. Borrowed; must outlive run_window. */
+    const char* cheats_page_note;
 } RecompLauncherCGameInfo;
 
