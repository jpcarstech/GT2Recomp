From e437ded11ee4368ca9b8fac7d072e28d3c138b8d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 1 Sep 2026 15:33:20 +0000
Subject: [PATCH] gpu: no rect shortcut for quads with PGXP provenance;
 DuckStation polygon UV limits (max-1, quad-wide)

THE trackside-wall seams / panel jitter (GT2 Tahiti Road chevron wall,
'vertical lines between the wall textures' that open and close as the
camera pans; DuckStation shows none on the same replay frame):

gp0_exec_textured_quad drew any textured quad whose INTEGER corners form an
axis-aligned rectangle through gr_draw_textured_rect(_scaled) - a 2D fast
path that bypasses prepare_precise_triangle entirely. A 3D wall panel that
happens to land on integer-rectangular corners this frame is therefore
rasterized at native positions while its neighbours are sub-pixel placed:
a 0.5-1 px gap at the joint, and a whole-pixel jump when the panel flips
between the two paths from one frame to the next. Same for the
semi-transparent axis-aligned mono-quad shortcut. Both shortcuts now
require that no corner of the packet carries a PGXP shadow
(quad_has_precise_provenance); true 2D quads (HUD, menus, no projection
provenance) keep the fast path. Verified on the replay frame at 0:11.870,
9x: the wall renders as one continuous strip, matching DuckStation.

Also DuckStation ComputePolygonUVLimits parity: the per-axis sampled range
is max-1 whenever min != max for every mapping direction (previously only
axis-aligned ones), and both triangles of a textured quad share one limit
rectangle over all four corners (gr_set_uv_limits, GL/VK/SW), so the
diagonal edge is not clamped one texel short by the half lacking the
quad's extreme uv.
---
 runtime/include/gpu_render.h      |  8 +++++
 runtime/include/gpu_sw_renderer.h |  1 +
 runtime/src/gpu.c                 | 51 +++++++++++++++++++++++++++++--
 runtime/src/gpu_gl_renderer.c     | 19 ++++++++++--
 runtime/src/gpu_render.c          |  4 +++
 runtime/src/gpu_sw_renderer.c     | 10 ++++++
 runtime/src/gpu_uv.h              | 27 +++++++++++++++-
 runtime/src/gpu_vk_renderer.c     | 14 ++++++++-
 8 files changed, 128 insertions(+), 6 deletions(-)

diff --git a/runtime/include/gpu_render.h b/runtime/include/gpu_render.h
index ffb00880..2d13799b 100644
--- a/runtime/include/gpu_render.h
+++ b/runtime/include/gpu_render.h
@@ -59,6 +59,13 @@ void gr_set_perspective_triangle(int enabled, float q0, float q1, float q2);
  * when `enabled`. Backends without depth support may leave the hook NULL. */
 void gr_set_depth_triangle(int enabled, float z0, float z1, float z2);
 
+/* Quad-wide uv sampling bounds (inclusive, page-relative) for the textured
+ * triangles that follow, until cleared with enabled == 0. Both halves of a
+ * textured quad then clamp to ONE rectangle computed over all four corners
+ * (DuckStation ComputePolygonUVLimits), instead of each triangle's own.
+ * Optional hook; backends that ignore it derive per-triangle bounds. */
+void gr_set_uv_limits(int enabled, int lo_u, int lo_v, int hi_u, int hi_v);
+
 /* Clear the depth buffer NOW, mid-frame, after everything queued so far has
  * rasterized (DuckStation depth-clear threshold: the game moved to a farther
  * drawing layer). NULL-safe like the depth hook. */
@@ -152,6 +159,7 @@ typedef struct GpuRenderBackend {
                                  int32_t x2, int32_t y2);
     void (*set_perspective_triangle)(int enabled, float q0, float q1, float q2);
     void (*set_depth_triangle)(int enabled, float z0, float z1, float z2);
+    void (*set_uv_limits)(int enabled, int lo_u, int lo_v, int hi_u, int hi_v);
     void (*depth_clear)(void);
     void (*fill_rect)(int x, int y, int w, int h, uint16_t color);
     void (*copy_rect)(int src_x, int src_y, int dst_x, int dst_y, int w, int h);
diff --git a/runtime/include/gpu_sw_renderer.h b/runtime/include/gpu_sw_renderer.h
index 4cf50109..5d827d5d 100644
--- a/runtime/include/gpu_sw_renderer.h
+++ b/runtime/include/gpu_sw_renderer.h
@@ -36,6 +36,7 @@ void sw_set_precise_triangle(int enabled,
 
 /* Perspective-correct UV override for the next triangle. q values are the
  * homogeneous interpolation weights associated with each screen vertex. */
+void sw_set_uv_limits(int enabled, int lo_u, int lo_v, int hi_u, int hi_v);
 void sw_set_perspective_triangle(int enabled,
                                  float q0, float q1, float q2);
 uint32_t sw_perspective_triangle_count(void);
