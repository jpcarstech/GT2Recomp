+/*
+ * Console-style launcher front end. A title that wants the "HD re-release"
+ * dashboard - a menu column, its own logo, a save-derived stats panel -
+ * registers this once (a PSX_MOD_CONSTRUCTOR is the natural place); the
+ * runtime hands the fields to the launcher when it opens
+ * (RecompLauncherCGameInfo.console_dashboard and friends - see recomp-ui's
+ * recomp_launcher.h for what each means). Strings are borrowed for the
+ * process lifetime. Never registering keeps the launcher's card dashboard.
+ * The save summary callback reads one memory card into the launcher's
+ * RecompLauncherCSaveSummary; it is called with the exe directory so the
+ * title can find data files its install staged under assets/.
+ */
+struct RecompLauncherCSaveSummary;
+typedef int (*psx_launcher_save_summary_fn)(const char* card_path,
+                                            const char* exe_dir,
+                                            struct RecompLauncherCSaveSummary* out);
+typedef struct PsxLauncherDashboard {
+    int         console_dashboard;   /* 1 = use the console front end */
+    const char* logo_path;           /* relative to assets/, e.g. "img/gt2/logo.png"; NULL = none */
+    const char* backdrop_path;       /* relative to assets/; NULL = none */
+    const char* accent;              /* "#RRGGBB"; NULL = the console theme's accent */
+    const char* footer_text;         /* small text at the footer's right; NULL = none */
+    psx_launcher_save_summary_fn save_summary;   /* NULL = no save panel */
+} PsxLauncherDashboard;
+int psx_mod_set_launcher_dashboard(const PsxLauncherDashboard* dashboard);
