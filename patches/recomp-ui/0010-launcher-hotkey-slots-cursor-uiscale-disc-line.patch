+    const char* first  = slot ? other : mine;
+    const char* second = slot ? mine  : other;
+    if (first[0] && second[0]) snprintf(val, sizeof(val), "%s, %s", first, second);
+    else if (first[0])  copy_str(val, sizeof(val), first);
+    else if (second[0]) copy_str(val, sizeof(val), second);   /* primary cleared: the other moves up */
+    else val[0] = 0;
     keymap_write(kHotkeyKey[h], val);
     copy_str(m->hotkeys[h], sizeof(m->hotkeys[h]), val[0] ? val : "(unbound)");
 }
