+/* Log the newest `n` ring entries to stderr — forensic context for the
+ * unknown-GP0 diagnostic in gpu_write_gp0_body (what the command stream
+ * looked like right before a stray word arrived). */
+static void gp0_ring_log_tail(int n) {
+    if (!gp0_ring) return;
+    uint32_t avail = (gp0_ring_seq < GP0_RING_CAP)
+                   ? (uint32_t)gp0_ring_seq : GP0_RING_CAP;
+    if ((uint32_t)n > avail) n = (int)avail;
+    for (int i = n; i >= 1; i--) {
+        uint32_t idx = (gp0_ring_head + GP0_RING_CAP - (uint32_t)i) % GP0_RING_CAP;
+        const GpuGp0RingEntry *e = &gp0_ring[idx];
+        fprintf(stderr,
+                "[gpu]   -%d: frame %u op 0x%02X n%u w0 0x%08X src 0x%08X"
+                " func 0x%08X ra 0x%08X\n",
+                i, e->frame, e->opcode, e->n_words, e->cmd[0], e->src_addr,
+                e->func, e->ra);
+    }
+}
