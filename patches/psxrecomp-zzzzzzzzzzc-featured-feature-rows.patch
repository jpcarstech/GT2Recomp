 #if defined(RECOMP_LAUNCHER)
+static std::vector<std::vector<const char*>> g_featured_row_fid_ptrs;
+static std::vector<RecompLauncherCFeaturedModRow> g_featured_rows_abi;
+static void apply_featured_rows_to_game_info(RecompLauncherCGameInfo* gi) {
+    if (!gi || g_featured_rows_cfg.empty()) return;
+    if (g_featured_rows_abi.empty()) {
+        g_featured_row_fid_ptrs.clear();
+        g_featured_row_fid_ptrs.reserve(g_featured_rows_cfg.size());
+        for (const auto& r : g_featured_rows_cfg) {
+            g_featured_row_fid_ptrs.emplace_back();
+            auto& ids = g_featured_row_fid_ptrs.back();
+            for (const auto& f : r.features) ids.push_back(f.c_str());
+        }
+        for (size_t i = 0; i < g_featured_rows_cfg.size(); ++i) {
+            const auto& r = g_featured_rows_cfg[i];
+            RecompLauncherCFeaturedModRow row{};
+            row.label      = r.label.c_str();
+            row.off_label  = r.off_label.empty() ? nullptr : r.off_label.c_str();
+            row.on_label   = r.on_label.empty() ? nullptr : r.on_label.c_str();
+            row.help       = r.help.empty() ? nullptr : r.help.c_str();
+            row.package_id = r.package.c_str();
+            row.feature_ids = g_featured_row_fid_ptrs[i].data();
+            row.num_feature_ids = (int)g_featured_row_fid_ptrs[i].size();
+            g_featured_rows_abi.push_back(row);
+        }
+    }
+    gi->featured_mod_rows = g_featured_rows_abi.data();
+    gi->num_featured_mod_rows = (int)g_featured_rows_abi.size();
+}
