+/* F1 "Quit to launcher": restart this title's own exe into the launcher. */
+static void shutdown_runtime(void);
+static void quit_to_launcher(void) {
+    namespace fs = std::filesystem;
+    char exe[512] = {0};
+    /* recomp_launcher_relaunch_exe only knows a path when the launcher picked
+     * a sibling title this session, so fall back to this process's own image -
+     * quitting to the launcher restarts THIS title in every case. */
+    if (!recomp_launcher_relaunch_exe(exe, sizeof(exe)) || !exe[0]) {
+        std::error_code ec;
+        fs::path self;
+#ifdef _WIN32
+        wchar_t buf[MAX_PATH * 4];
+        DWORD n = GetModuleFileNameW(NULL, buf, (DWORD)(sizeof(buf) / sizeof(buf[0])));
+        if (n > 0 && n < (DWORD)(sizeof(buf) / sizeof(buf[0])))
+            self = fs::path(std::wstring(buf, buf + n));
+#else
+        self = fs::read_symlink("/proc/self/exe", ec);
+        if (ec || self.empty()) {
+            if (const char* appimg = std::getenv("APPIMAGE"); appimg && appimg[0])
+                self = fs::absolute(appimg, ec);
+            else if (!g_sibling_argv0.empty())
+                self = fs::absolute(g_sibling_argv0, ec);
+        }
+#endif
+        if (self.empty()) {
+            std::fprintf(stderr, "psxrecomp: quit to launcher: no exe path\n");
+            return;
+        }
+        std::snprintf(exe, sizeof(exe), "%s", self.string().c_str());
+    }
+    psx_crash_trace_set_exit_origin("f1_quit_to_launcher");
+    shutdown_runtime();
+    spawn_into_launcher(exe);
+}
+
+static void switch_sibling_title_or_return(const char* argv0) {
+    namespace fs = std::filesystem;
+    char exe[512] = {0};
+    if (!recomp_launcher_relaunch_exe(exe, sizeof(exe)) || !exe[0]) {
+        std::fprintf(stderr,
+                     "psxrecomp: title switch requested but no exe path\n");
+        return;
+    }
+    /* Persist [launcher] active_title = <folder name> in shared settings. */
+    for (const auto& t : g_sibling_titles) {
+        if (t.exe != exe) continue;
+        auto us = PSXRecompV4::load_user_settings(settings_file_path(argv0));
+        if (!us.parse_error) {
+            us.active_title = t.dir_name;
+            us.has_active_title = true;
+            (void)PSXRecompV4::save_user_settings(settings_file_path(argv0),
+                                                  us);
+        }
+        break;
+    }
+    spawn_into_launcher(exe);
+}
