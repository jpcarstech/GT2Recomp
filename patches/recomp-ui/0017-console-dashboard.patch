+// ---- Mods / Cheats, console style -------------------------------------------
+// Same shape as Settings: the left column lists the feature groups on this
+// page (Performance, Quality of Life, Visual ... or the cheat groups), then
+// Installed packages (Mods only) and Back; the right shows the group in
+// view as toggle rows - name, package, an ON/OFF pill - with the row the
+// cursor is on described in a card underneath (what it does, who made it,
+// its options). Presets and Enable/Disable all sit above the rows on the
+// Mods page. Enter/A on a row flips it; the same provider calls as the
+// classic page, so nothing about what a toggle does changes.
+static bool console_toggle_row(ConsoleMenuState* st, int idx, const char* id,
+                               const char* label, const char* sub, bool on, bool warn,
+                               float w, float h, const LauncherTheme& th) {
+    if (st && st->frame != ImGui::GetFrameCount()) {
+        st->frame = ImGui::GetFrameCount();
+        st->hovered_last_frame = st->hovered_this_frame;
+        st->hovered_this_frame = -1;
+    }
+    ImVec2 p = ImGui::GetCursorScreenPos();
+    if (s_console_enter_body && s_console_body_rows == 0) { ImGui::SetKeyboardFocusHere(); s_console_enter_body = false; }
+    ++s_console_body_rows;
+    bool clk = ImGui::InvisibleButton(id, ImVec2(w, h), ImGuiButtonFlags_EnableNav);
+    const bool hov = ImGui::IsItemHovered();
+    const bool foc = ImGui::IsItemFocused();
+    if (foc) s_console_focus_in_body = true;
+    if (st) {
+        if (hov) st->hovered_this_frame = idx;
+        if (foc || hov) st->cursor = idx;
+    }
+    const bool resting = st && st->cursor == idx && st->hovered_last_frame < 0 && !ImGui::GetIO().NavVisible;
+    const bool sel = hov || foc || resting;
+    ImDrawList* dl = ImGui::GetWindowDrawList();
+    ImVec2 mn = p, mx = ImVec2(p.x + w, p.y + h);
+    const float r = px(th.radius_sm);
+    if (sel) dl->AddRectFilled(mn, mx, imcol(th.accent), r);
+    else     dl->AddLine(ImVec2(mn.x, mx.y - px(1)), ImVec2(mx.x, mx.y - px(1)), imcol(th.border, 0.9f), px(1));
+    const ImU32 fg = sel ? imcol(th.accent_text) : imcol(th.text);
+    const ImU32 fg_mut = sel ? imcol(th.accent_text, 0.7f) : imcol(th.text_muted);
+    // name (bold) over the package line
+    push_bold_font();
+    const float lh1 = ImGui::GetTextLineHeight();
+    pop_bold_font();
+    const float lh2 = ImGui::GetTextLineHeight();
+    const bool two = sub && sub[0];
+    const float block = two ? lh1 + lh2 + px(1.0f) : lh1;
+    float y = mn.y + (h - block) * 0.5f;
+    const float tx = mn.x + px(16.0f);
+    push_bold_font();
+    dl->AddText(ImVec2(tx, y), fg, label);
+    pop_bold_font();
+    if (two) {
+        ImGui::SetWindowFontScale(0.9f);
+        dl->AddText(ImVec2(tx, y + lh1 + px(1.0f)), fg_mut, sub);
+        ImGui::SetWindowFontScale(1.0f);
+    }
+    if (warn) {
+        push_bold_font();
+        float lw = ImGui::CalcTextSize(label).x;
+        dl->AddText(ImVec2(tx + lw + px(8.0f), y), sel ? imcol(th.accent_text) : imcol(th.warn), "!");
+        pop_bold_font();
+    }
+    // ON / OFF pill at the right edge
+    {
+        const char* v = on ? ui_text("ON") : ui_text("OFF");
+        ImGui::SetWindowFontScale(0.85f);
+        ImVec2 vs = ImGui::CalcTextSize(v);
+        const float pw = px(58.0f), ph = vs.y + px(8.0f);
+        ImVec2 pmx(mx.x - px(14.0f), mn.y + (h + ph) * 0.5f);
+        ImVec2 pmn(pmx.x - pw, mn.y + (h - ph) * 0.5f);
+        if (on) {
+            dl->AddRectFilled(pmn, pmx, sel ? imcol(th.accent_text) : imcol(th.accent), ph * 0.5f);
+            dl->AddText(ImVec2(pmn.x + (pw - vs.x) * 0.5f, pmn.y + px(4.0f)),
+                        sel ? imcol(th.accent) : imcol(th.accent_text), v);
+        } else {
+            dl->AddRect(pmn, pmx, sel ? imcol(th.accent_text, 0.7f) : imcol(th.border), ph * 0.5f, 0, px(1));
+            dl->AddText(ImVec2(pmn.x + (pw - vs.x) * 0.5f, pmn.y + px(4.0f)), fg_mut, v);
+        }
+        ImGui::SetWindowFontScale(1.0f);
+    }
+    return clk;
+}
