+static bool apply_feature_preset(LauncherModel* m,
+                                 const RecompLauncherCFeaturePreset* preset) {
+    const auto* mods = m ? m->mods : nullptr;
+    if (!mods || !mods->feature_enable || !preset) return false;
+    /* Start from a known state so a preset always means the same thing,
+     * whatever the player had ticked before. */
+    if (!set_all_mod_features(m, false)) return false;
+    for (int i = 0; i < preset->num_enable; ++i) {
+        const char* entry = preset->enable ? preset->enable[i] : nullptr;
+        if (!entry || !entry[0]) continue;
+        const char* slash = std::strchr(entry, '/');
+        if (!slash || !slash[1]) continue;          /* want package/feature */
+        std::string package(entry, (size_t)(slash - entry));
+        const char* feature = slash + 1;
+        if (!mods->feature_enable(mods->ctx, package.c_str(), feature, 1)) {
+            /* A preset naming something this disc does not have is not an
+             * error the player caused - skip it and keep going. */
+            continue;
+        }
+    }
+    std::snprintf(m->mod_status, sizeof(m->mod_status), "%s %s",
+                  preset->label ? preset->label : "Preset",
+                  ui_text("applied. Changes apply when you press PLAY."));
+    return true;
+}
