From 4a490a8c6bfa2441ff058dbcef1cca610ac9fcca Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 1 Sep 2026 16:05:07 +0000
Subject: [PATCH] video: display_scaling (nearest/bilinear/sharp) and fmv_crop
 settings - launcher, F1 menu, settings.toml

display_scaling replaces the misnamed 'antialiasing' switch as the user-facing
present policy: nearest (true nearest at integer ratios, sharp-bilinear at a
non-integer magnification), bilinear, or sharp-bilinear always - DuckStation's
Nearest / Bilinear (Smooth) / Bilinear (Sharp). Unset keeps following
antialiasing. fmv_crop trims N native rows top/bottom (and 4/3 N columns per
side) from a 24-bit FMV frame before the 4:3 fit, so movies fill more of the
window without changing aspect (DuckStation Crop Mode = Overscan). Both are
settings.toml keys, launcher rows (recomp-ui: Display scaling / FMV overscan
crop; the Antialiasing row is hidden when Display scaling is offered) and F1
Graphics rows (persisted on menu close).
---
 recompiler/src/config_loader.cpp  | 14 +++++
 recompiler/src/config_loader.h    | 10 ++++
 runtime/include/gpu_gl_renderer.h |  6 +++
 runtime/src/gpu_gl_renderer.c     | 37 ++++++++++++-
 runtime/src/main.cpp              | 89 ++++++++++++++++++++++++++++++-
 5 files changed, 153 insertions(+), 3 deletions(-)

diff --git a/recompiler/src/config_loader.cpp b/recompiler/src/config_loader.cpp
index abdfb3ed..a0997806 100644
--- a/recompiler/src/config_loader.cpp
+++ b/recompiler/src/config_loader.cpp
@@ -2348,6 +2348,16 @@ UserSettings load_user_settings(const fs::path& path) {
             s.texture_filter_2d = toml::find<bool>(v, "texture_filtering_2d");
             s.has_texture_filter_2d = true;
         });
+        if (v.contains("display_scaling")) try_get([&]{
+            const auto m = toml::find<std::string>(v, "display_scaling");
+            if (m == "nearest") { s.display_scaling = 0; s.has_display_scaling = true; }
+            else if (m == "bilinear") { s.display_scaling = 1; s.has_display_scaling = true; }
+            else if (m == "sharp") { s.display_scaling = 2; s.has_display_scaling = true; }
+        });
+        if (v.contains("fmv_crop")) try_get([&]{
+            const int c = static_cast<int>(toml::find<std::int64_t>(v, "fmv_crop"));
+            if (c >= 0 && c <= 32) { s.fmv_crop = c; s.has_fmv_crop = true; }
+        });
         if (v.contains("post_processing")) try_get([&]{
             const auto m = toml::find<std::string>(v, "post_processing");
             if (m == "off") { s.post_processing = 0; s.has_post_processing = true; }
@@ -2695,6 +2705,10 @@ bool save_user_settings(const fs::path& path, const UserSettings& s) {
         f << "texture_filtering_2d = " << (s.texture_filter_2d ? "true" : "false") << "\n";
     if (s.has_post_processing)
         f << "post_processing = \"" << (s.post_processing == 1 ? "fxaa" : "off") << "\"\n";
+    if (s.has_display_scaling)
+        f << "display_scaling = \"" << (s.display_scaling == 0 ? "nearest" : s.display_scaling == 1 ? "bilinear" : "sharp") << "\"\n";
+    if (s.has_fmv_crop)
+        f << "fmv_crop = " << s.fmv_crop << "\n";
     if (s.has_fmv_filter)
         f << "fmv_filter        = \"" << video_fmv_filter_name(s.fmv_filter) << "\"\n";
     if (s.has_geometry_correction)
diff --git a/recompiler/src/config_loader.h b/recompiler/src/config_loader.h
index 37c90db7..fbe22882 100644
--- a/recompiler/src/config_loader.h
+++ b/recompiler/src/config_loader.h
@@ -1215,6 +1215,16 @@ struct UserSettings {
     bool has_texture_filter = false; int  texture_filter = 0; // 0=nearest,1=bilinear,2=3point,3=trilinear
     bool has_texture_filter_2d = false; bool texture_filter_2d = true; // filter 2D sprites/UI too
     bool has_post_processing = false; int post_processing = 0; // 0=off,1=fxaa
+    // display_scaling: how the finished frame is scaled to the window.
+    // 0 nearest (true nearest at integer ratios, sharp-bilinear at a non-integer
+    // magnification), 1 bilinear, 2 sharp-bilinear. Unset -> follow antialiasing.
+    // DuckStation: Nearest / Bilinear (Smooth) / Bilinear (Sharp).
+    bool has_display_scaling = false; int display_scaling = 0;
+    // fmv_crop: native pixels trimmed from the top and bottom of a 24-bit FMV
+    // frame (and 4/3 as many from each side, so the movie stays 4:3) before
+    // it is fitted to the window - the overscan border a CRT never showed.
+    // 0 = off. DuckStation: Crop Mode = Overscan.
+    bool has_fmv_crop = false; int fmv_crop = 0;
     // FMV present reconstruction (VIDEO_FMV_FILTER_*). Only consulted when
     // antialiasing is on. See RuntimeConfig::video_fmv_filter.
     bool has_fmv_filter     = false; int  fmv_filter     = VIDEO_FMV_FILTER_DEFAULT;
diff --git a/runtime/include/gpu_gl_renderer.h b/runtime/include/gpu_gl_renderer.h
index 3900ac54..b0975af1 100644
--- a/runtime/include/gpu_gl_renderer.h
+++ b/runtime/include/gpu_gl_renderer.h
@@ -121,6 +121,12 @@ void gl_renderer_present_vram(int disp_x, int disp_y, int w, int h, int linear,
  * disp_x) straight to the window, no CPU readback. Returns 0 if no wide surface
  * exists for disp_x (caller falls back to the CPU readout path). */
 int gl_renderer_present_wide_fbo(int disp_x, int disp_y, int disp_h, int linear);
+/* [video] display_scaling: -1 follow antialiasing, 0 nearest, 1 bilinear, 2 sharp. */
+void gl_renderer_set_display_scaling(int mode);
+/* [video] fmv_crop: native rows trimmed top/bottom of an FMV frame (0 = off). */
+void gl_renderer_set_fmv_crop(int native_rows);
+int  gl_renderer_get_fmv_crop(void);
+int  gl_renderer_get_display_scaling(void);
 
 /* Display aspect for the present letterbox (default 4:3). A wide aspect
  * stretches the 4:3 frame; pair with gte_set_display_aspect (cpu_state.h)
diff --git a/runtime/src/gpu_gl_renderer.c b/runtime/src/gpu_gl_renderer.c
index 1f2a3ce4..caea61d0 100644
--- a/runtime/src/gpu_gl_renderer.c
+++ b/runtime/src/gpu_gl_renderer.c
@@ -3736,6 +3736,14 @@ void gl_renderer_shutdown(void) {
  * force_4_3 pins the rect to native 4:3 regardless of the display aspect —
  * FMVs are authored 4:3 and have no GTE squash to compensate a stretch, so
  * widescreen presents them pillarboxed instead of distorted. */
+/* [video] fmv_crop: native rows trimmed from the top and bottom of a 24-bit
+ * FMV frame, and 4/3 as many columns from each side, before the frame is
+ * fitted to its 4:3 rect - the overscan border a CRT never showed, so the
+ * movie fills more of the window at the same aspect. 0 = off. */
+static int s_fmv_crop = 0;
+void gl_renderer_set_fmv_crop(int native_rows) { s_fmv_crop = native_rows < 0 ? 0 : native_rows; }
+int  gl_renderer_get_fmv_crop(void)            { return s_fmv_crop; }
+
 void gl_renderer_present(const uint32_t *pixels, int src_w, int src_h, int linear,
                          int force_4_3, int content_w) {
     if (!s_ctx) return;
@@ -3797,12 +3805,22 @@ void gl_renderer_present(const uint32_t *pixels, int src_w, int src_h, int linea
     upload_present_tex(pixels, src_w, src_h, filt_mode >= 0 ? 1 : 0);
     p_glUseProgram(s_present_prog); p_glUniform1i(s_present_uTex, 0);
     present_set_sharp(filt_mode, src_w, src_h, lw, lh);
+    /* Overscan crop for FMV (force_4_3, full-height source only). */
+    int ocx = 0, ocy = 0;
+    if (force_4_3 && s_fmv_crop > 0 && src_h >= 192 && src_w > 0 &&
+        s_fmv_crop * 2 < src_h / 2) {
+        ocy = s_fmv_crop;
+        ocx = (s_fmv_crop * src_w) / src_h;   /* 4/3 of the rows at 320x240 */
+    }
     if (crop) {
         /* Cropped present keeps left-aligned content; still inset so linear
          * AA does not blend the cut column with undefined border texels. */
         float u0 = (src_w > 0) ? (0.5f / (float)src_w) : 0.f;
         float v0 = (src_h > 0) ? (0.5f / (float)src_h) : 0.f;
         p_glUniform4f(s_present_uUvRect, u0, v0, uv_x1 - u0, 1.f - v0);
+    } else if (ocx > 0 || ocy > 0) {
+        float u0 = ((float)ocx + 0.5f) / (float)src_w, v0 = ((float)ocy + 0.5f) / (float)src_h;
+        p_glUniform4f(s_present_uUvRect, u0, v0, 1.f - u0, 1.f - v0);
     } else if (src_w > 0 && src_h > 0) {
         /* Half-texel UV inset for both nearest and linear. Corner-mapped
          * UV=1.0 grazes past the last texel (driver-dependent border sample);
@@ -4946,10 +4964,24 @@ static void gl_swap_with_osd(void) {
     }
 }
 
+/* Display scaling policy for the scene present ([video] display_scaling):
+ * 0 nearest (true nearest at integer ratios, sharp-bilinear at non-integer
+ * magnification), 1 bilinear, 2 sharp-bilinear always. The legacy `linear`
+ * argument (antialiasing) still selects between 0 and 1 when the setting is
+ * unset (-1). DuckStation equivalents: Nearest / Bilinear (Smooth) / Bilinear
+ * (Sharp). */
+static int s_display_scaling = -1;
+void gl_renderer_set_display_scaling(int mode) { s_display_scaling = mode; }
+int  gl_renderer_get_display_scaling(void)     { return s_display_scaling; }
+
 static void present_target_quad(GLuint tex, int tex_w, int tex_h,
                                 int x, int y, int w, int h, int linear,
                                 int lx, int ly, int lw, int lh, int v_flip) {
     float u0, v0, u1, v1;
+    int force_sharp = 0;
+    if (s_display_scaling == 0)      linear = 0;
+    else if (s_display_scaling == 1) linear = 1;
+    else if (s_display_scaling == 2) { linear = 1; force_sharp = 1; }
     p_glBindFramebuffer(PSXGL_FRAMEBUFFER, 0);
     glViewport(lx, ly, lw, lh);
     p_glActiveTexture(PSXGL_TEXTURE0);
@@ -5007,10 +5039,11 @@ static void present_target_quad(GLuint tex, int tex_w, int tex_h,
      * ramp confined to a one-output-pixel band, no beating. Integer ratios
      * (1:1, 2:1 ...) keep true nearest - it is exact there. */
     int sharp_mag = 0;
-    if (!s_present_resolved && !linear && s_scale > 0 && w > 0 && lw > 0) {
+    if (!s_present_resolved && s_scale > 0 && w > 0 && lw > 0) {
         const float mag = (float)lw / (float)(w * s_scale);
         const float near_int = (float)(int)(mag + 0.5f);
-        if (mag > 1.01f && (mag < near_int - 0.01f || mag > near_int + 0.01f)) {
+        const int non_integer = (mag > 1.01f && (mag < near_int - 0.01f || mag > near_int + 0.01f));
+        if ((force_sharp && mag > 1.0f) || (!linear && non_integer)) {
             sharp_mag = 1;
             glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
             glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
