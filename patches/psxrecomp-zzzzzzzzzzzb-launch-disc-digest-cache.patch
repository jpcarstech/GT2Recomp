     RuntimeMods& s = state();
     if (!s.initialized) return true;
     if (disc_path != s.disc_path) {
-        std::string hash_error;
         std::string digest;
-        if (!sha256_file(disc_path, digest, &hash_error)) digest.clear();
+        if (any_package_pins_disc_digest(s.manager)) {
+            DiscFileStamp stamp;
+            const bool stamped = stamp_disc_file(disc_path, stamp);
+            if (!stamped || !cached_disc_digest(s, stamp, digest)) {
+                std::string hash_error;
+                if (!sha256_file(disc_path, digest, &hash_error)) digest.clear();
+                else if (stamped) remember_disc_digest(s, stamp, digest);
+            }
