diff --git a/tools/glsl_from_texfilters.py b/tools/glsl_from_texfilters.py
new file mode 100755
index 00000000..56a0bf99
--- /dev/null
+++ b/tools/glsl_from_texfilters.py
@@ -0,0 +1,58 @@
+#!/usr/bin/env python3
+"""glsl_from_texfilters.py - runtime/src/gpu_gl_texfilters.h -> runtime/shaders/texfilters.glsl
+
+    glsl_from_texfilters.py [gpu_gl_texfilters.h] [texfilters.glsl]
+
+The OpenGL backend assembles its texture-filter fragment shader at RUNTIME by
+concatenating C string constants (gpu_gl_texfilters.h, itself generated from
+DuckStation by port_duckstation_texfilters.py). Vulkan compiles its shaders to
+SPIR-V at BUILD time, so it needs the same blocks as an actual GLSL file it can
+#include. This unescapes the C strings back into GLSL and wraps each block in
+the `#if PSX_TEXFILTER == n` guard for its mode, so both backends run the same
+filter code from one source of truth: edit neither generated file - re-run
+port_duckstation_texfilters.py, then this.
+"""
+import re, sys
+
+MODES = [("XBR", 5, "xBR"), ("SCALE2X", 6, "Scale2x"), ("SCALE3X", 7, "Scale3x"),
+         ("MMPX", 8, "MMPX"), ("MMPX_ENHANCED", 9, "MMPX Enhanced"),
+         ("MMPX_ADVANCED", 10, "MMPX Advanced")]
+
+def unescape_block(text, cname):
+    """Pull `static const char *TEXFILTER_<cname>_SRC = "..." ... ;` back to GLSL."""
+    m = re.search(r'static const char \*TEXFILTER_%s_SRC\s*=\s*(.*?);\s*\n' % cname,
+                  text, re.S)
+    if not m:
+        raise SystemExit("no TEXFILTER_%s_SRC in the header" % cname)
+    out = []
+    for lit in re.findall(r'"((?:[^"\\]|\\.)*)"', m.group(1)):
+        out.append(lit.encode().decode('unicode_escape'))
+    return ''.join(out)
+
+def main(argv):
+    src = argv[1] if len(argv) > 1 else 'runtime/src/gpu_gl_texfilters.h'
+    dst = argv[2] if len(argv) > 2 else 'runtime/shaders/texfilters.glsl'
+    text = open(src, encoding='utf-8').read()
+    out = ["/* Texture-filter blocks for the Vulkan fragment shader, generated by",
+           " * tools/glsl_from_texfilters.py from runtime/src/gpu_gl_texfilters.h -",
+           " * edit neither, re-run the generators. These are DuckStation's filters",
+           " * (see the header for the per-filter licences); the OpenGL backend",
+           " * compiles the very same text at runtime, so the two renderers cannot",
+           " * drift apart. Each block defines FilteredSampleFromVRAM against the",
+           " * HLSL-style names geo_tex.frag's compat layer supplies. */",
+           "#ifndef PSX_TEXFILTERS_GLSL",
+           "#define PSX_TEXFILTERS_GLSL",
+           ""]
+    for cname, mode, label in MODES:
+        body = unescape_block(text, cname).rstrip('\n')
+        out.append("#if PSX_TEXFILTER == %d   /* DuckStation %s */" % (mode, label))
+        out.append(body)
+        out.append("#endif")
+        out.append("")
+    out.append("#endif  /* PSX_TEXFILTERS_GLSL */")
+    open(dst, 'w', encoding='utf-8').write('\n'.join(out) + '\n')
+    print("%s: %d blocks" % (dst, len(MODES)))
+    return 0
+
+if __name__ == '__main__':
+    sys.exit(main(sys.argv))
