+// Settings as a section list: the left column names the sections this
+// game composes (one per panel the profile lists, plus the dashboard cards
+// that moved here), the right shows the one in view.
+struct ConsoleSection { const char* id; const char* label; };
+static int console_settings_sections(LauncherModel* m, ConsoleSection* out, int cap) {
+    const SystemProfile* prof = (const SystemProfile*)m->profile;
+    int n = 0;
+    auto add = [&](const char* id, const char* label) { if (n < cap) { out[n].id = id; out[n].label = label; ++n; } };
+    if (find_composed(prof->panels_settings, "video", m))  add("video", "DISPLAY");
+    if (find_composed(prof->panels_settings, "audio", m))  add("audio", "AUDIO");
+    if (find_composed(prof->panels_dashboard, "controller", m) ||
+        find_composed(prof->panels_settings, "input", m))  add("controllers", "CONTROLLERS");
+    if (find_composed(prof->panels_dashboard, "save", m))  add("save", "MEMORY CARDS");
+    if (find_composed(prof->panels_dashboard, "game", m) ||
+        find_composed(prof->panels_settings, "system", m)) add("disc", "DISC & BIOS");
+    if (find_composed(prof->panels_settings, "solar", m))  add("solar", "SOLAR SENSOR");
+    if (find_composed(prof->panels_settings, "hotkeys", m)) add("hotkeys", "HOTKEYS");
+    add("launcher", "LAUNCHER");
+    return n;
+}
+
+static void draw_console_settings(LauncherModel* m, const LauncherTheme& th) {
+    const SystemProfile* prof = (const SystemProfile*)m->profile;
+    ConsoleSection secs[12];
+    const int n = console_settings_sections(m, secs, 12);
+    if (n == 0) { draw_settings(m, th); return; }
+    if (m->settings_section < 0 || m->settings_section >= n) m->settings_section = 0;
+
+    const float gap = px(th.spacing_lg);
+    const float menu_w = px(340.0f);
+    const float row_h = px(62.0f);
+    const float box_gap = px(8.0f);
+    const float body_h = ImGui::GetContentRegionAvail().y;
+
+    static ConsoleMenuState smenu;
+    smenu.enter_body_on_right = true;
+    s_console_body_rows_last = s_console_body_rows;
+    s_console_body_rows = 0;
+    s_console_pills_drawn = false;
+    const bool entering = s_console_view_changed;
+    if (entering) smenu.cursor = m->settings_section;
+    begin_container("con_set_menu", ImVec2(menu_w, body_h), ImGuiChildFlags_NavFlattened, ImGuiWindowFlags_NoScrollbar);
+    {
+        ImGui::Dummy(ImVec2(0, px(6.0f)));
+        for (int i = 0; i < n; ++i) {
+            char id[32]; snprintf(id, sizeof(id), "##sec%d", i);
+            ImVec2 p = ImGui::GetCursorScreenPos();
+            const bool cur = (i == m->settings_section);
+            // the section in view keeps an accent gutter mark even when the
+            // highlight is elsewhere
+            if ((entering || s_console_refocus_menu) && cur) ImGui::SetKeyboardFocusHere();
+            if (console_menu_item(&smenu, i, id, ui_text(secs[i].label), nullptr, menu_w, row_h, th, true, false, cur))
+                m->settings_section = i;
+            if (ImGui::IsItemFocused() && ImGui::GetIO().NavVisible) m->settings_section = i;   // pad/keys: view follows the cursor
+            if (i == 0) ImGui::SetItemDefaultFocus();
+            (void)p;
+            ImGui::Dummy(ImVec2(0, box_gap - ImGui::GetStyle().ItemSpacing.y));
+        }
+        ImGui::Dummy(ImVec2(0, px(14.0f)));
+        if (console_menu_item(&smenu, n, "##back", ui_text("BACK"), nullptr, menu_w, row_h, th))
+            launcher_model_set_view(m, LNG_VIEW_DASHBOARD);
+        if (launcher_model_can_restore_defaults(m)) {
+            ImGui::Dummy(ImVec2(0, px(14.0f)));
+            if (console_menu_item(&smenu, n + 1, "##restore", ui_text("RESTORE DEFAULTS"), nullptr, menu_w, row_h, th))
+                launcher_model_request_restore_defaults(m);
+        }
+    }
+    end_container();
+    ImGui::SameLine(0, gap);
+    begin_container("con_set_body", ImVec2(0, body_h), ImGuiChildFlags_NavFlattened);
+    {
+        const char* id = secs[m->settings_section].id;
+        const LauncherPanel* p;
+        // page title: eyebrow + section name, presets at the right on Display
+        console_page_title(ui_text("SETTINGS"), ui_text(secs[m->settings_section].label), th);
+        if (strcmp(id, "video") == 0 && any_deep_display(m)) console_preset_pills(m, th);
+        console_page_rule(th);
+        s_row_help[0] = 0; s_row_help_set = false;
+        s_console_focus_in_body = false;
+        if (strcmp(id, "video") == 0 || strcmp(id, "audio") == 0 || strcmp(id, "launcher") == 0) {
+            g_console_rows = true;
+            if (console_card("rows")) {
+                if (strcmp(id, "video") == 0)      draw_display_controls(m, th);
+                else if (strcmp(id, "audio") == 0) draw_audio_controls(m, th);
+                else                               draw_console_launcher_rows(m, th);
+            }
+            console_card_end();
+            g_console_rows = false;
+        } else if (strcmp(id, "controllers") == 0) {
+            if ((p = find_composed(prof->panels_dashboard, "controller", m))) { p->draw(m, &th); ImGui::Dummy(ImVec2(0, gap)); }
+            if (find_composed(prof->panels_settings, "input", m)) {
+                g_console_rows = true;
+                if (console_card("rows")) draw_input_controls(m, th);
+                console_card_end();
+                g_console_rows = false;
+            }
+        } else if (strcmp(id, "disc") == 0) {
+            // box art beside the rows
+            const float art_w = px(260.0f);
+            if (console_card("con_art", art_w)) {
+                const float cw = ImGui::GetContentRegionAvail().x;
+                hero_boxart_centered(g_boxart, px(300.0f), cw);
+            }
+            console_card_end();
+            ImGui::SameLine(0, gap);
+            g_console_rows = true;
+            if (console_card("rows")) draw_console_disc_rows(m, th);
+            console_card_end();
+            g_console_rows = false;
+        } else if (strcmp(id, "save") == 0) {
+            if ((p = find_composed(prof->panels_dashboard, "save", m))) { g_save_fill_h = false; p->draw(m, &th); }
+        } else {
+            if ((p = find_composed(prof->panels_settings, id, m))) p->draw(m, &th);
+        }
+        // the row under the cursor explains itself here, once, under the card
+        if (s_row_help_set || strcmp(id, "video") == 0 || strcmp(id, "audio") == 0 || strcmp(id, "launcher") == 0 || strcmp(id, "disc") == 0) {
+            ImGui::Dummy(ImVec2(0, px(8.0f)));
+            const float cw = ImGui::GetContentRegionAvail().x;
+            ImGui::SetCursorPosX(ImGui::GetCursorPosX() + px(6.0f));
+            ImGui::PushTextWrapPos(ImGui::GetCursorPosX() + cw - px(12.0f));
+            if (s_row_help_set) ImGui::TextColored(col(th.text_muted), "%s", ui_text(s_row_help));
+            else ImGui::TextColored(ImVec4(th.text_muted.r, th.text_muted.g, th.text_muted.b, 0.6f), "%s", ui_text("Pick a row to read what it does."));
+            ImGui::PopTextWrapPos();
+        }
+        if (s_console_refocus_menu) s_console_refocus_menu = false;
+        s_console_enter_body = false;
+    }
+    end_container();
+}
