+static void draw_console_mods(LauncherModel* m, const LauncherTheme& th) {
+    const auto* mods = m ? m->mods : nullptr;
+    const bool feature_provider = mods && mods->feature_count && mods->feature_get &&
+        mods->feature_option_get && mods->feature_enable && mods->feature_set_option;
+    if (!feature_provider) { draw_mods(m, th); return; }   // packages-only providers keep the classic page
+    const bool cheats = m->mod_group_filter == 2;
+
+    // The groups this page shows, in the classic page's order.
+    const int feature_count = mods->feature_count(mods->ctx);
+    std::vector<ModFeatureListItem> in_scope;
+    for (int index = 0; index < feature_count; ++index) {
+        ModFeatureListItem item{};
+        item.index = index;
+        if (!mods->feature_get(mods->ctx, index, &item.feature) ||
+            (item.feature.hidden && !item.feature.enabled) ||
+            !mod_feature_in_scope(m, item.feature))
+            continue;
+        // A feature promoted to a Settings > Display row (Frame rate, Intro
+        // movie) is set there; listing it here too made two rows for one
+        // switch.
+        bool featured = false;
+        for (int fr = 0; fr < m->num_featured_mod_rows && !featured; ++fr) {
+            const RecompLauncherCFeaturedModRow* r = &m->featured_mod_rows[fr];
+            if (!r->package_id || strcmp(r->package_id, item.feature.package_id) != 0) continue;
+            for (int k = 0; k < r->num_feature_ids; ++k)
+                if (r->feature_ids[k] && strcmp(r->feature_ids[k], item.feature.id) == 0) { featured = true; break; }
+        }
+        if (featured) continue;
+        in_scope.push_back(item);
+    }
+    std::stable_sort(in_scope.begin(), in_scope.end(), mod_feature_less);
+    std::vector<std::string> groups;
+    for (const auto& it : in_scope) {
+        const std::string g = it.feature.group[0] ? it.feature.group : ui_text("General");
+        if (groups.empty() || groups.back() != g) groups.push_back(g);
+    }
+    const int ngroups = (int)groups.size();
+    const int pk_row = ngroups;                    // Installed packages (Mods page)
+    if (cheats) m->mod_show_packages = false;
+    if (!m->mod_show_packages && (m->mod_section < 0 || m->mod_section >= ngroups)) m->mod_section = 0;
+
+    const float gap = px(th.spacing_lg);
+    const float menu_w = px(340.0f);
+    const float row_h = px(62.0f);
+    const float box_gap = px(8.0f);
+    const float body_h = ImGui::GetContentRegionAvail().y;
+    static ConsoleMenuState smenu;
+    static ConsoleMenuState rows;
+    smenu.enter_body_on_right = true;
+    s_console_body_rows_last = s_console_body_rows;
+    s_console_body_rows = 0;
+    s_console_pills_drawn = false;
+    const bool entering = s_console_view_changed;
+    if (entering) { smenu.cursor = m->mod_show_packages ? pk_row : m->mod_section; rows.cursor = 0; }
+
+    begin_container("con_mod_menu", ImVec2(menu_w, body_h), ImGuiChildFlags_NavFlattened, ImGuiWindowFlags_NoScrollbar);
+    {
+        ImGui::Dummy(ImVec2(0, px(6.0f)));
+        for (int i = 0; i < ngroups; ++i) {
+            char id[32]; snprintf(id, sizeof(id), "##mg%d", i);
+            ImVec2 p = ImGui::GetCursorScreenPos();
+            const bool cur = !m->mod_show_packages && i == m->mod_section;
+            if ((entering || s_console_refocus_menu) && cur) ImGui::SetKeyboardFocusHere();
+            char lbl[80]; snprintf(lbl, sizeof(lbl), "%s", groups[i].c_str());
+            for (char* c = lbl; *c; ++c) *c = (char)toupper((unsigned char)*c);
+            if (console_menu_item(&smenu, i, id, lbl, nullptr, menu_w, row_h, th, true, false, cur) ||
+                (ImGui::IsItemFocused() && ImGui::GetIO().NavVisible)) {
+                if (m->mod_show_packages || m->mod_section != i) rows.cursor = 0;
+                m->mod_section = i; m->mod_show_packages = false;
+            }
+            if (i == 0 && entering) ImGui::SetItemDefaultFocus();
+            (void)p;
+            ImGui::Dummy(ImVec2(0, box_gap - ImGui::GetStyle().ItemSpacing.y));
+        }
+        if (ngroups == 0) {
+            ImGui::Dummy(ImVec2(0, px(4.0f)));
+            ImGui::PushTextWrapPos(ImGui::GetCursorPosX() + menu_w - px(16.0f));
+            ImGui::TextColored(col(th.text_muted), "%s",
+                cheats && m->cheats_page_note && m->cheats_page_note[0] ? m->cheats_page_note
+                : feature_count ? ui_text("Nothing on this page for this disc.") : ui_text("No mod features installed."));
+            ImGui::PopTextWrapPos();
+        }
+        if (!cheats && mods->package_count && mods->package_get) {
+            ImGui::Dummy(ImVec2(0, px(14.0f)));
+            if ((entering || s_console_refocus_menu) && m->mod_show_packages) ImGui::SetKeyboardFocusHere();
+            if (console_menu_item(&smenu, pk_row, "##mpk", ui_text("INSTALLED PACKAGES"), nullptr, menu_w, row_h, th, true, false, m->mod_show_packages) ||
+                (ImGui::IsItemFocused() && ImGui::GetIO().NavVisible))
+                m->mod_show_packages = true;
+        }
+        ImGui::Dummy(ImVec2(0, px(14.0f)));
+        if (console_menu_item(&smenu, pk_row + 1, "##mback", ui_text("BACK"), nullptr, menu_w, row_h, th))
+            launcher_model_set_view(m, LNG_VIEW_DASHBOARD);
+    }
+    end_container();
+    ImGui::SameLine(0, gap);
+    begin_container("con_mod_body", ImVec2(0, body_h), ImGuiChildFlags_NavFlattened);
+    s_row_help[0] = 0; s_row_help_set = false;
+    {
+        // page title: MODS / <group>, the one preset pair at the right
+        char ttl[96];
+        if (m->mod_show_packages) snprintf(ttl, sizeof(ttl), "%s", ui_text("INSTALLED PACKAGES"));
+        else if (ngroups > 0) { snprintf(ttl, sizeof(ttl), "%s", groups[m->mod_section].c_str()); for (char* c = ttl; *c; ++c) *c = (char)toupper((unsigned char)*c); }
+        else snprintf(ttl, sizeof(ttl), "%s", cheats ? ui_text("CHEATS") : ui_text("MODS"));
+        console_page_title(cheats ? ui_text("CHEATS") : ui_text("MODS"), ttl, th);
+        if (!cheats && !m->mod_show_packages) console_preset_pills(m, th);
+        console_page_rule(th);
+    }
+    if (m->mod_show_packages) {
+        draw_mod_packages(m, th);
+    } else {
+        const float availw = ImGui::GetContentRegionAvail().x;
+        // ---- action bar: enable/disable all, install, search ----
+        if (ImGui::Button(ui_text("Enable all"), ImVec2(px(110), px(30)))) set_all_mod_features(m, true);
+        ImGui::SameLine(0, px(8.0f));
+        if (ImGui::Button(ui_text("Disable all"), ImVec2(px(110), px(30)))) set_all_mod_features(m, false);
+        if (!cheats && mods->install_archive) {
+            const char* ext = mods->archive_extension && mods->archive_extension[0] ? mods->archive_extension : ".psxmod";
+            char lbl[96]; snprintf(lbl, sizeof(lbl), "%s %s", ui_text("Install"), ext);
+            char pat[64]; snprintf(pat, sizeof(pat), "*%s", ext);
+            ImGui::SameLine(0, px(18.0f));
+            if (ImGui::Button(lbl, ImVec2(px(150), px(30)))) {
+                const char* patterns[] = { pat };
+                char path[1024];
+                if (launcher_pick_file("Install Mod Package", patterns, 1,
+                                       mods->archive_description && mods->archive_description[0]
+                                           ? mods->archive_description : "PSXRecomp mod package (.psxmod)",
+                                       path, sizeof(path))) {
+                    if (!mods->install_archive(mods->ctx, path)) mod_note_error(m);
+                    else std::snprintf(m->mod_status, sizeof(m->mod_status),
+                                       ui_text("Package installed. Changes apply when you press PLAY."));
+                }
+            }
+        }
+        {
+            const float sw = px(220.0f);
+            ImGui::SameLine(0, 0);
+            ImGui::SetCursorPosX(ImGui::GetCursorStartPos().x + availw - sw);
+            ImGui::SetNextItemWidth(sw);
+            ImGui::InputTextWithHint("##mod_search", ui_text("Search..."), m->mod_search, sizeof(m->mod_search));
+        }
+        if (m->mod_status[0]) {
+            ImGui::PushStyleColor(ImGuiCol_Text, col(th.warn));
+            ImGui::PushTextWrapPos(ImGui::GetCursorPosX() + availw);
+            ImGui::TextWrapped("%s", m->mod_status);
+            ImGui::PopTextWrapPos();
+            ImGui::PopStyleColor();
+        }
+        ImGui::Dummy(ImVec2(0, px(8.0f)));
+
+        // ---- rows: the group in view (or every group while searching) ----
+        const bool searching = m->mod_search[0] != 0;
+        const float frow_h = px(54.0f);
+        int shown = 0, ridx = 0, live_row = -1;
+        std::vector<int> row_index;   // row -> feature index, for the detail card
+        std::string last_group;
+        for (const auto& it : in_scope) {
+            const RecompLauncherCModFeature& f = it.feature;
+            const std::string g = f.group[0] ? f.group : ui_text("General");
+            if (!searching && ngroups > 0 && g != groups[m->mod_section]) continue;
+            if (searching && !mod_feature_text_matches(m->mod_search, f)) continue;
+            if (searching && g != last_group) {
+                if (!last_group.empty()) ImGui::Dummy(ImVec2(0, px(8.0f)));
+                console_eyebrow(g.c_str(), th);
+                last_group = g;
+            }
+            char sub[200];
+            snprintf(sub, sizeof(sub), "%s%s%s", f.package_name[0] ? f.package_name : f.package_id,
+                     f.package_version[0] ? "  " : "", f.package_version);
+            char id[64]; snprintf(id, sizeof(id), "##f%s/%s", f.package_id, f.id);
+            const bool on = f.enabled != 0;
+            if (console_toggle_row(&rows, ridx, id, f.name, sub, on, f.has_error != 0, availw, frow_h, th)) {
+                if (!mods->feature_enable(mods->ctx, f.package_id, f.id, on ? 0 : 1)) mod_note_error(m);
+            }
+            if (ImGui::IsItemHovered() || ImGui::IsItemFocused()) live_row = ridx;
+            row_index.push_back(it.index);
+            ++ridx; ++shown;
+        }
+        // The card describes the row under the cursor, or the last one it
+        // was on while the cursor sits in the group list.
+        if (!row_index.empty()) {
+            int want = live_row >= 0 ? live_row : rows.cursor;
+            if (want < 0 || want >= (int)row_index.size()) want = 0;
+            m->mod_selected = row_index[(size_t)want];
+        }
+        if (shown == 0) {
+            ImGui::TextColored(col(th.text_muted), "%s",
+                searching ? ui_text("No matching features.")
+                : cheats && m->cheats_page_note && m->cheats_page_note[0] ? m->cheats_page_note
+                : ui_text("Nothing here for this disc."));
+        }
+
+        // ---- detail card for the row under the cursor ----
+        RecompLauncherCModFeature feature{};
+        if (shown > 0 && feature_count > 0 && m->mod_selected >= 0 && m->mod_selected < feature_count &&
+            mods->feature_get(mods->ctx, m->mod_selected, &feature) && mod_feature_in_scope(m, feature)) {
+            ImGui::Dummy(ImVec2(0, px(12.0f)));
+            if (begin_panel("mod_detail", 0, false)) draw_mod_feature_detail_body(m, th, feature);
+            end_panel();
+        }
+    }
+    if (s_row_help_set) {
+        ImGui::Dummy(ImVec2(0, px(8.0f)));
+        ImGui::SetCursorPosX(ImGui::GetCursorPosX() + px(6.0f));
+        ImGui::PushTextWrapPos(ImGui::GetCursorPosX() + ImGui::GetContentRegionAvail().x - px(12.0f));
+        ImGui::TextColored(col(th.text_muted), "%s", ui_text(s_row_help));
+        ImGui::PopTextWrapPos();
+    }
+    s_console_enter_body = false;
+    s_console_refocus_menu = false;
+    end_container();
+}
