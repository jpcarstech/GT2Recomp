+/* Where the player's OWN configuration lives, as opposed to this build's.
+ * settings.toml is only part of it: input.ini (pad mapping) and keybinds.ini
+ * (keyboard/hotkeys) are the same kind of thing -- one player's preferences,
+ * not a property of the disc -- and a multi-title install must keep them
+ * together or remapping a button on one disc silently leaves the others on
+ * defaults. Anchored to the shared settings.toml's own directory, so opting
+ * a title into [runtime] settings_path moves the whole set with it and there
+ * is no second key to keep consistent. Empty settings_path -> the exe dir,
+ * the single-title layout, unchanged.
+ *
+ * Deliberately NOT moved: patches/ (the enabled mods and cheats -- those ARE
+ * a property of the disc and differ between them) and disc.cfg (each title's
+ * own image). */
+static std::filesystem::path shared_config_dir(const char* argv0) {
+    if (!g_cfg_settings_file.empty()) {
+        std::filesystem::path d = g_cfg_settings_file.parent_path();
+        if (!d.empty()) return d;
+    }
+    return exe_dir_from_argv(argv0);
+}
