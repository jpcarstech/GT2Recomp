+/* [runtime] featured_feature_row config, captured at config load. String
+ * storage for both the launcher rows and the F1 surface. */
+static std::vector<PSXRecompV4::RuntimeConfig::FeaturedFeatureRow>
+    g_featured_rows_cfg;
