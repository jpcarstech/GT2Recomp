From cb28fb05040cdddf0cd2ab16e7b8fd03b68f4de6 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 27 Aug 2026 23:07:15 +0000
Subject: [PATCH] GT2Recomp carried: mod-owned PGXP correction guard
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The builtin PGXP Precision mod's activation arms geometry/texture
correction, then main.cpp's [video] settle re-applies the config values
(default off) over it — the player's enabled mod is silently turned
back off before the first frame. Same settle-clobber class as the
display-aspect guard. Env overrides keep priority.
---
 runtime/src/main.cpp           | 21 ++++++++++++++++++---
 runtime/src/mod_builtin_pgxp.c |  6 ++++++
 2 files changed, 24 insertions(+), 3 deletions(-)

diff --git a/runtime/src/main.cpp b/runtime/src/main.cpp
index 2cc7409a..f1455e82 100644
--- a/runtime/src/main.cpp
+++ b/runtime/src/main.cpp
@@ -13786,9 +13786,24 @@ session_reboot:
         g_video_perspective_texturing = (*e && *e != '0') ? 1 : 0;
     if (const char* e = std::getenv("PSX_PGXP_CPU_MODE"))
         g_video_pgxp_cpu_mode = (*e && *e != '0') ? 1 : 0;
-    gte_geometry_correction_set(g_video_geometry_correction);
-    gpu_texture_correction_set(g_video_perspective_texturing);
-    pgxp_set_cpu_mode(g_video_pgxp_cpu_mode);
+    /* Mod-owned guard (same class as the display-aspect settle guard): the
+     * builtin PGXP Precision mod's activation plugin ran at
+     * mod_runtime_activate_plugins() above and armed the correction engine.
+     * Re-applying the [video]/launcher values here would clobber that enable
+     * back off a moment after the player's mod turned it on. The env
+     * overrides stay authoritative either way (debug/validation path). */
+    {
+        extern int g_mod_owns_pgxp;
+        const int pgxp_env_override =
+            std::getenv("PSX_GEOMETRY_CORRECTION") != nullptr ||
+            std::getenv("PSX_PERSPECTIVE_TEXTURING") != nullptr ||
+            std::getenv("PSX_PGXP_CPU_MODE") != nullptr;
+        if (!g_mod_owns_pgxp || pgxp_env_override) {
+            gte_geometry_correction_set(g_video_geometry_correction);
+            gpu_texture_correction_set(g_video_perspective_texturing);
+            pgxp_set_cpu_mode(g_video_pgxp_cpu_mode);
+        }
+    }
     pgxp_set_tolerance(g_video_pgxp_tolerance);
     if (g_video_geometry_correction || g_video_perspective_texturing) {
         std::fprintf(stdout,
diff --git a/runtime/src/mod_builtin_pgxp.c b/runtime/src/mod_builtin_pgxp.c
index 4db67d42..3ea51953 100644
--- a/runtime/src/mod_builtin_pgxp.c
+++ b/runtime/src/mod_builtin_pgxp.c
@@ -31,7 +31,13 @@ static int pgxp_option_flag(const char* feature, const char* id) {
            strcmp(text, "true") == 0;
 }
 
+/* Read by main.cpp's post-activation [video] settle: once this mod has armed
+ * the correction engine, the config/launcher values must not clobber it
+ * (mirror of the mod-owned display-aspect guard). */
+int g_mod_owns_pgxp = 0;
+
 static void builtin_pgxp_activate(void) {
+    g_mod_owns_pgxp = 1;
     gte_geometry_correction_set(1);
     gpu_texture_correction_set(1);   /* also arms the shadow engine */
     pgxp_set_cpu_mode(pgxp_option_flag("pgxp", "cpu_mode"));
