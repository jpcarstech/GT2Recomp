+                            std::snprintf(
+                                m->mod_status,
+                                sizeof(m->mod_status),
+                                "%s verified. Changes apply on PLAY.",
+                                resource.label);
+                        }
+                    }
+                }
+                ImGui::PopID();
+                ImGui::Spacing();
+            }
+        }
