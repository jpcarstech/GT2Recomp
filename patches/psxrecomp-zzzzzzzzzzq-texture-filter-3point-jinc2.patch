-            if (mode == "nearest")       rt.video_texture_filter = 0;
-            else if (mode == "bilinear") rt.video_texture_filter = 1;
+            if (mode == "nearest")        rt.video_texture_filter = 0;
+            else if (mode == "bilinear")  rt.video_texture_filter = 1;
