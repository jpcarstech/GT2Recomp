+/* The FMV half of the native-4:3 predicate, exported for trusted mods that
+ * must leave "authentic video playback" untouched (e.g. a CPU overclock that
+ * disengages during movies): under strict classification a composited scene
+ * with an embedded MDEC stream (GT2 course select) is NOT video, so the mod
+ * stays engaged there while the intro and fullscreen movies still gate it. */
+int gpu_ws_fmv_frame(void) {
+    (void)gpu_ws_present_native_43();   /* refresh the per-frame cache */
+    return s_ws_fmv_cached;
+}
