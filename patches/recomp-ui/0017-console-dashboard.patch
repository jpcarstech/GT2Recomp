+// Footer: input hints at the left (the glyphs follow whether a pad is
+// connected), the skip-launcher toggle, and the host's version text at the
+// right edge. No PLAY: Start game is the first menu row.
+static void console_hint(ImDrawList* dl, ImVec2& cur, const LauncherTheme& th, const char* key, const char* what) {
+    ImGui::SetWindowFontScale(0.85f);
+    const float lh = ImGui::GetTextLineHeight();
+    const float pad = px(7.0f);
+    const bool updown = strcmp(key, "UPDOWN") == 0;   // drawn, not typed: no font has the arrows for sure
+    const bool cross = strcmp(key, "CROSS") == 0, circle = strcmp(key, "CIRCLE") == 0;
+    const bool leftright = strcmp(key, "LEFTRIGHT") == 0;
+    ImVec2 ks = (updown || leftright) ? ImVec2(px(18.0f), lh) : (cross || circle) ? ImVec2(lh, lh) : ImGui::CalcTextSize(key);
+    const float kh = lh + px(4.0f), kw = ks.x + pad * 2;
+    dl->AddRectFilled(cur, ImVec2(cur.x + kw, cur.y + kh), imcol(th.control_hovered), px(4.0f));
+    dl->AddRect(cur, ImVec2(cur.x + kw, cur.y + kh), imcol(th.border), px(4.0f), 0, px(1));
+    if (updown) {
+        const float t = px(4.0f), cx1 = cur.x + pad + px(4.0f), cx2 = cur.x + pad + px(14.0f), cy = cur.y + kh * 0.5f;
+        dl->AddTriangleFilled(ImVec2(cx1 - t, cy + t * 0.6f), ImVec2(cx1 + t, cy + t * 0.6f), ImVec2(cx1, cy - t * 0.8f), imcol(th.text));
+        dl->AddTriangleFilled(ImVec2(cx2 - t, cy - t * 0.6f), ImVec2(cx2 + t, cy - t * 0.6f), ImVec2(cx2, cy + t * 0.8f), imcol(th.text));
+    } else if (leftright) {
+        const float t = px(4.0f), cy = cur.y + kh * 0.5f, cx1 = cur.x + pad + px(4.0f), cx2 = cur.x + pad + px(14.0f);
+        dl->AddTriangleFilled(ImVec2(cx1 + t * 0.6f, cy - t), ImVec2(cx1 + t * 0.6f, cy + t), ImVec2(cx1 - t * 0.8f, cy), imcol(th.text));
+        dl->AddTriangleFilled(ImVec2(cx2 - t * 0.6f, cy - t), ImVec2(cx2 - t * 0.6f, cy + t), ImVec2(cx2 + t * 0.8f, cy), imcol(th.text));
+    } else if (cross || circle) {
+        const float cx = cur.x + kw * 0.5f, cy = cur.y + kh * 0.5f, r = lh * 0.32f;
+        if (circle) dl->AddCircle(ImVec2(cx, cy), r, imcol(th.text), 0, px(1.6f));
+        else {
+            dl->AddLine(ImVec2(cx - r, cy - r), ImVec2(cx + r, cy + r), imcol(th.text), px(1.6f));
+            dl->AddLine(ImVec2(cx - r, cy + r), ImVec2(cx + r, cy - r), imcol(th.text), px(1.6f));
+        }
+    } else {
+        dl->AddText(ImVec2(cur.x + pad, cur.y + px(2.0f)), imcol(th.text), key);
+    }
+    dl->AddText(ImVec2(cur.x + kw + px(8.0f), cur.y + px(2.0f)), imcol(th.text_muted), what);
+    cur.x += kw + px(8.0f) + ImGui::CalcTextSize(what).x + px(26.0f);
+    ImGui::SetWindowFontScale(1.0f);
+}
+
+static void draw_console_footer(LauncherModel* m, const LauncherTheme& th, float footer_h) {
+    const ImVec2 origin = ImGui::GetCursorScreenPos();
+    const float fullw = ImGui::GetContentRegionAvail().x;
+    ImDrawList* dl = ImGui::GetWindowDrawList();
+    dl->AddLine(origin, ImVec2(origin.x + fullw, origin.y), imcol(th.border), px(1));
+    const bool pad = g_pad_count > 0;
+    ImVec2 cur(origin.x, origin.y + (footer_h - ImGui::GetTextLineHeight() - px(4.0f)) * 0.5f + px(1.0f));
+    // PlayStation glyphs on a pad (this is a PlayStation front end), keys otherwise
+    if (m->view == LNG_VIEW_DASHBOARD) {
+        console_hint(dl, cur, th, "UPDOWN", ui_text("Move cursor"));
+        console_hint(dl, cur, th, pad ? "CROSS" : "Enter", ui_text("Confirm"));
+        console_hint(dl, cur, th, pad ? "CIRCLE" : "Esc", ui_text("Back"));
+        if (m->save_summary_cb) console_hint(dl, cur, th, pad ? "L1 R1" : "Q E", ui_text("Card 1 / 2"));
+    } else {
+        console_hint(dl, cur, th, "UPDOWN", ui_text("Move cursor"));
+        console_hint(dl, cur, th, pad ? "CROSS" : "Enter", ui_text("Confirm"));
+        console_hint(dl, cur, th, pad ? "CIRCLE" : "Esc", ui_text("Back"));
+        if (m->view == LNG_VIEW_SETTINGS) console_hint(dl, cur, th, "LEFTRIGHT", ui_text("Change"));
+    }
+    // right edge: version text, then the skip toggle to its left
+    float right = origin.x + fullw;
+    if (m->dashboard_footer_text && m->dashboard_footer_text[0]) {
+        ImGui::SetWindowFontScale(0.85f);
+        ImVec2 ts = ImGui::CalcTextSize(m->dashboard_footer_text);
+        dl->AddText(ImVec2(right - ts.x, cur.y + px(2.0f)), imcol(th.text_muted), m->dashboard_footer_text);
+        ImGui::SetWindowFontScale(1.0f);
+        right -= ts.x + px(28.0f);
+    }
+    (void)right;   // "Open the launcher on boot" lives under Settings > Launcher
+}
+
+// Keys the console front end answers on its own: B/Esc backs out of a page,
+// re-homes the dashboard cursor; L1/R1 (Q/E) flip the save panel's card.
+static void console_handle_keys(LauncherModel* m) {
+    const ImGuiIO& io = ImGui::GetIO();
+    if (io.WantTextInput) return;
+    if (ImGui::IsPopupOpen("", ImGuiPopupFlags_AnyPopupId | ImGuiPopupFlags_AnyPopupLevel)) return;
+    const bool back = ImGui::IsKeyPressed(ImGuiKey_GamepadFaceRight, false) ||
+                      ImGui::IsKeyPressed(ImGuiKey_Escape, false);
+    if (back) {
+        if (m->view == LNG_VIEW_DASHBOARD) s_console_home_focus = true;
+        else if ((m->view == LNG_VIEW_SETTINGS || m->view == LNG_VIEW_MODS) && s_console_focus_in_body)
+            s_console_refocus_menu = true;   // first B: back to the section list
+        else launcher_model_set_view(m, LNG_VIEW_DASHBOARD);
+    }
+    if (ImGui::IsKeyPressed(ImGuiKey_F11, false) ||
+        (io.KeyAlt && ImGui::IsKeyPressed(ImGuiKey_Enter, false)))
+        m->launcher_fullscreen = !m->launcher_fullscreen;
+    if (m->view == LNG_VIEW_DASHBOARD && m->save_summary_cb) {
+        if (ImGui::IsKeyPressed(ImGuiKey_GamepadL1, false) || ImGui::IsKeyPressed(ImGuiKey_Q, false))
+            m->save_card = 0;
+        if (ImGui::IsKeyPressed(ImGuiKey_GamepadR1, false) || ImGui::IsKeyPressed(ImGuiKey_E, false))
+            m->save_card = 1;
+    }
+}
