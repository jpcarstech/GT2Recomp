+// =============================================================================
+// Console-style front end (GameInfo.console_dashboard)
+//
+// The look of an HD re-release's menu rather than a settings app: the game's
+// own logo in the header, a menu column on the left (Start game / Switch disc
+// / Settings / Mods / Cheats / Quit) and, on the right, a panel built from the
+// player's save (GameInfo.save_summary). Settings become a section list with
+// one section in view at a time; the cards that used to sit beside the box
+// art (disc, controllers, memory cards) live in those sections. Every row is
+// a real ImGui item, so keyboard, mouse and pad all drive it; the selected
+// row is the one with nav focus or the mouse over it.
+//
+// Nothing here runs unless the host asked for it: draw_ui branches on
+// m->console_dashboard, and the classic dashboard stays byte-for-byte.
+// =============================================================================
+// g_font_display / g_font_bold / g_console_fonts are declared near the top
+// (apply_scale builds the fonts before this block is reached).
+static LauncherTexture g_dash_logo, g_dash_backdrop;
+static std::map<std::string, LauncherTexture> g_dash_tex;   // save-panel images by rel path
+static bool    s_console_home_focus = false;   // B/Esc on the dashboard: back to Start game
+static bool    s_console_view_changed = true;  // first frame of a page: put the cursor on its first row
+static int     s_console_last_view = -1;
+std::string asset(const char* rel);              // defined with the backend entry below
+std::string normalized_path(const char* path);
+
+// Save-panel images are named by the host per card (the car you drive), so
+// they are loaded on first use and kept for the run. A missing file is a
+// zero texture, cached too, so it is only tried once.
+static const LauncherTexture& dash_texture(const char* rel) {
+    static LauncherTexture none = {};
+    if (!rel || !rel[0]) return none;
+    auto it = g_dash_tex.find(rel);
+    if (it != g_dash_tex.end()) return it->second;
+    std::string full = asset((std::string("assets/") + normalized_path(rel)).c_str());
+    LauncherTexture t = launcher_texture_load(full.c_str());
+    return g_dash_tex.emplace(rel, t).first->second;
+}
+
+static void console_load_art(LauncherModel* m) {
+    g_dash_logo = LauncherTexture{};
+    g_dash_backdrop = LauncherTexture{};
+    if (!m->console_dashboard) return;
+    if (m->dashboard_logo_path && m->dashboard_logo_path[0])
+        g_dash_logo = launcher_texture_load(
+            asset((std::string("assets/") + normalized_path(m->dashboard_logo_path)).c_str()).c_str());
+    if (m->dashboard_backdrop_path && m->dashboard_backdrop_path[0])
+        g_dash_backdrop = launcher_texture_load(
+            asset((std::string("assets/") + normalized_path(m->dashboard_backdrop_path)).c_str()).c_str());
+}
+
+static void console_free_art() {
+    launcher_texture_free(&g_dash_logo);
+    launcher_texture_free(&g_dash_backdrop);
+    for (auto& kv : g_dash_tex) launcher_texture_free(&kv.second);
+    g_dash_tex.clear();
+}
