+/* Activity trail for the load-acceleration gate (main.cpp): every sector the
+ * guest actually transfers bumps a counter, and the pacing loop compares it
+ * against the value it saw last vblank. A card that is merely probed for
+ * presence (GETID / a directory-frame read) shows up here too, which is
+ * intended - a game polling for a card in a menu is one or two sectors a
+ * second, while a save-data load is hundreds per second, and the gate keys
+ * on that density, not on the first sector. */
+static uint64_t s_io_sectors;
+static int s_trace = -1;
+
+static void note_io(const char* what, int card, int sector) {
+    s_io_sectors++;
+    if (s_trace < 0) s_trace = getenv("PSX_MEMCARD_TRACE") ? 1 : 0;
+    if (s_trace && (s_io_sectors & 63u) == 1u)
+        fprintf(stderr, "memcard: %s card=%d sector=%d (op #%llu)\n", what, card,
+                sector, (unsigned long long)s_io_sectors);
+}
+
+uint64_t memcard_io_sector_count(void) { return s_io_sectors; }
+
 int memcard_read_sector(int card, int sector, uint8_t* buf) {
     if (card < 0 || card >= MAX_CARDS) return -1;
     if (!cards[card].present) return -1;
     if (sector < 0 || sector >= MEMCARD_SECTORS) return -1;
 
+    note_io("read", card, sector);
     memcpy(buf, cards[card].data + sector * MEMCARD_SECTOR_SIZE, MEMCARD_SECTOR_SIZE);
     return 0;
 }
@@ -350,6 +371,7 @@ int memcard_write_sector(int card, int sector, const uint8_t* buf) {
     if (!cards[card].present) return -1;
     if (sector < 0 || sector >= MEMCARD_SECTORS) return -1;
 
+    note_io("write", card, sector);
     memcpy(cards[card].data + sector * MEMCARD_SECTOR_SIZE, buf, MEMCARD_SECTOR_SIZE);
     cards[card].dirty = 1;
     return 0;
