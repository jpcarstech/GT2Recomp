+/* ---- multi-title installs (sibling disc titles) ---------------------------
+ * A game sold across several discs can be installed as SIBLING BUILDS, one
+ * folder per recompiled title under a shared parent:
+ *   <install>/titles/arcade/     game.toml  <exe>  generated caches...
+ *   <install>/titles/simulation/ game.toml  <exe>  ...
+ * Each title's game.toml opts in with [runtime] title_label = "Arcade".
+ * At boot the runtime scans the exe dir's PARENT for such siblings and
+ * offers them in the launcher's "Disc" row; picking one relaunches into
+ * that title's exe. The choice is persisted as [launcher] active_title
+ * (the folder name) in the shared settings file so the install's root stub
+ * can spawn the right title next time. */
+struct SiblingTitle {
+    std::string dir_name;  /* folder name under the shared parent */
+    std::string label;     /* [runtime] title_label */
+    std::string exe;       /* absolute exe path ("" = not runnable) */
+};
+static std::vector<SiblingTitle> g_sibling_titles;   /* sorted by dir_name */
+static int g_sibling_active = -1;                    /* index of THIS build */
+static std::string g_sibling_argv0;                  /* argv[0] at discovery */
+/* Borrowed C views for RecompLauncherCGameInfo (outlive run_window). */
+static std::vector<const char*> g_sibling_label_ptrs;
+static std::vector<const char*> g_sibling_exe_ptrs;
+
+/* Cheap [runtime] title_label scan. Deliberately NOT load_game_config(): a
+ * sibling's config is foreign input, and a parse error there must never
+ * break THIS title's boot — an unreadable sibling is simply not offered. */
+static std::string scan_sibling_title_label(const std::filesystem::path& cfg) {
+    std::ifstream f(cfg);
+    if (!f) return {};
+    std::string line;
+    bool in_runtime = false;
+    while (std::getline(f, line)) {
+        size_t b = line.find_first_not_of(" \t");
+        if (b == std::string::npos) continue;
+        if (line[b] == '#') continue;
+        if (line[b] == '[') {
+            in_runtime = (line.compare(b, 9, "[runtime]") == 0);
+            continue;
+        }
+        if (!in_runtime) continue;
+        if (line.compare(b, 11, "title_label") != 0) continue;
+        const size_t q1 = line.find('"', b + 11);
+        if (q1 == std::string::npos) continue;
+        const size_t q2 = line.find('"', q1 + 1);
+        if (q2 == std::string::npos) continue;
+        return line.substr(q1 + 1, q2 - q1 - 1);
+    }
+    return {};
+}
+
+/* The runnable exe inside a title folder: alphabetically first .exe on
+ * Windows / owner-executable regular file elsewhere, so an install with one
+ * exe per title (the shipped layout) is unambiguous. */
+static std::string find_sibling_title_exe(const std::filesystem::path& dir) {
+    namespace fs = std::filesystem;
+    std::error_code ec;
+    std::string best;
+    for (const auto& e : fs::directory_iterator(dir, ec)) {
+        if (ec) break;
+        std::error_code ec2;
+        if (!e.is_regular_file(ec2)) continue;
+        const fs::path& p = e.path();
+#ifdef _WIN32
+        std::string ext = p.extension().string();
+        for (char& c : ext) c = (char)std::tolower((unsigned char)c);
+        if (ext != ".exe") continue;
+#else
+        const auto perms = fs::status(p, ec2).permissions();
+        if (ec2) continue;
+        if ((perms & fs::perms::owner_exec) == fs::perms::none) continue;
+        if (p.extension() == ".so" || p.extension() == ".sh" ||
+            p.extension() == ".toml")
+            continue;
+#endif
+        const std::string s = p.string();
+        if (best.empty() || s < best) best = s;
+    }
+    return best;
+}
+
+static void discover_sibling_titles(const char* argv0) {
+    namespace fs = std::filesystem;
+    g_sibling_argv0 = (argv0 && argv0[0]) ? argv0 : "";
+    g_sibling_titles.clear();
+    g_sibling_active = -1;
+    g_sibling_label_ptrs.clear();
+    g_sibling_exe_ptrs.clear();
+    std::error_code ec;
+    const fs::path own = fs::weakly_canonical(exe_dir_from_argv(argv0), ec);
+    if (ec || own.empty()) return;
+    const fs::path parent = own.parent_path();
+    if (parent.empty() || parent == own) return;
+    for (const auto& e : fs::directory_iterator(parent, ec)) {
+        if (ec) break;
+        std::error_code ec2;
+        if (!e.is_directory(ec2)) continue;
+        const fs::path cfg = e.path() / "game.toml";
+        if (!fs::exists(cfg, ec2)) continue;
+        const std::string label = scan_sibling_title_label(cfg);
+        if (label.empty()) continue;   /* not opted into the multi-title UI */
+        SiblingTitle t;
+        t.dir_name = e.path().filename().string();
+        t.label    = label;
+        t.exe      = find_sibling_title_exe(e.path());
+        g_sibling_titles.push_back(std::move(t));
+    }
+    std::sort(g_sibling_titles.begin(), g_sibling_titles.end(),
+              [](const SiblingTitle& a, const SiblingTitle& b) {
+                  return a.dir_name < b.dir_name;
+              });
+    const std::string own_name = own.filename().string();
+    for (size_t i = 0; i < g_sibling_titles.size(); ++i)
+        if (g_sibling_titles[i].dir_name == own_name)
+            g_sibling_active = (int)i;
+    if (g_sibling_active < 0 || g_sibling_titles.size() < 2) {
+        /* Own folder didn't opt in, or nothing to switch to: feature off. */
+        g_sibling_titles.clear();
+        g_sibling_active = -1;
+        return;
+    }
+    for (const auto& t : g_sibling_titles) {
+        g_sibling_label_ptrs.push_back(t.label.c_str());
+        g_sibling_exe_ptrs.push_back(t.exe.empty() ? nullptr : t.exe.c_str());
+    }
+}
+
+#if defined(RECOMP_LAUNCHER)
+static void apply_sibling_titles_to_game_info(RecompLauncherCGameInfo* gi) {
+    if (!gi || g_sibling_active < 0 || g_sibling_titles.size() < 2) return;
+    gi->title_labels    = g_sibling_label_ptrs.data();
+    gi->title_exe_paths = g_sibling_exe_ptrs.data();
+    gi->num_titles      = (int)g_sibling_titles.size();
+    gi->active_title    = g_sibling_active;
+}
+
+/* The launcher returned RESULT_SWITCH_TITLE: persist the pick for the root
+ * stub, spawn the picked title's exe back into the launcher, and exit this
+ * process. Returns only on failure (caller then exits like QUIT). Handle
+ * inheritance stays OFF — an inherited listening socket is exactly the
+ * quit-hang bug the exit finisher had. */
+static void switch_sibling_title_or_return(const char* argv0) {
+    namespace fs = std::filesystem;
+    char exe[512] = {0};
+    if (!recomp_launcher_relaunch_exe(exe, sizeof(exe)) || !exe[0]) {
+        std::fprintf(stderr,
+                     "psxrecomp: title switch requested but no exe path\n");
+        return;
+    }
+    /* Persist [launcher] active_title = <folder name> in shared settings. */
+    for (const auto& t : g_sibling_titles) {
+        if (t.exe != exe) continue;
+        auto us = PSXRecompV4::load_user_settings(settings_file_path(argv0));
+        if (!us.parse_error) {
+            us.active_title = t.dir_name;
+            us.has_active_title = true;
+            (void)PSXRecompV4::save_user_settings(settings_file_path(argv0),
+                                                  us);
+        }
+        break;
+    }
+    const fs::path exe_dir = fs::path(exe).parent_path();
+    std::fprintf(stdout, "psxrecomp: switching title -> %s\n", exe);
+#ifdef _WIN32
+    {
+        STARTUPINFOA si;
+        PROCESS_INFORMATION pi;
+        char cmd[1024];
+        std::memset(&si, 0, sizeof(si));
+        std::memset(&pi, 0, sizeof(pi));
+        si.cb = sizeof(si);
+        std::snprintf(cmd, sizeof(cmd), "\"%s\" --launcher", exe);
+        const std::string wd = exe_dir.string();
+        if (!CreateProcessA(NULL, cmd, NULL, NULL, FALSE, 0, NULL,
+                            wd.empty() ? NULL : wd.c_str(), &si, &pi)) {
+            std::fprintf(stderr,
+                         "psxrecomp: title switch CreateProcess failed\n");
+            return;
+        }
+        CloseHandle(pi.hThread);
+        CloseHandle(pi.hProcess);
+        ExitProcess(0);
+    }
+#else
+    {
+        std::error_code ec;
+        fs::current_path(exe_dir, ec);
+        char exe_buf[512];
+        std::snprintf(exe_buf, sizeof(exe_buf), "%s", exe);
+        char* args[] = {exe_buf, (char*)"--launcher", nullptr};
+        execv(exe_buf, args);
+        std::fprintf(stderr, "psxrecomp: title switch execv failed: %s\n",
+                     std::strerror(errno));
+        return;
+    }
+#endif
+}
+#endif /* RECOMP_LAUNCHER */
