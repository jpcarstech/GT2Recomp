+/* ---- remembered window state ------------------------------------------------
+ * A tiny key=value file beside the launcher's assets: the windowed geometry
+ * and whether the player left it maximized or fullscreen. Read at open,
+ * written at close; a missing or damaged file is the default layout. */
+typedef struct { int x, y, w, h, maximized, fullscreen, desk_w, desk_h; bool valid; } WindowState;
+
+/* The desktop the window lives on, in window units: what the remembered
+ * geometry is relative to. A different desktop next run (resolution or
+ * monitor changed) means the geometry is meaningless and only the
+ * maximized / fullscreen choice carries over. */
+static void desktop_size_of(SDL_Window* win, int* w, int* h) {
+    *w = *h = 0;
+    SDL_DisplayID display = win ? SDL_GetDisplayForWindow(win) : SDL_GetPrimaryDisplay();
+    const SDL_DisplayMode* dm = display ? SDL_GetDesktopDisplayMode(display) : NULL;
+    if (dm) { *w = dm->w; *h = dm->h; }
+}
+
+static WindowState read_window_state(const char* path) {
+    WindowState st; SDL_zero(st);
+    st.x = st.y = -1;
+    if (!path || !path[0]) return st;
+    FILE* f = fopen(path, "rb");
+    if (!f) return st;
+    char line[128];
+    while (fgets(line, sizeof(line), f)) {
+        int v = 0;
+        if (sscanf(line, "x=%d", &v) == 1) st.x = v;
+        else if (sscanf(line, "y=%d", &v) == 1) st.y = v;
+        else if (sscanf(line, "w=%d", &v) == 1) st.w = v;
+        else if (sscanf(line, "h=%d", &v) == 1) st.h = v;
+        else if (sscanf(line, "maximized=%d", &v) == 1) st.maximized = v != 0;
+        else if (sscanf(line, "fullscreen=%d", &v) == 1) st.fullscreen = v != 0;
+        else if (sscanf(line, "desktop_w=%d", &v) == 1) st.desk_w = v;
+        else if (sscanf(line, "desktop_h=%d", &v) == 1) st.desk_h = v;
+    }
+    fclose(f);
+    st.valid = st.w >= 320 && st.h >= 240 && st.w <= 16384 && st.h <= 16384;
+    return st;
+}
+
+static void write_window_state(const LauncherPlatform* p) {
+    if (!p || !p->remember_window || !p->state_path[0] || !p->window) return;
+    const SDL_WindowFlags fl = SDL_GetWindowFlags(p->window);
+    FILE* f = fopen(p->state_path, "wb");
+    if (!f) return;
+    int dw = 0, dh = 0;
+    desktop_size_of(p->window, &dw, &dh);
+    fprintf(f, "# launcher window state - written by the launcher, safe to delete\n"
+               "x=%d\ny=%d\nw=%d\nh=%d\nmaximized=%d\nfullscreen=%d\ndesktop_w=%d\ndesktop_h=%d\n",
+            p->restore_x, p->restore_y, p->restore_w, p->restore_h,
+            (fl & SDL_WINDOW_MAXIMIZED) ? 1 : 0, p->fullscreen ? 1 : 0, dw, dh);
+    fclose(f);
+}
+
+/* While the window is plain (not maximized/fullscreen/minimized) its
