+
+// Small tracked uppercase label in the accent colour: the section eyebrow of
+// the console panels (lighter than eyebrow(): no tick, smaller type).
+static void console_eyebrow(const char* s, const LauncherTheme& th, bool muted) {
+    ImDrawList* dl = ImGui::GetWindowDrawList();
+    ImVec2 p = ImGui::GetCursorScreenPos();
+    ImGui::SetWindowFontScale(0.78f);
+    float h = ImGui::GetTextLineHeight();
+    ImU32 c = imcol(muted ? th.text_muted : th.accent2);
+    float x = p.x;
+    char buf[5] = {0, 0, 0, 0, 0};
+    for (const char* q = s; *q;) {
+        // copy one UTF-8 sequence
+        int n = 1;
+        if ((*q & 0xE0) == 0xC0) n = 2; else if ((*q & 0xF0) == 0xE0) n = 3; else if ((*q & 0xF8) == 0xF0) n = 4;
+        for (int i = 0; i < n && q[i]; ++i) buf[i] = q[i];
+        buf[n] = 0;
+        dl->AddText(ImVec2(x, p.y), c, buf);
+        x += ImGui::CalcTextSize(buf).x + px(1.8f);
+        q += n;
+    }
+    ImGui::Dummy(ImVec2(x - p.x, h));
+    ImGui::SetWindowFontScale(1.0f);
+}
+
+// One menu row. Fully custom-drawn over an InvisibleButton (EnableNav so the
+// pad can land on it): the selected row - nav focus or mouse over - is a
+// solid accent bar with black text and a play-marker; the others are white
+// text over a hairline. `value` prints a small pill at the right edge (the
+// active disc, the current preset). Returns true when activated.
+// A menu remembers its cursor: with neither nav focus nor the mouse on any
+// row (the window just opened, or the pointer wandered off), the row last
+// focused - Start game to begin with - still reads as selected, as it
+// would on a console. Tracked per menu by the caller's `cursor`.
+struct ConsoleMenuState { int cursor = 0; int hovered_last_frame = -1; int hovered_this_frame = -1; int frame = -1;
+                          bool enter_body_on_right = false; };   // section lists: ▶ steps onto the page's rows
+static bool console_menu_item(ConsoleMenuState* st, int idx, const char* id, const char* label,
+                              const char* value, float w, float h, const LauncherTheme& th,
+                              bool enabled = true, bool small = false, bool current = false) {
+    if (st && st->frame != ImGui::GetFrameCount()) {
+        st->frame = ImGui::GetFrameCount();
+        st->hovered_last_frame = st->hovered_this_frame;
+        st->hovered_this_frame = -1;
+    }
+    ImVec2 p = ImGui::GetCursorScreenPos();
+    if (!enabled) ImGui::BeginDisabled();
+    bool clk = ImGui::InvisibleButton(id, ImVec2(w, h), ImGuiButtonFlags_EnableNav);
+    if (!enabled) ImGui::EndDisabled();
+    const bool hov = enabled && ImGui::IsItemHovered();
+    const bool foc = enabled && ImGui::IsItemFocused();
+    if (st) {
+        if (hov) st->hovered_this_frame = idx;
+        if (foc || hov) st->cursor = idx;
+    }
+    const bool resting = st && st->cursor == idx && st->hovered_last_frame < 0 &&
+                         !ImGui::GetIO().NavVisible && enabled;
+    const bool sel = hov || foc || resting;
+    if (foc && st && st->enter_body_on_right && s_console_body_rows_last > 0) {
+        const ImGuiID tid = ImGui::GetItemID();
+        ImGui::SetKeyOwner(ImGuiKey_RightArrow, tid);
+        ImGui::SetKeyOwner(ImGuiKey_GamepadDpadRight, tid);
+        ImGui::SetKeyOwner(ImGuiKey_GamepadLStickRight, tid);
+        if (ImGui::IsKeyPressed(ImGuiKey_RightArrow, false) || ImGui::IsKeyPressed(ImGuiKey_GamepadDpadRight, false) ||
+            ImGui::IsKeyPressed(ImGuiKey_GamepadLStickRight, false))
+            s_console_enter_body = true;
+    }
+    ImDrawList* dl = ImGui::GetWindowDrawList();
+    ImVec2 mn = p, mx = ImVec2(p.x + w, p.y + h);
+    const float r = px(th.radius_sm);
+    if (small) {
+        // section rows: a hairline list, the selected one solid
+        if (sel) dl->AddRectFilled(mn, mx, imcol(th.accent), r);
+        else     dl->AddLine(ImVec2(mn.x, mx.y - px(1)), ImVec2(mx.x, mx.y - px(1)), imcol(th.border, 0.9f), px(1));
+    } else {
+        // menu rows: dark boxes, the selected one solid accent with a white
+        // edge at its left and a marker at its right
+        if (sel) {
+            dl->AddRectFilled(mn, mx, imcol(th.accent), r);
+            dl->AddRectFilled(mn, ImVec2(mn.x + px(4.0f), mx.y), imcol(th.text), r);
+        } else {
+            dl->AddRectFilled(mn, mx, imcol(th.panel), r);
+            dl->AddRect(mn, mx, imcol(th.border, 0.8f), r, 0, px(1));
+            // the section in view keeps its accent edge while the cursor is elsewhere
+            if (current) dl->AddRectFilled(mn, ImVec2(mn.x + px(4.0f), mx.y), imcol(th.accent), r);
+        }
+    }
+    if (!small) push_display_font();
+    const float lh = ImGui::GetTextLineHeight();
+    const float tx = mn.x + px(small ? 18.0f : 26.0f);
+    const float ty = mn.y + (h - lh) * 0.5f;
+    ImU32 fg = sel ? imcol(th.accent_text) : imcol(enabled ? th.text : th.text_muted);
+    if (sel && small) {
+        const float tri = px(7.0f);
+        const float cx = mn.x + px(6.0f), cy = mn.y + h * 0.5f;
+        dl->AddTriangleFilled(ImVec2(cx, cy - tri * 0.6f), ImVec2(cx, cy + tri * 0.6f), ImVec2(cx + tri, cy), fg);
+    }
+    dl->AddText(ImVec2(tx, ty), fg, label);
+    if (!small) pop_display_font();
+    float right_edge = mx.x - px(18.0f);
+    if (sel && !small) {
+        const float tri = px(11.0f);
+        const float cx = mx.x - px(30.0f), cy = mn.y + h * 0.5f;
+        dl->AddTriangleFilled(ImVec2(cx, cy - tri * 0.6f), ImVec2(cx, cy + tri * 0.6f), ImVec2(cx + tri, cy), fg);
+        right_edge = cx - px(16.0f);
+    }
+    if (value && value[0]) {
+        const float vw = ImGui::CalcTextSize(value).x;
+        const float vh = ImGui::GetTextLineHeight();
+        dl->AddText(ImVec2(right_edge - vw, mn.y + (h - vh) * 0.5f),
+                    sel ? imcol(th.accent_text, 0.75f) : imcol(th.text_muted), value);
+    }
+    return clk && enabled;
+}
+
+// PLAY, as the footer's CTA does it: the BIOS-mismatch prompt wins over a
+// launch, an image that cannot be prepared sends the player to the page that
+// owns the patch, and a launch commits the mod selection first.
+static bool console_play_enabled(LauncherModel* m) {
+    return launcher_model_can_launch(m) || launcher_model_bios_blocks_play(m);
+}
+static void console_play(LauncherModel* m) {
+    if (launcher_model_bios_blocks_play(m)) {
+        launcher_model_bios_play_prompt(m);
+    } else if (!launcher_model_prepare_rom_patch(m)) {
+        if (m->rom_patch_supported && m->s.rom_patch_enabled)
+            launcher_model_set_view(m, LNG_VIEW_MODS);
+    } else if (mod_commit_launch(m)) {
+        m->action = LNG_ACTION_LAUNCH;
+    }
+}
+
+// Tier colours for the badge row: the metal the licence was earned in.
+static LngColor badge_tint(int tier, const LauncherTheme& th) {
+    switch (tier) {
+        case 3:  return lng_rgba(0.96f, 0.77f, 0.26f, 1.0f);   // gold
+        case 2:  return lng_rgba(0.80f, 0.82f, 0.86f, 1.0f);   // silver
+        case 1:  return lng_rgba(0.77f, 0.48f, 0.23f, 1.0f);   // bronze
+        default: return lng_rgba(th.text.r, th.text.g, th.text.b, 0.32f);   // not earned
+    }
+}
+
+static void console_bar(const LauncherTheme& th, float w, float frac) {
+    ImDrawList* dl = ImGui::GetWindowDrawList();
+    ImVec2 p = ImGui::GetCursorScreenPos();
+    const float h = px(8.0f);
+    dl->AddRectFilled(p, ImVec2(p.x + w, p.y + h), imcol(th.control_hovered), h * 0.5f);
+    if (frac > 0.0f) {
+        float fw = w * frac;
+        if (fw < h) fw = h;
+        dl->AddRectFilled(p, ImVec2(p.x + fw, p.y + h), imcol(th.accent), h * 0.5f);
+    }
+    ImGui::Dummy(ImVec2(w, h));
+}
+
+// A dark card with the console panel's inset. Hugs its content.
+static bool console_card(const char* id, float w = 0.0f) {
+    ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(px(20.0f), px(12.0f)));
+    ImGui::PushStyleVar(ImGuiStyleVar_ChildRounding, px(3.0f));
+    // NavFlattened: the pad steps straight onto the rows inside, never onto
+    // the card as a whole.
+    bool ok = ImGui::BeginChild(id, ImVec2(w, 0.0f),
+                                ImGuiChildFlags_Borders | ImGuiChildFlags_AutoResizeY | ImGuiChildFlags_NavFlattened,
+                                ImGuiWindowFlags_NoScrollbar | ImGuiWindowFlags_NoScrollWithMouse);
+    ImGui::PopStyleVar(2);
+    return ok;
+}
+static void console_card_end() { ImGui::EndChild(); }
+
+// One "label ......... value" line inside a stat card.
+static void console_stat_line(const LauncherTheme& th, float w, const char* label, const char* value,
+                              const char* sub, bool accent, bool last) {
+    ImDrawList* dl = ImGui::GetWindowDrawList();
+    ImVec2 p = ImGui::GetCursorScreenPos();
+    push_display_font();
+    const float vh = ImGui::GetTextLineHeight();
+    ImVec2 vs = ImGui::CalcTextSize(value);
+    pop_display_font();
+    const float row_h = vh + px(8.0f);
+    float right = p.x + w;
+    if (sub && sub[0]) {
+        ImGui::SetWindowFontScale(0.9f);
+        ImVec2 ss = ImGui::CalcTextSize(sub);
+        dl->AddText(ImVec2(right - ss.x, p.y + (row_h - ss.y) * 0.5f + px(2.0f)), imcol(th.text_muted), sub);
+        ImGui::SetWindowFontScale(1.0f);
+        right -= ss.x + px(10.0f);
+    }
+    push_display_font();
+    dl->AddText(ImVec2(right - vs.x, p.y + (row_h - vh) * 0.5f), accent ? imcol(th.accent) : imcol(th.text), value);
+    pop_display_font();
+    const float lh = ImGui::GetTextLineHeight();
+    dl->AddText(ImVec2(p.x, p.y + (row_h - lh) * 0.5f), imcol(th.text_muted), label);
+    if (!last) dl->AddLine(ImVec2(p.x, p.y + row_h), ImVec2(p.x + w, p.y + row_h), imcol(th.border, 0.7f), px(1));
+    ImGui::Dummy(ImVec2(w, row_h + (last ? 0.0f : px(1.0f))));
+}
+
+// The save panel, carded: hero / stat groups side by side / bars / badges /
+// tiles, each in its own dark card on the faint backdrop. Empty and no-card
+// states use the same frame, so a fresh install reads as a finished page.
+static void draw_console_save_panel(LauncherModel* m, const LauncherTheme& th) {
+    const int card = (m->save_card == 1) ? 1 : 0;
+    const RecompLauncherCSaveSummary* s = &m->save_summary[card];
+    const bool have_card = m->s.memcard_path[card][0] != 0 && m->save_summary_ok[card];
+    ImDrawList* dl = ImGui::GetWindowDrawList();
+    const float availw = ImGui::GetContentRegionAvail().x;
+    const float gap = px(10.0f);
+
+    // Title row: eyebrow + title at the left, the card pills at the right.
+    {
+        const float top_y = ImGui::GetCursorPosY();
+        ImGui::BeginGroup();
+        console_eyebrow(ui_text("MEMORY CARD"), th);
+        push_display_font();
+        const char* title = (have_card && s->title[0]) ? s->title
+                          : (have_card && s->empty_title[0]) ? s->empty_title : ui_text("SAVE DATA");
+        ImGui::TextUnformatted(title);
+        pop_display_font();
+        ImGui::EndGroup();
+        const float ph = px(30.0f), pw = px(90.0f), pgap = px(6.0f);
+        ImGui::SetCursorPos(ImVec2(ImGui::GetCursorStartPos().x + availw - pw * 2 - pgap, top_y + px(8.0f)));
+        for (int i = 0; i < 2; ++i) {
+            if (i) ImGui::SameLine(0, pgap);
+            char id[16]; snprintf(id, sizeof(id), "##card%d", i);
+            ImVec2 p = ImGui::GetCursorScreenPos();
+            bool clk = ImGui::InvisibleButton(id, ImVec2(pw, ph), ImGuiButtonFlags_EnableNav);
+            const bool on = (i == card);
+            const bool hov = ImGui::IsItemHovered() || ImGui::IsItemFocused();
+            ImVec2 mx(p.x + pw, p.y + ph);
+            if (on) dl->AddRectFilled(p, mx, imcol(th.accent), ph * 0.5f);
+            else {
+                dl->AddRectFilled(p, mx, imcol(th.panel), ph * 0.5f);
+                dl->AddRect(p, mx, imcol(hov ? th.accent : th.border), ph * 0.5f, 0, px(1));
+            }
+            char lbl[16]; snprintf(lbl, sizeof(lbl), "%s %d", ui_text("CARD"), i + 1);
+            push_bold_font();
+            ImGui::SetWindowFontScale(0.85f);
+            ImVec2 ts = ImGui::CalcTextSize(lbl);
+            dl->AddText(ImVec2(p.x + (pw - ts.x) * 0.5f, p.y + (ph - ts.y) * 0.5f),
+                        on ? imcol(th.accent_text) : imcol(hov ? th.text : th.text_muted), lbl);
+            ImGui::SetWindowFontScale(1.0f);
+            pop_bold_font();
+            if (clk) m->save_card = i;
+            if (ImGui::IsItemHovered() && m->s.memcard_path[i][0])
+                ImGui::SetTooltip("%s", m->s.memcard_path[i]);
+        }
+        ImGui::Dummy(ImVec2(0, px(4.0f)));
+        ImVec2 u = ImGui::GetCursorScreenPos();
+        dl->AddLine(u, ImVec2(u.x + availw, u.y), imcol(th.accent, 0.9f), px(2));
+        ImGui::Dummy(ImVec2(0, gap));
+    }
+
+    if (!have_card || !s->present) {
+        if (console_card("empty")) {
+            const float cw = ImGui::GetContentRegionAvail().x;
+            const char* img = (have_card && s->empty_image[0]) ? s->empty_image : "";
+            const LauncherTexture& mark = dash_texture(img);
+            ImGui::Dummy(ImVec2(0, px(12.0f)));
+            if (mark.id && mark.w > 0) {
+                float mh = px(100.0f), mw = mh * (float)mark.w / (float)mark.h;
+                ImGui::SetCursorPosX(ImGui::GetCursorPosX() + (cw - mw) * 0.5f);
+                ImGui::ImageWithBg(tid(mark), ImVec2(mw, mh), ImVec2(0, 0), ImVec2(1, 1), ImVec4(0, 0, 0, 0), ImVec4(1, 1, 1, 0.75f));
+                ImGui::Dummy(ImVec2(0, px(10.0f)));
+            }
+            const char* head = !have_card ? ui_text("NO MEMORY CARD")
+                             : (s->empty_title[0] ? s->empty_title : ui_text("NO SAVE DATA ON THIS CARD"));
+            const char* text = !have_card
+                ? ui_text("Pick or create a card under Settings > Memory cards.")
+                : (s->empty_text[0] ? s->empty_text
+                   : ui_text("Start the game and save once; your progress shows up here."));
+            push_display_font();
+            ImVec2 hs = ImGui::CalcTextSize(head);
+            ImGui::SetCursorPosX(ImGui::GetCursorPosX() + (cw - hs.x) * 0.5f);
+            ImGui::TextUnformatted(head);
+            pop_display_font();
+            ImVec2 tsz = ImGui::CalcTextSize(text);
+            if (tsz.x < cw) ImGui::SetCursorPosX(ImGui::GetCursorPosX() + (cw - tsz.x) * 0.5f);
+            ImGui::PushTextWrapPos(ImGui::GetCursorPosX() + cw);
+            ImGui::TextColored(col(th.text_muted), "%s", text);
+            ImGui::PopTextWrapPos();
+            ImGui::Dummy(ImVec2(0, px(12.0f)));
+        }
+        console_card_end();
+        if (have_card && s->num_badges > 0) {
+            ImGui::Dummy(ImVec2(0, gap));
+            if (console_card("badges_empty")) {
+                console_eyebrow(s->badges_label[0] ? s->badges_label : ui_text("LICENSES"), th);
+                ImGui::SameLine(0, px(40.0f));
+                for (int i = 0; i < s->num_badges; ++i) {
+                    if (i) ImGui::SameLine(0, px(18.0f));
+                    const LauncherTexture& t = dash_texture(s->badges[i].image);
+                    if (t.id && t.w > 0) {
+                        float bh = px(40.0f), bw = bh * (float)t.w / (float)t.h;
+                        ImGui::ImageWithBg(tid(t), ImVec2(bw, bh), ImVec2(0, 0), ImVec2(1, 1), ImVec4(0, 0, 0, 0), col(badge_tint(0, th)));
+                    } else {
+                        ImGui::TextColored(col(th.text_muted), "%s", s->badges[i].label);
+                    }
+                }
+            }
+            console_card_end();
+        }
+        return;
+    }
+
+    // ---- hero card ---------------------------------------------------------
+    if (console_card("hero")) {
+        const LauncherTexture& hero = dash_texture(s->hero_image);
+        const float img_w = px(230.0f), img_h = px(62.0f);
+        ImGui::BeginGroup();
+        if (hero.id && hero.w > 0) {
+            float sc = std::min(img_w / (float)hero.w, img_h / (float)hero.h);
+            float w = hero.w * sc, h = hero.h * sc;
+            ImGui::SetCursorPos(ImVec2(ImGui::GetCursorPosX() + (img_w - w) * 0.5f, ImGui::GetCursorPosY() + (img_h - h) * 0.5f));
+            ImGui::Image(tid(hero), ImVec2(w, h));
+            ImGui::SetCursorPosY(ImGui::GetCursorPosY() + (img_h - h) * 0.5f);
+        } else {
+            ImGui::Dummy(ImVec2(img_w, img_h));
+        }
+        ImGui::EndGroup();
+        ImGui::SameLine(0, px(24.0f));
+        ImGui::BeginGroup();
+        ImGui::Dummy(ImVec2(0, px(2.0f)));
+        if (s->hero_label[0]) console_eyebrow(s->hero_label, th);
+        push_display_font();
+        ImGui::TextUnformatted(s->hero_text[0] ? s->hero_text : "-");
+        pop_display_font();
+        if (s->hero_sub[0]) ImGui::TextColored(col(th.text_muted), "%s", s->hero_sub);
+        ImGui::EndGroup();
+    }
+    console_card_end();
+    ImGui::Dummy(ImVec2(0, gap));
+
+    // ---- stat cards side by side --------------------------------------------
+    if (s->num_stats > 0) {
+        const char* groups[RECOMP_LAUNCHER_SAVE_STATS];
+        int ng = 0;
+        for (int i = 0; i < s->num_stats; ++i) {
+            bool seen = false;
+            for (int g = 0; g < ng; ++g) if (strcmp(groups[g], s->stats[i].group) == 0) { seen = true; break; }
+            if (!seen) groups[ng++] = s->stats[i].group;
+        }
+        const float colw = (availw - gap * (ng - 1)) / (float)ng;
+        for (int g = 0; g < ng; ++g) {
+            if (g) ImGui::SameLine(0, gap);
+            char id[24]; snprintf(id, sizeof(id), "stat%d", g);
+            if (console_card(id, colw)) {
+                const float cw = ImGui::GetContentRegionAvail().x;
+                if (groups[g][0]) console_eyebrow(groups[g], th);
+                ImGui::Dummy(ImVec2(0, px(2.0f)));
+                int last_i = -1;
+                for (int i = 0; i < s->num_stats; ++i) if (strcmp(s->stats[i].group, groups[g]) == 0) last_i = i;
+                for (int i = 0; i < s->num_stats; ++i) {
+                    const RecompLauncherCSaveStat* st = &s->stats[i];
+                    if (strcmp(st->group, groups[g]) != 0) continue;
+                    console_stat_line(th, cw, st->label, st->value, st->sub, st->accent != 0, i == last_i);
+                }
+            }
+            console_card_end();
+        }
+        ImGui::Dummy(ImVec2(0, gap));
+    }
+
+    // ---- bars ----------------------------------------------------------------
+    for (int i = 0; i < s->num_bars; ++i) {
+        const RecompLauncherCSaveBar* b = &s->bars[i];
+        char id[24]; snprintf(id, sizeof(id), "bar%d", i);
+        if (console_card(id)) {
+            const float cw = ImGui::GetContentRegionAvail().x;
+            const float y = ImGui::GetCursorPosY();
+            console_eyebrow(b->label, th);
+            if (b->value[0]) {
+                push_display_font();
+                ImVec2 vs = ImGui::CalcTextSize(b->value);
+                ImGui::SetCursorPos(ImVec2(ImGui::GetCursorStartPos().x + cw - vs.x, y - px(6.0f)));
+                ImGui::TextUnformatted(b->value);
+                pop_display_font();
+            }
+            ImGui::Dummy(ImVec2(0, px(2.0f)));
+            console_bar(th, cw, b->fraction);
+            if (b->sub[0] || b->sub_right[0]) {
+                ImGui::Dummy(ImVec2(0, px(4.0f)));
+                const float ly = ImGui::GetCursorPosY();
+                if (b->sub[0]) ImGui::TextColored(col(th.text_muted), "%s", b->sub);
+                if (b->sub_right[0]) {
+                    ImVec2 rs = ImGui::CalcTextSize(b->sub_right);
+                    ImGui::SetCursorPos(ImVec2(ImGui::GetCursorStartPos().x + cw - rs.x, ly));
+                    ImGui::TextColored(col(th.text_muted), "%s", b->sub_right);
+                }
+            }
+        }
+        console_card_end();
+        ImGui::Dummy(ImVec2(0, gap));
+    }
+
+    // ---- badges --------------------------------------------------------------
+    if (s->num_badges > 0) {
+        if (console_card("badges")) {
+            const float cw = ImGui::GetContentRegionAvail().x;
+            const float label_w = px(150.0f);
+            const float bh = px(42.0f);
+            const float top = ImGui::GetCursorPosY();
+            ImGui::SetCursorPosY(top + (bh - ImGui::GetTextLineHeight()) * 0.5f);
+            console_eyebrow(s->badges_label[0] ? s->badges_label : ui_text("BADGES"), th);
+            const float slot = (cw - label_w) / (float)s->num_badges;
+            for (int i = 0; i < s->num_badges; ++i) {
+                const RecompLauncherCSaveBadge* bd = &s->badges[i];
+                const LauncherTexture& t = dash_texture(bd->image);
+                const LngColor tint = badge_tint(bd->tier, th);
+                float bw = bh * 1.6f;
+                if (t.id && t.w > 0) bw = bh * (float)t.w / (float)t.h;
+                const float x0 = ImGui::GetCursorStartPos().x + label_w + slot * i + (slot - bw) * 0.5f;
+                ImGui::SetCursorPos(ImVec2(x0, top));
+                ImGui::BeginGroup();
+                if (t.id && t.w > 0) {
+                    ImGui::ImageWithBg(tid(t), ImVec2(bw, bh), ImVec2(0, 0), ImVec2(1, 1), ImVec4(0, 0, 0, 0), col(tint));
+                } else {
+                    ImVec2 p = ImGui::GetCursorScreenPos();
+                    dl->AddRect(p, ImVec2(p.x + bw, p.y + bh), imcol(tint), px(4.0f), 0, px(1.5f));
+                    ImGui::Dummy(ImVec2(bw, bh));
+                }
+                if (bd->sub[0]) {
+                    push_bold_font();
+                    ImGui::SetWindowFontScale(0.8f);
+                    ImVec2 ss = ImGui::CalcTextSize(bd->sub);
+                    ImGui::SetCursorPosX(x0 + (bw - ss.x) * 0.5f);
+                    ImGui::TextColored(bd->tier ? col(tint) : col(th.text_muted), "%s", bd->sub);
+                    ImGui::SetWindowFontScale(1.0f);
+                    pop_bold_font();
+                }
+                ImGui::EndGroup();
+                if (ImGui::IsItemHovered() && bd->label[0]) ImGui::SetTooltip("%s", bd->label);
+            }
+        }
+        console_card_end();
+        ImGui::Dummy(ImVec2(0, gap));
+    }
+
+    // ---- tiles ---------------------------------------------------------------
+    if (s->num_tiles > 0) {
+        if (console_card("tiles")) {
+            const float cw = ImGui::GetContentRegionAvail().x;
+            const float label_w = px(150.0f);
+            const float right_w = px(150.0f);
+            const float tile = px(40.0f), tgap = px(4.0f);
+            const float top = ImGui::GetCursorPosY();
+            const float block_h = tile + px(12.0f);
+            ImGui::SetCursorPosY(top + (block_h - ImGui::GetTextLineHeight()) * 0.5f - px(4.0f));
+            console_eyebrow(s->tiles_label[0] ? s->tiles_label : ui_text("TRACKS"), th);
+            if (s->tiles_hint[0]) {
+                ImGui::SetWindowFontScale(0.78f);
+                ImGui::PushTextWrapPos(ImGui::GetCursorStartPos().x + label_w - px(12.0f));
+                ImGui::TextColored(col(th.text_muted), "%s", s->tiles_hint);
+                ImGui::PopTextWrapPos();
+                ImGui::SetWindowFontScale(1.0f);
+            }
+            const float hint_bottom = ImGui::GetCursorPosY();
+            // tiles across the middle, as many per row as fit
+            const float area_w = cw - label_w - right_w;
+            int per_row = std::max(1, (int)((area_w + tgap) / (tile + tgap)));
+            // balance the rows (11 + 10, not 16 + 5)
+            if (s->num_tiles > per_row) { const int rows = (s->num_tiles + per_row - 1) / per_row; per_row = (s->num_tiles + rows - 1) / rows; }
+            const float x0 = ImGui::GetCursorStartPos().x + label_w;
+            float row_y = top;
+            for (int i = 0; i < s->num_tiles; ++i) {
+                const RecompLauncherCSaveTile* t = &s->tiles[i];
+                const int cidx = i % per_row;
+                if (i && cidx == 0) row_y += block_h + px(6.0f);
+                ImGui::SetCursorPos(ImVec2(x0 + cidx * (tile + tgap), row_y));
+                ImGui::BeginGroup();
+                const LauncherTexture& tex = dash_texture(t->image);
+                ImVec2 p = ImGui::GetCursorScreenPos();
+                const bool done = t->pips_max > 0 && t->pips >= t->pips_max;
+                if (tex.id && tex.w > 0) {
+                    float sc = std::min((tile - px(4.0f)) / (float)tex.w, (tile - px(4.0f)) / (float)tex.h);
+                    float w = tex.w * sc, h = tex.h * sc;
+                    ImVec2 a(p.x + (tile - w) * 0.5f, p.y + (tile - h) * 0.5f);
+                    dl->AddImage(tid(tex), a, ImVec2(a.x + w, a.y + h), ImVec2(0, 0), ImVec2(1, 1),
+                                 t->pips > 0 ? IM_COL32(255, 255, 255, 255) : IM_COL32(255, 255, 255, 90));
+                }
+                ImGui::Dummy(ImVec2(tile, tile));
+                if (t->pips_max > 0) {
+                    // dashes, one per difficulty
+                    const float dw = (tile - px(2.0f) * (t->pips_max - 1)) / (float)t->pips_max;
+                    ImVec2 c = ImGui::GetCursorScreenPos();
+                    for (int k = 0; k < t->pips_max; ++k) {
+                        ImVec2 a(c.x + k * (dw + px(2.0f)), c.y + px(2.0f));
+                        dl->AddRectFilled(a, ImVec2(a.x + dw, a.y + px(4.0f)),
+                                          k < t->pips ? imcol(th.accent) : imcol(th.text_muted, 0.35f), px(1.0f));
+                    }
+                    ImGui::Dummy(ImVec2(tile, px(8.0f)));
+                }
+                (void)done;
+                ImGui::EndGroup();
+                if (ImGui::IsItemHovered() && t->label[0]) {
+                    if (t->detail[0]) ImGui::SetTooltip("%s\n%s", t->label, t->detail);
+                    else              ImGui::SetTooltip("%s", t->label);
+                }
+            }
+            const float tiles_bottom = ImGui::GetCursorPosY();
+            // right: the summary, big
+            if (s->tiles_sub[0]) {
+                ImGui::SetCursorPos(ImVec2(ImGui::GetCursorStartPos().x + cw - right_w, top));
+                ImGui::BeginGroup();
+                ImGui::PushTextWrapPos(ImGui::GetCursorStartPos().x + cw);
+                // "Tracks cleared" small, the figure big when the host split
+                // them with a newline; otherwise the whole line muted, right-aligned
+                const char* nl = strchr(s->tiles_sub, '\n');
+                if (nl) {
+                    std::string small(s->tiles_sub, (size_t)(nl - s->tiles_sub));
+                    ImVec2 ss = ImGui::CalcTextSize(small.c_str());
+                    ImGui::SetCursorPosX(ImGui::GetCursorStartPos().x + cw - ss.x);
+                    ImGui::TextColored(col(th.text_muted), "%s", small.c_str());
+                    push_display_font();
+                    ImVec2 bs = ImGui::CalcTextSize(nl + 1);
+                    ImGui::SetCursorPosX(ImGui::GetCursorStartPos().x + cw - bs.x);
+                    ImGui::TextUnformatted(nl + 1);
+                    pop_display_font();
+                } else {
+                    ImVec2 ss = ImGui::CalcTextSize(s->tiles_sub);
+                    ImGui::SetCursorPosX(ImGui::GetCursorStartPos().x + cw - std::min(ss.x, right_w));
+                    ImGui::TextColored(col(th.text_muted), "%s", s->tiles_sub);
+                }
+                ImGui::PopTextWrapPos();
+                ImGui::EndGroup();
+            }
+            ImGui::SetCursorPosY(std::max(std::max(tiles_bottom, hint_bottom), ImGui::GetCursorPosY()));
+        }
+        console_card_end();
+    }
