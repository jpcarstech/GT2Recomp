 static int           g_video_texfilter_2d = 1;  /* filter 2D sprites/UI too (legacy on) */
 static int           g_video_texfilter_edge = 0;  /* [video] texture_edge_blending */
 static int           g_video_fmv_chroma = 0;      /* [video] fmv_chroma_smoothing */
+/* [video] hide_cursor_fullscreen: the mouse pointer is hidden while the window
+ * is fullscreen (borderless or exclusive) and nothing on screen wants it (the
+ * F1 menu shows it again); windowed keeps the pointer. Polled once per frame
+ * from the main loop so every way of entering fullscreen - config, launcher,
+ * hotkey, F1 - is covered without each site having to remember. */
+static int           g_hide_cursor_fullscreen = 1;
+static int           g_launcher_ui_scale = 100;   /* [launcher] ui_scale, percent */
+static void cursor_visibility_tick(SDL_Window* win, int menu_open) {
+    static int s_shown = -1;
+    if (!win) return;
+    const int fs = (SDL_GetWindowFlags(win) & SDL_WINDOW_FULLSCREEN) != 0;
+    const int want = !(g_hide_cursor_fullscreen && fs && !menu_open);
+    if (want == s_shown) return;
+    s_shown = want;
+#if defined(PSX_SDL3)
+    if (want) SDL_ShowCursor(); else SDL_HideCursor();
+#else
+    SDL_ShowCursor(want ? SDL_ENABLE : SDL_DISABLE);
+#endif
+}
 /* F1 "Texture filtering" choice index <-> renderer mode. The choice list is
  * the launcher's order (Nearest, Bilinear, 3-Point, JINC2, xBR, Scale2x,
  * Scale3x, MMPX, MMPX Enhanced, MMPX Advanced); renderer mode 3 (trilinear)
@@ -6898,6 +6918,19 @@ static int f1_title_switch_ready(void) {
            g_f1_title_map[g_f1_title_pending] != g_sibling_active;
 }
 
+/* [KeyMap] SwitchDisc: the launcher's "Switch to <next disc>" button as a
+ * hotkey - the next INSTALLED sibling after the active one, wrapping, so
+ * two discs toggle and three cycle. -1 when there is nothing to switch to. */
+static int sibling_next_installed(void) {
+    const int n = (int)g_sibling_titles.size();
+    if (g_sibling_active < 0 || n < 2) return -1;
+    for (int k = 1; k < n; ++k) {
+        const int i = (g_sibling_active + k) % n;
+        if (!g_sibling_titles[(size_t)i].exe.empty()) return i;
+    }
+    return -1;
+}
+
 static void stamp_active_title(PSXRecompV4::UserSettings& s) {
     if (g_sibling_active < 0 ||
         g_sibling_active >= (int)g_sibling_titles.size())
@@ -8092,6 +8125,19 @@ static NetplayVblankEpilogue sdl_vblank_present_body(void) {
                                            (int)key, (int)mod)) {
                     controller_port_route_toggle();
                 }
+                else if (!key_repeat &&
+                         host_keymap_match_event(HOST_KEYMAP_SWITCH_DISC,
+                                                 (int)key, (int)scancode,
+                                                 (int)mod)) {
+                    /* Same deferred shutdown + relaunch as F1 -> Switch disc
+                     * (g_f1_title_switch_target, applied by the main loop). */
+                    const int t = sibling_next_installed();
+                    if (t >= 0 && !psx_netplay_active() &&
+                        g_f1_title_switch_target < 0) {
+                        g_f1_title_switch_target = t;
+                        host_osd_push("Switching disc...", 1800);
+                    }
+                }
                 else if (key == SDLK_c && (mod & KMOD_CTRL)) {
                     std::fprintf(stdout, "[DEBUG] Forzando reinserción de CD...\n");
                     debug_force_cd_reinsert();
@@ -8145,6 +8191,7 @@ static NetplayVblankEpilogue sdl_vblank_present_body(void) {
         }
         savestate_menu_poll_toggle_buttons();
         rewind_poll_toggle_buttons();
+        cursor_visibility_tick(sdl_window, runtime_settings_menu_open);
         psx_rewind_note_frame();
         psx_rewind_present_tick((uint32_t)SDL_GetTicks());
         if (savestate_menu_open)
@@ -12942,6 +12989,7 @@ int main(int argc, char** argv) {
