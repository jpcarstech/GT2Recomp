 /* FMV present reconstruction (VIDEO_FMV_FILTER_*), pushed to the GL renderer
  * once the config is resolved. Only consulted while g_video_aa is on. */
 static int           g_video_fmv_filter = PSXRecompV4::VIDEO_FMV_FILTER_DEFAULT;
+/* [video] display_scaling (-1 = follow antialiasing; 0 nearest, 1 bilinear,
+ * 2 sharp) and fmv_crop (native rows trimmed top/bottom of an FMV frame). */
+static int           g_video_display_scaling = -1;
+static int           g_video_fmv_crop = 0;
+static void apply_display_scaling_settings(void) {
+#ifndef PSX_SDL_NO_RENDER
+    if (g_video_display_scaling >= 0)
+        g_video_aa = (g_video_display_scaling != 0);
+    gl_renderer_set_display_scaling(g_video_display_scaling);
+    gl_renderer_set_fmv_crop(g_video_fmv_crop);
+#endif
+}
 
 /* recomp-ui stores this 1-based so a zero-initialized (older) host reads as
  * "unset" rather than pinning nearest; the config enum is 0-based. Convert at
@@ -1192,6 +1204,12 @@ static inline int launcher_fmv_filter_to_cfg(int ls_value) {
         return PSXRecompV4::VIDEO_FMV_FILTER_DEFAULT;
     return ls_value - 1;
 }
+/* display_scaling: launcher 1 nearest / 2 bilinear / 3 sharp (0 unset);
+ * fmv_crop: launcher 1 off / 2 8px / 3 12px / 4 16px (0 unset). */
+static inline int cfg_display_scaling_to_launcher(int v) { return (v >= 0 && v <= 2) ? v + 1 : 0; }
+static inline int launcher_display_scaling_to_cfg(int v) { return (v >= 1 && v <= 3) ? v - 1 : -1; }
+static inline int cfg_fmv_crop_to_launcher(int px) { return px <= 0 ? 1 : px <= 8 ? 2 : px <= 12 ? 3 : 4; }
+static inline int launcher_fmv_crop_to_cfg(int v) { static const int t[5] = { 0, 0, 8, 12, 16 }; return (v >= 1 && v <= 4) ? t[v] : 0; }
 static inline int cfg_fmv_filter_to_launcher(int cfg_value) {
     if (cfg_value < 0 || cfg_value >= PSXRecompV4::VIDEO_FMV_FILTER_COUNT)
         cfg_value = PSXRecompV4::VIDEO_FMV_FILTER_DEFAULT;
@@ -6155,6 +6173,16 @@ extern "C" {
     float pgxp_tolerance(void);
     void pgxp_set_tolerance(float t);
 }
+static const char kDisplayScaling[]  = "graphics.display_scaling";
+static const char kFmvCrop[]         = "graphics.fmv_crop";
+static const char *const kDisplayScalingChoices[] = { "Nearest", "Bilinear", "Sharp bilinear" };
+static const char *const kFmvCropChoices[] = { "Off", "8 px", "12 px", "16 px" };
+static const int kFmvCropValues[] = { 0, 8, 12, 16 };
+static int fmv_crop_index(void) {
+    int best = 0;
+    for (int i = 1; i < 4; i++) if (abs(kFmvCropValues[i] - g_video_fmv_crop) < abs(kFmvCropValues[best] - g_video_fmv_crop)) best = i;
+    return best;
+}
 static const char kPgxpGeometry[]    = "pgxp.geometry";
 static const char kPgxpTexture[]     = "pgxp.texture";
 static const char kPgxpCulling[]     = "pgxp.culling";
@@ -6233,6 +6261,10 @@ static int runtime_ui_get_value(void*, const RecompRuntimeUiItem *item,
         *value_out = g_controller_ports_swapped ? 1 : 0;
     else if (std::strncmp(item->key, "pgxp.", 5) == 0)
         return pgxp_ui_get(item->key, value_out);
+    else if (std::strcmp(item->key, kDisplayScaling) == 0)
+        *value_out = g_video_display_scaling >= 0 ? g_video_display_scaling : (g_video_aa ? 1 : 0);
+    else if (std::strcmp(item->key, kFmvCrop) == 0)
+        *value_out = fmv_crop_index();
     else
         return 0;
     return 1;
@@ -6276,6 +6308,14 @@ static int runtime_ui_set_value(void*, const RecompRuntimeUiItem *item,
             controller_port_route_toggle();
     } else if (std::strncmp(item->key, "pgxp.", 5) == 0) {
         if (!pgxp_ui_set(item->key, value)) return 0;
+    } else if (std::strcmp(item->key, kDisplayScaling) == 0) {
+        if (value < 0 || value > 2) return 0;
