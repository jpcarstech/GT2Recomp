+/* ---- F1 sibling-title switch (multi-title installs) ----------------------
+ * The console-style disc change for installs where each disc is its own
+ * build (see discover_sibling_titles): a "Game disc" choice row cycles the
+ * INSTALLED titles, and a separate "Switch disc" action applies it — the
+ * two-step is the confirm, since the switch restarts into the other build.
+ * Quits through the normal shutdown path (memcards flushed, sockets closed,
+ * exit finisher spawned) and only then boots the picked exe, straight into
+ * the game (PSX_NO_LAUNCHER=1) — no launcher stop-over, like swapping a
+ * disc on the real console. */
+static void f1_titles_build(void) {
+    g_f1_title_choices.clear();
+    g_f1_title_map.clear();
+    g_f1_title_pending = -1;
+    if (g_sibling_active < 0 || g_sibling_titles.size() < 2) return;
+    for (size_t i = 0; i < g_sibling_titles.size(); ++i) {
+        /* Only installed titles are cyclable in-game (the launcher's row is
+         * where "not installed" is worth advertising). */
+        if (g_sibling_titles[i].exe.empty()) continue;
+        if ((int)i == g_sibling_active)
+            g_f1_title_pending = (int)g_f1_title_map.size();
+        g_f1_title_map.push_back((int)i);
+        g_f1_title_choices.push_back(g_sibling_titles[i].label.c_str());
+    }
+    if (g_f1_title_map.size() < 2 || g_f1_title_pending < 0) {
+        g_f1_title_choices.clear();
+        g_f1_title_map.clear();
+        g_f1_title_pending = -1;
+    }
+}
+
+static int f1_title_switch_ready(void) {
+    return g_f1_title_pending >= 0 &&
+           g_f1_title_pending < (int)g_f1_title_map.size() &&
+           g_f1_title_map[g_f1_title_pending] != g_sibling_active;
+}
+
+static void f1_title_switch_now(void) {
+    namespace fs = std::filesystem;
+    if (g_f1_title_switch_target < 0 ||
+        g_f1_title_switch_target >= (int)g_sibling_titles.size())
+        return;
+    const SiblingTitle& t =
+        g_sibling_titles[(size_t)g_f1_title_switch_target];
+    /* Remember the pick for the root stub + the next plain boot. */
+    {
+        const auto sp = settings_file_path(g_sibling_argv0.c_str());
+        auto us = PSXRecompV4::load_user_settings(sp);
+        if (!us.parse_error) {
+            us.active_title = t.dir_name;
+            us.has_active_title = true;
+            (void)PSXRecompV4::save_user_settings(sp, us);
+        }
+    }
+    /* Same clean path as double-Escape quit; only then start the sibling. */
+    psx_crash_trace_set_exit_origin("disc_title_switch");
+    shutdown_runtime();
+    const fs::path exe_dir = fs::path(t.exe).parent_path();
+    std::fprintf(stdout, "psxrecomp: disc switch -> %s\n", t.exe.c_str());
+#ifdef _WIN32
+    {
+        STARTUPINFOA si;
+        PROCESS_INFORMATION pi;
+        char cmd[1024];
+        std::memset(&si, 0, sizeof(si));
+        std::memset(&pi, 0, sizeof(pi));
+        si.cb = sizeof(si);
+        _putenv_s("PSX_NO_LAUNCHER", "1");   /* child inherits our env */
+        std::snprintf(cmd, sizeof(cmd), "\"%s\"", t.exe.c_str());
+        const std::string wd = exe_dir.string();
+        if (CreateProcessA(NULL, cmd, NULL, NULL, FALSE, 0, NULL,
+                           wd.empty() ? NULL : wd.c_str(), &si, &pi)) {
+            CloseHandle(pi.hThread);
+            CloseHandle(pi.hProcess);
+        } else {
+            std::fprintf(stderr,
+                         "psxrecomp: disc switch CreateProcess failed\n");
+        }
+        std::exit(0);
+    }
+#else
+    {
+        std::error_code ec;
+        fs::current_path(exe_dir, ec);
+        setenv("PSX_NO_LAUNCHER", "1", 1);
+        char exe_buf[512];
+        std::snprintf(exe_buf, sizeof(exe_buf), "%s", t.exe.c_str());
+        char* args[] = {exe_buf, nullptr};
+        execv(exe_buf, args);
+        std::fprintf(stderr, "psxrecomp: disc switch execv failed: %s\n",
+                     std::strerror(errno));
+        std::exit(1);
+    }
+#endif
+}
