 }
 
+/* The `index`-th distinct child segment under the current path, in the order
+ * the sections were declared. */
+static const char *level_child(const RecompRuntimeUi *ui, size_t index,
+                               size_t *out_len) {
+    const size_t depth = path_depth(ui->path);
+    size_t seen = 0;
+    for (size_t i = 0; i < ui->section_count; ++i) {
+        const char *sec = ui->sections[i];
+        if (!path_under(sec, ui->path)) continue;
+        size_t len = 0;
+        const char *seg = path_segment(sec, depth, &len);
+        if (!seg) continue;                 /* this section IS the level */
+        int known = 0;
+        for (size_t j = 0; j < i && !known; ++j) {
+            if (!path_under(ui->sections[j], ui->path)) continue;
+            size_t l2 = 0;
+            const char *s2 = path_segment(ui->sections[j], depth, &l2);
+            if (s2 && l2 == len && strncmp(s2, seg, len) == 0) known = 1;
+        }
+        if (known) continue;
+        if (seen++ == index) { *out_len = len; return seg; }
+    }
+    return NULL;
+}
+
+size_t recomp_runtime_ui_level_children(const RecompRuntimeUi *ui) {
+    size_t n = 0, len = 0;
+    if (!ui) return 0;
+    while (level_child(ui, n, &len)) ++n;
+    return n;
+}
+
+size_t recomp_runtime_ui_level_rows(const RecompRuntimeUi *ui) {
+    return recomp_runtime_ui_level_items(ui) + recomp_runtime_ui_level_children(ui);
+}
+
+const char *recomp_runtime_ui_child_label(const RecompRuntimeUi *ui, size_t index,
+                                          char *buf, size_t cap) {
+    size_t len = 0;
+    const char *seg = ui ? level_child(ui, index, &len) : NULL;
+    if (!cap) return buf;
+    if (!seg) { buf[0] = '\0'; return buf; }
+    if (len > cap - 1) len = cap - 1;
+    memcpy(buf, seg, len);
+    buf[len] = '\0';
+    return buf;
+}
+
+static void child_path(const RecompRuntimeUi *ui, size_t index,
+                       char *buf, size_t cap) {
+    char seg[96];
+    recomp_runtime_ui_child_label(ui, index, seg, sizeof seg);
+    if (ui->path[0]) snprintf(buf, cap, "%s/%s", ui->path, seg);
+    else             snprintf(buf, cap, "%s", seg);
+}
+
+const RecompRuntimeUiItem *recomp_runtime_ui_child_action(const RecompRuntimeUi *ui,
+                                                          size_t index) {
+    char full[192];
+    const RecompRuntimeUiItem *only = NULL;
+    if (!ui) return NULL;
+    child_path(ui, index, full, sizeof full);
+    for (size_t i = 0; i < ui->config.item_count; ++i) {
+        const char *sec = item_section(&ui->config.items[i]);
+        if (!path_under(sec, full)) continue;
+        if (!same_text(sec, full)) return NULL;   /* the child has children */
+        if (only) return NULL;                    /* more than one item */
+        only = &ui->config.items[i];
+    }
+    return (only && only->type == RECOMP_RUNTIME_UI_ACTION) ? only : NULL;
+}
+
+const char *recomp_runtime_ui_level_label(const RecompRuntimeUi *ui) {
+    if (!ui || !ui->path[0]) return "";
+    const char *slash = strrchr(ui->path, '/');
+    return slash ? slash + 1 : ui->path;
+}
