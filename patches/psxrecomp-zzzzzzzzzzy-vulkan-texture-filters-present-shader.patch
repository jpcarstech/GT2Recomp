+#define any_eq2(a, b1, b2) (eq(a,b1)||eq(a,b2))
+#define any_eq3(a, b1, b2, b3) (eq(a,b1)||eq(a,b2)||eq(a,b3))
+#define none_eq2(a, b1, b2) !any_eq2(a, b1, b2)
