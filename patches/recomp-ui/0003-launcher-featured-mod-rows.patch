+/* Promoted mod-feature row (GameInfo.featured_mod_rows): a first-class
+ * settings toggle backed by the same provider as the Mods page. Toggling
+ * flips every feature in feature_ids together (a headline feature plus its
+ * prerequisites, e.g. 60fps + the CPU overclock it needs to reach 60); the
+ * row reads as ON when feature_ids[0] is enabled. */
+typedef struct RecompLauncherCFeaturedModRow {
+    const char* label;       /* row label, e.g. "Frame rate" */
+    const char* off_label;   /* value text when off, e.g. "Original (30 fps)" */
+    const char* on_label;    /* value text when on,  e.g. "60 FPS" */
+    const char* help;        /* optional tooltip; NULL => none */
+    const char* package_id;  /* provider package the features live in */
+    const char* const* feature_ids;  /* flipped together; [0] is the state */
+    int num_feature_ids;
+} RecompLauncherCFeaturedModRow;
+
