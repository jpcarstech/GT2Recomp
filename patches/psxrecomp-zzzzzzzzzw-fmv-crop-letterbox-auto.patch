+
+/* Letterbox-band removal (part of fmv_crop). Many PS1 movies are authored
+ * wider than 4:3 and padded to the 240-line frame with pure-black rows (GT2:
+ * the Polyphony logo has 24 black rows top and bottom, the intro 28). Those
+ * rows are part of the picture data, so a fixed overscan trim never reaches
+ * them and the movie kept a black band above and below in the window.
+ * Detect them per frame - a row is black when every channel of every pixel
+ * is < 8 (MDEC black decodes to 0..3) - and drop them from the presented
+ * region. The remaining picture keeps its pixel aspect: it is fitted to the
+ * window at the aspect it would have had on a 4:3 CRT with the bands cut
+ * off, so a 16:9 movie fills the height of a 16:9 window with narrow pillars
+ * instead of sitting in a 4:3 rect with black bands inside it.
+ *
+ * Stability (bands are constant within a movie; only a dim or empty frame
+ * can fool a per-frame scan, and always towards MORE band):
+ *   - bands are symmetric, so the estimate for both sides is min(top, bottom)
+ *     - a black sky over a lit road never crops the road;
+ *   - a frame whose picture does not start within the top/bottom quarter
+ *     (a fade to black, a small object on black) is rejected and keeps the
+ *     previous value;
+ *   - the presented band is the minimum over the last 60 accepted frames, so
+ *     an over-estimate from a dim frame is overruled by any brighter frame
+ *     within a second, while a cut to a taller picture applies immediately;
+ *   - 15 consecutive rejected frames (a fade to black between movies) or a
+ *     gap in FMV presents clear the history, so the next movie starts fresh
+ *     instead of inheriting the previous one's bands. */
+#define FMV_BAND_HIST 60
+static int      s_fmv_band_hist[FMV_BAND_HIST];
+static int      s_fmv_band_n = 0, s_fmv_band_idx = 0, s_fmv_band_rejects = 0;
+static uint64_t s_fmv_band_last_frame = 0;
+static int      s_fmv_band_w = 0, s_fmv_band_h = 0;
+static int fmv_row_black(const uint32_t *row, int w) {
+    for (int x = 0; x < w; x++)
+        if (row[x] & 0x00F8F8F8u) return 0;
+    return 1;
+}
+static void fmv_letterbox_bands(const uint32_t *px, int w, int h, int *top, int *bot) {
+    *top = 0; *bot = 0;
+    if (!px || w <= 0 || h <= 0) return;
+    if (w != s_fmv_band_w || h != s_fmv_band_h ||
+        s_frame_count - s_fmv_band_last_frame > 30) {
+        s_fmv_band_n = 0; s_fmv_band_idx = 0; s_fmv_band_rejects = 0;
+        s_fmv_band_w = w; s_fmv_band_h = h;
+    }
+    s_fmv_band_last_frame = s_frame_count;
+    int lim = h / 4, t = 0, b = 0;
+    while (t < lim && fmv_row_black(px + (size_t)t * w, w)) t++;
+    while (b < lim && fmv_row_black(px + (size_t)(h - 1 - b) * w, w)) b++;
+    if (t < lim && b < lim) {
+        s_fmv_band_hist[s_fmv_band_idx] = t < b ? t : b;
+        s_fmv_band_idx = (s_fmv_band_idx + 1) % FMV_BAND_HIST;
+        if (s_fmv_band_n < FMV_BAND_HIST) s_fmv_band_n++;
+        s_fmv_band_rejects = 0;
+    } else if (++s_fmv_band_rejects >= 15) {
+        s_fmv_band_n = 0; s_fmv_band_idx = 0;      /* between movies */
+    }
+    if (s_fmv_band_n == 0) return;
+    int m = h;
+    for (int i = 0; i < s_fmv_band_n; i++)
+        if (s_fmv_band_hist[i] < m) m = s_fmv_band_hist[i];
+    *top = m; *bot = m;
+}
 void gl_renderer_present(const uint32_t *pixels, int src_w, int src_h, int linear,
                          int force_4_3, int content_w) {
     if (!s_ctx) return;
@@ -3753,7 +3817,34 @@ void gl_renderer_present(const uint32_t *pixels, int src_w, int src_h, int linea
     glViewport(0, 0, ww, wh);
     glClearColor(0.f,0.f,0.f,1.f); glClear(GL_COLOR_BUFFER_BIT);
     int lx, ly, lw, lh;
