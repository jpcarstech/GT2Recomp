         }
         if (video.contains("fmv_filter")) {
             const auto mode = toml::find<std::string>(video, "fmv_filter");
@@ -2431,6 +2435,7 @@ UserSettings load_user_settings(const fs::path& path) {
             else if (m == "bilinear") { s.texture_filter = 1; s.has_texture_filter = true; }
             else if (m == "3point") { s.texture_filter = 2; s.has_texture_filter = true; }
             else if (m == "trilinear") { s.texture_filter = 3; s.has_texture_filter = true; }
+            else if (m == "jinc2") { s.texture_filter = 4; s.has_texture_filter = true; }
         });
         if (v.contains("texture_filtering_2d")) try_get([&]{
             s.texture_filter_2d = toml::find<bool>(v, "texture_filtering_2d");
@@ -2792,9 +2797,9 @@ bool save_user_settings(const fs::path& path, const UserSettings& s) {
     if (s.has_texture_filter) {
         /* Persist every mode: the earlier bool-shaped serializer silently
          * downgraded 3-Point (N64) to "bilinear" across restarts. */
-        static const char* k_tf_names[4] =
-            { "nearest", "bilinear", "3point", "trilinear" };
-        const int tf = (s.texture_filter >= 0 && s.texture_filter <= 3)
+        static const char* k_tf_names[5] =
+            { "nearest", "bilinear", "3point", "trilinear", "jinc2" };
