+/* ---- promoted mod-feature rows ------------------------------------------ */
+static int lm_featured_find(const LauncherModel* m, const char* pkg,
+                            const char* fid, RecompLauncherCModFeature* out) {
+    int n, i;
+    if (!m || !m->mods || !m->mods->feature_count || !m->mods->feature_get)
+        return 0;
+    if (!pkg || !fid) return 0;
+    n = m->mods->feature_count(m->mods->ctx);
+    for (i = 0; i < n; ++i) {
+        RecompLauncherCModFeature f;
+        if (!m->mods->feature_get(m->mods->ctx, i, &f)) continue;
+        if (strcmp(f.package_id, pkg) == 0 && strcmp(f.id, fid) == 0) {
+            if (out) *out = f;
+            return 1;
+        }
+    }
+    return 0;
+}
+
+bool launcher_model_featured_row_available(const LauncherModel* m, int idx) {
+    const RecompLauncherCFeaturedModRow* r;
+    int i;
+    if (!m || idx < 0 || idx >= m->num_featured_mod_rows) return false;
+    r = &m->featured_mod_rows[idx];
+    if (!r->feature_ids || r->num_feature_ids <= 0) return false;
+    for (i = 0; i < r->num_feature_ids; ++i)
+        if (!lm_featured_find(m, r->package_id, r->feature_ids[i], NULL))
+            return false;
+    return true;
+}
+
+bool launcher_model_featured_row_enabled(const LauncherModel* m, int idx) {
+    const RecompLauncherCFeaturedModRow* r;
+    RecompLauncherCModFeature f;
+    if (!m || idx < 0 || idx >= m->num_featured_mod_rows) return false;
+    r = &m->featured_mod_rows[idx];
+    if (!r->feature_ids || r->num_feature_ids <= 0) return false;
+    if (!lm_featured_find(m, r->package_id, r->feature_ids[0], &f))
+        return false;
+    return f.enabled != 0;
+}
+
+void launcher_model_featured_row_set(LauncherModel* m, int idx, bool enabled) {
+    const RecompLauncherCFeaturedModRow* r;
+    int i;
+    if (!m || idx < 0 || idx >= m->num_featured_mod_rows) return;
+    if (!m->mods || !m->mods->feature_enable) return;
+    r = &m->featured_mod_rows[idx];
+    if (!r->feature_ids) return;
+    for (i = 0; i < r->num_feature_ids; ++i)
+        (void)m->mods->feature_enable(m->mods->ctx, r->package_id,
+                                      r->feature_ids[i], enabled ? 1 : 0);
+}
+
 bool launcher_model_title_installed(const LauncherModel* m, int idx) {
     if (!m || idx < 0 || idx >= m->num_titles) return false;
     if (!m->title_exe_paths) return false;
