     send_fmt("%s", buf);
 }
 
+/* pgxp_swc2 - per-site health of SXY shadows at swc2 of regs 12..14. */
+static void handle_pgxp_swc2(int id, const char *json)
+{
+    typedef struct { uint32_t pc, total, bad; uint8_t reg; } Site;
+    extern int pgxp_swc2_sites(void *out, int max);
+    extern void pgxp_swc2_sites_reset(void);
+    if (json_get_int(json, "reset", 0)) { pgxp_swc2_sites_reset(); send_fmt("{\"id\":%d,\"ok\":true,\"reset\":1}", id); return; }
+    Site st[96]; int n = pgxp_swc2_sites(st, 96);
+    char buf[8192]; int pos = snprintf(buf, sizeof(buf), "{\"id\":%d,\"ok\":true,\"sites\":[", id);
+    for (int i = 0; i < n && pos < (int)sizeof(buf) - 96; i++)
+        pos += snprintf(buf + pos, sizeof(buf) - pos, "%s{\"pc\":\"0x%08X\",\"reg\":%u,\"total\":%u,\"bad\":%u}",
+                        i ? "," : "", st[i].pc, (unsigned)st[i].reg, st[i].total, st[i].bad);
+    snprintf(buf + pos, sizeof(buf) - pos, "]}");
+    send_fmt("%s", buf);
+}
+
