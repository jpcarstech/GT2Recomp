+
+// ---- settings rows: one API, two skins ---------------------------------------
+// Every settings control is "label ... value". The classic dashboard draws
+// that as row_label() + a button / checkbox; the console front end draws a
+// full-width row a pad can land on - label at the left, the value in a pill
+// at the right, the focused row marked with an accent edge - and reads ◀ ▶
+// (D-pad, arrows, left stick) as previous / next value while the row is
+// focused, confirm as next. The row under the cursor also publishes its
+// help text, drawn once under the card. g_console_rows picks the skin.
+static bool g_console_rows = false;
+// ▶ on a section tile steps onto the first row of the page (ImGui's own
+// directional scoring is not reliable across the two columns); the tile
+// sets this, the first row drawn afterwards takes the focus.
+static bool s_console_enter_body = false;
+static bool s_console_focus_pill = false; // ▲ on the first row: the cursor goes up to the title pills
+static bool s_console_pills_drawn = false;
+static int  s_console_body_rows = 0;      // rows drawn so far this frame
+static int  s_console_body_rows_last = 0; // ... and last frame: a page with none leaves ▶ to ImGui
+static char s_row_help[512];
+static bool s_row_help_set = false;
+static bool s_console_focus_in_body = false;   // a row had nav focus this frame
+
+static void srow_publish_help(const char* help, bool sel) {
+    if (sel && help && help[0]) { snprintf(s_row_help, sizeof(s_row_help), "%s", help); s_row_help_set = true; }
+}
+
+// Console row chrome; returns the item's nav focus / hover, and leaves the
+// cursor placed for the value at the right. `value_w` is the pill width the
+// caller will draw (right-aligned); the row is the InvisibleButton itself.
+struct SRow { bool clicked, hovered, focused, sel; ImVec2 mn, mx; ImGuiID id; };
+static SRow srow_frame(const char* id, const char* label, const LauncherTheme& th, bool disabled) {
+    SRow r{};
+    const float w = ImGui::GetContentRegionAvail().x;
+    const float h = px(46.0f);
+    ImVec2 p = ImGui::GetCursorScreenPos();
+    if (s_console_enter_body && s_console_body_rows == 0 && !disabled) { ImGui::SetKeyboardFocusHere(); s_console_enter_body = false; }
+    if (!disabled) ++s_console_body_rows;
+    if (disabled) ImGui::BeginDisabled();
+    r.clicked = ImGui::InvisibleButton(id, ImVec2(w, h), ImGuiButtonFlags_EnableNav);
+    if (disabled) ImGui::EndDisabled();
+    r.id = ImGui::GetItemID();
+    r.hovered = !disabled && ImGui::IsItemHovered();
+    r.focused = !disabled && ImGui::IsItemFocused();
+    r.sel = r.hovered || r.focused;
+    if (r.focused) s_console_focus_in_body = true;
+    if (r.focused && s_console_body_rows == 1) {
+        // the top row owns ▲: it hands it to the title pills when the page
+        // has them (ImGui would not find them), else the cursor stays put
+        // instead of wandering into the section list
+        ImGui::SetKeyOwner(ImGuiKey_UpArrow, r.id);
+        ImGui::SetKeyOwner(ImGuiKey_GamepadDpadUp, r.id);
+        ImGui::SetKeyOwner(ImGuiKey_GamepadLStickUp, r.id);
+        if (s_console_pills_drawn &&
+            (ImGui::IsKeyPressed(ImGuiKey_UpArrow, false) || ImGui::IsKeyPressed(ImGuiKey_GamepadDpadUp, false) ||
+             ImGui::IsKeyPressed(ImGuiKey_GamepadLStickUp, false)))
+            s_console_focus_pill = true;
+    }
+    if (r.focused && s_console_body_rows == s_console_body_rows_last) {
+        // the bottom row owns ▼ for the same reason
+        ImGui::SetKeyOwner(ImGuiKey_DownArrow, r.id);
+        ImGui::SetKeyOwner(ImGuiKey_GamepadDpadDown, r.id);
+        ImGui::SetKeyOwner(ImGuiKey_GamepadLStickDown, r.id);
+    }
+    r.mn = p; r.mx = ImVec2(p.x + w, p.y + h);
+    ImDrawList* dl = ImGui::GetWindowDrawList();
+    if (r.sel) {
+        dl->AddRectFilled(r.mn, r.mx, imcol(th.accent, 0.10f));
+        dl->AddRectFilled(r.mn, ImVec2(r.mn.x + px(4.0f), r.mx.y), imcol(th.accent));
+    }
+    dl->AddLine(ImVec2(r.mn.x, r.mx.y), ImVec2(r.mx.x, r.mx.y), imcol(th.border, 0.7f), px(1));
+    const float lh = ImGui::GetTextLineHeight();
+    dl->AddText(ImVec2(r.mn.x + px(18.0f), r.mn.y + (h - lh) * 0.5f),
+                disabled ? imcol(th.text_muted, 0.6f) : imcol(th.text), ui_text(label));
+    return r;
+}
+
+static void srow_pill(const SRow& r, const char* text, const LauncherTheme& th, bool disabled, bool dim = false) {
+    ImDrawList* dl = ImGui::GetWindowDrawList();
+    push_bold_font();
+    ImVec2 ts = ImGui::CalcTextSize(text);
+    const float pw = std::max(px(150.0f), ts.x + px(40.0f)), ph = px(32.0f);
+    ImVec2 mx(r.mx.x - px(14.0f), r.mn.y + (r.mx.y - r.mn.y + ph) * 0.5f);
+    ImVec2 mn(mx.x - pw, mx.y - ph);
+    if (r.sel && !disabled) {
+        dl->AddRectFilled(mn, mx, imcol(th.accent), ph * 0.5f);
+        dl->AddText(ImVec2(mn.x + (pw - ts.x) * 0.5f, mn.y + (ph - ts.y) * 0.5f), imcol(th.accent_text), text);
+    } else {
+        dl->AddRectFilled(mn, mx, imcol(th.control, disabled ? 0.5f : 1.0f), ph * 0.5f);
+        dl->AddRect(mn, mx, imcol(th.border), ph * 0.5f, 0, px(1));
+        dl->AddText(ImVec2(mn.x + (pw - ts.x) * 0.5f, mn.y + (ph - ts.y) * 0.5f),
+                    (disabled || dim) ? imcol(th.text_muted) : imcol(th.text), text);
+    }
+    pop_bold_font();
+}
+
+// ◀ ▶ on a focused row belong to the row, not to nav.
+static int srow_direction(const SRow& r) {
+    if (!r.focused) return 0;
+    const ImGuiKey keys[] = { ImGuiKey_LeftArrow, ImGuiKey_RightArrow, ImGuiKey_GamepadDpadLeft,
+                              ImGuiKey_GamepadDpadRight, ImGuiKey_GamepadLStickLeft, ImGuiKey_GamepadLStickRight };
+    for (ImGuiKey k : keys) ImGui::SetKeyOwner(k, r.id);
+    if (ImGui::IsKeyPressed(ImGuiKey_RightArrow, true) || ImGui::IsKeyPressed(ImGuiKey_GamepadDpadRight, true) ||
+        ImGui::IsKeyPressed(ImGuiKey_GamepadLStickRight, true)) return +1;
+    if (ImGui::IsKeyPressed(ImGuiKey_LeftArrow, true) || ImGui::IsKeyPressed(ImGuiKey_GamepadDpadLeft, true) ||
+        ImGui::IsKeyPressed(ImGuiKey_GamepadLStickLeft, true)) return -1;
+    return 0;
+}
+
+// Value row. Returns +1 / -1 for next / previous (classic: a click is +1).
+static int srow_value(const char* id, const char* label, const char* value, const char* help,
+                      const LauncherTheme& th, float classic_w = 120.0f, bool disabled = false,
+                      float label_col_w = 0.0f) {
+    if (!g_console_rows) {
+        row_label(label, th, label_col_w);
+        ImGui::PushID(id);
+        if (disabled) ImGui::BeginDisabled();
+        const bool clk = ImGui::Button(ui_text(value), ImVec2(px(classic_w), px(30)));
+        if (disabled) ImGui::EndDisabled();
+        if (help && help[0] && ImGui::IsItemHovered(ImGuiHoveredFlags_DelayNormal | ImGuiHoveredFlags_AllowWhenDisabled))
+            ImGui::SetTooltip("%s", ui_text(help));
+        ImGui::PopID();
+        return clk ? 1 : 0;
+    }
+    SRow r = srow_frame(id, label, th, disabled);
+    srow_pill(r, ui_text(value), th, disabled);
+    srow_publish_help(help, r.sel);
+    if (disabled) return 0;
+    int d = srow_direction(r);
+    if (r.clicked) d = +1;
+    return d;
+}
+
+// On/off row. Returns true when the player flipped it.
+static bool srow_toggle(const char* id, const char* label, bool on, const char* help,
+                        const LauncherTheme& th, bool disabled = false, float label_col_w = 0.0f,
+                        const char* on_text = "On", const char* off_text = "Off") {
+    if (!g_console_rows) {
+        row_label(label, th, label_col_w);
+        ImGui::PushID(id);
+        if (disabled) ImGui::BeginDisabled();
+        bool v = on;
+        const bool changed = ImGui::Checkbox("##v", &v);
+        if (disabled) ImGui::EndDisabled();
+        if (help && help[0] && ImGui::IsItemHovered(ImGuiHoveredFlags_DelayNormal | ImGuiHoveredFlags_AllowWhenDisabled))
+            ImGui::SetTooltip("%s", ui_text(help));
+        ImGui::PopID();
+        return changed;
+    }
+    SRow r = srow_frame(id, label, th, disabled);
+    srow_pill(r, ui_text(on ? on_text : off_text), th, disabled, !on);
+    srow_publish_help(help, r.sel);
+    if (disabled) return false;
+    return r.clicked || srow_direction(r) != 0;
+}
+
+// Read-only row: a fact, not a control. Not focusable, so the cursor skips
+// it; the value is printed plain at the right in the colour given.
+static void srow_info(const char* id, const char* label, const char* value, const LngColor& color,
+                      const char* help, const LauncherTheme& th) {
+    if (!g_console_rows) {
+        row_label(label, th);
+        ImGui::TextColored(col(color), "%s", value);
+        return;
+    }
+    const float w = ImGui::GetContentRegionAvail().x;
+    const float h = px(40.0f);
+    ImVec2 p = ImGui::GetCursorScreenPos();
+    ImGui::Dummy(ImVec2(w, h));
+    const bool hov = ImGui::IsItemHovered();
+    ImDrawList* dl = ImGui::GetWindowDrawList();
+    dl->AddLine(ImVec2(p.x, p.y + h), ImVec2(p.x + w, p.y + h), imcol(th.border, 0.7f), px(1));
+    const float lh = ImGui::GetTextLineHeight();
+    dl->AddText(ImVec2(p.x + px(18.0f), p.y + (h - lh) * 0.5f), imcol(th.text_muted), ui_text(label));
+    push_bold_font();
+    ImVec2 vs = ImGui::CalcTextSize(value);
+    dl->AddText(ImVec2(p.x + w - px(28.0f) - vs.x, p.y + (h - vs.y) * 0.5f), imcol(color), value);
+    pop_bold_font();
+    srow_publish_help(help, hov);
+    (void)id;
+}
+
+// A row whose value is a custom control (stepper, path + Browse, combo):
+// console skin draws the row and places the cursor inside it at the right;
+// classic skin is row_label. Always pair with srow_custom_end().
+static SRow s_custom_row;
+static ImVec2 s_custom_resume;
+static void srow_custom_begin(const char* id, const char* label, const char* help, const LauncherTheme& th,
+                              float value_w, float label_col_w = 0.0f) {
+    if (!g_console_rows) { row_label(label, th, label_col_w); return; }
+    s_custom_row = srow_frame(id, label, th, false);
+    srow_publish_help(help, s_custom_row.sel);
+    s_custom_resume = ImGui::GetCursorPos();
+    // value area: right-aligned, vertically centred on the row
+    const float h = s_custom_row.mx.y - s_custom_row.mn.y;
+    ImGui::SetCursorScreenPos(ImVec2(s_custom_row.mx.x - px(14.0f) - value_w,
+                                     s_custom_row.mn.y + (h - px(30.0f)) * 0.5f));
+    ImGui::BeginGroup();
+}
+static void srow_custom_end() {
+    if (!g_console_rows) return;
+    ImGui::EndGroup();
+    ImGui::SetCursorPos(s_custom_resume);
+}
