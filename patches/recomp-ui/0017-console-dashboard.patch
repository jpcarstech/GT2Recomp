+        if (last_group != option.group) {
+            last_group = option.group;
+            ImGui::Spacing();
+            ImGui::TextColored(
+                col(th.accent), "%s",
+                last_group.empty() ? ui_text("Configuration")
+                                   : last_group.c_str());
+            ImGui::Separator();
+        }
+        draw_mod_feature_option(m, feature, option);
+    }
