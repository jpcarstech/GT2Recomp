+/* Controller hotkeys beyond rewind / save states: edge-triggered, same
+ * actions as the keyboard [KeyMap] rows. Fast-forward is a hold and is read
+ * where the keyboard turbo is (pad_turbo_hotkey_down). */
+static int  sibling_next_installed(void);
+static void fps_telemetry_toggle(void);
+static int pad_turbo_hotkey_down(void) {
+    return hotkey_pad_binding_down(g_hotkey_pad_extra[PSX_ASSIST_BIND_TURBO - PSX_ASSIST_EXTRA_FIRST]);
+}
+static void extra_pad_hotkeys_poll(void) {
+    static int was_down[PSX_ASSIST_EXTRA_COUNT];
+    for (int i = 0; i < PSX_ASSIST_EXTRA_COUNT; i++) {
+        const int down = hotkey_pad_binding_down(g_hotkey_pad_extra[i]);
+        const int edge = down && !was_down[i];
+        was_down[i] = down;
+        if (!edge) continue;
+        switch (PSX_ASSIST_EXTRA_FIRST + i) {
+        case PSX_ASSIST_BIND_SWITCH_DISC: {
+            const int t = sibling_next_installed();
+            if (t >= 0 && !psx_netplay_active() && g_f1_title_switch_target < 0) {
+                g_f1_title_switch_target = t;
+                host_osd_push("Switching disc...", 1800);
+            }
+            break;
+        }
+        case PSX_ASSIST_BIND_RUNTIME_MENU:
+            if (!psx_rewind_is_open() && !savestate_menu_open) runtime_settings_menu_toggle(0);
+            break;
+        case PSX_ASSIST_BIND_FULLSCREEN:
+            if (sdl_window) {
+                const Uint32 is_fs = SDL_GetWindowFlags(sdl_window) & SDL_WINDOW_FULLSCREEN;
+                if (is_fs) { SDL_SetWindowFullscreen(sdl_window, 0); host_osd_push("Windowed", 1500); }
+                else {
+                    Uint32 target = psx_fullscreen_flag_for_mode(g_fullscreen);
+                    if (target == 0) target = SDL_WINDOW_FULLSCREEN_DESKTOP;
+                    SDL_SetWindowFullscreen(sdl_window, target); host_osd_push("Fullscreen", 1500);
+                }
+            }
+            break;
+        case PSX_ASSIST_BIND_DISPLAY_PERF:
+            fps_telemetry_toggle();
+            break;
+        default: break;
+        }
+    }
+}
