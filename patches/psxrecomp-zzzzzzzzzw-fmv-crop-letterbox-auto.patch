+        int ocx = (s_fmv_crop * src_w) / src_h;   /* 4/3 of the rows at 320x240 */
+        fx0 = ocx; fx1 = src_w - ocx;
+        fy0 = bt > s_fmv_crop ? bt : s_fmv_crop;  /* band, or at least the overscan trim */
+        fy1 = src_h - (bb > s_fmv_crop ? bb : s_fmv_crop);
+        if (content_w > 0 && content_w < src_w && content_w - ocx > fx0 + 16)
+            fx1 = content_w - ocx;                /* depth24 margin: trailing garbage */
+        if (fx1 - fx0 >= 16 && fy1 - fy0 >= 16) fmv_region = 1;
+        else { fx0 = 0; fy0 = 0; fx1 = src_w; fy1 = src_h; }
+    }
+    if (fmv_region) {
+        /* Aspect of the region as it would appear on a screen of the base
+         * aspect showing the whole frame: base * ((fx1-fx0)/src_w) / ((fy1-fy0)/src_h). */
+        letterbox_rect_aspect(ww, wh, base_num * (fx1 - fx0) * src_h,
+                              base_den * src_w * (fy1 - fy0), &lx, &ly, &lw, &lh);
+    } else if (force_4_3)
         letterbox_rect_aspect(ww, wh, 4, 3, &lx, &ly, &lw, &lh);
     else
         letterbox_rect(ww, wh, &lx, &ly, &lw, &lh);
@@ -3775,7 +3866,7 @@ void gl_renderer_present(const uint32_t *pixels, int src_w, int src_h, int linea
     /* Optional trailing-column crop (depth24 margin): shrink the draw width
      * left-aligned so cleared black remains on the right — never stretch. */
     float uv_x1 = 1.f;
