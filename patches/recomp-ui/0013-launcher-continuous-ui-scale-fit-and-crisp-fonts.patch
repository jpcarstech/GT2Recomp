+
+/* Clamp a scale so design_w x design_h logical units fit avail_w x avail_h of
+ * the same units, then apply the readability floor. */
+static float ui_scale_fit(float s, int avail_w, int avail_h,
+                          int design_w, int design_h) {
+    if (design_w > 0 && design_h > 0 && avail_w > 0 && avail_h > 0) {
+        float fw = (float)avail_w / (float)design_w;
+        float fh = (float)avail_h / (float)design_h;
+        float fit = fw < fh ? fw : fh;
+        if (s > fit) s = fit;
+    }
+    if (s < LNG_MIN_UI_SCALE) s = LNG_MIN_UI_SCALE;
+    return s;
+}
