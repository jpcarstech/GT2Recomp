+                                         const unsigned char *rgb, int w, int h);
+        if (g_framerec_n > 0) {
+            int ww = 0, wh = 0;
+            SDL_GL_GetDrawableSize(s_win, &ww, &wh);
+            if (ww > 0 && wh > 0) {
+                unsigned char *rgb = (unsigned char *)malloc((size_t)ww * wh * 3);
+                if (rgb) {
+                    /* div x div box downsample before the PNG write (the encoder
+                     * writes stored blocks, so a full 4K frame would be ~25MB).
+                     * Rows are flipped here too (GL reads bottom-up). */
+                    char path[320];
+                    int dv = g_framerec_div < 1 ? 1 : g_framerec_div;
+                    int dw = ww / dv, dh = wh / dv;
+                    unsigned char *g =
+                        (unsigned char *)malloc((size_t)dw * dh * 3);
+                    p_glBindFramebuffer(PSXGL_FRAMEBUFFER, 0);
+                    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+                    glReadPixels(0, 0, ww, wh, GL_RGB, GL_UNSIGNED_BYTE, rgb);
+                    if (g) {
+                        const unsigned n = (unsigned)(dv * dv);
+                        for (int y = 0; y < dh; y++) {
+                            unsigned char *o = g + (size_t)y * dw * 3;
+                            for (int x = 0; x < dw; x++) {
+                                unsigned acc[3] = { 0, 0, 0 };
+                                for (int sy = 0; sy < dv; sy++) {
+                                    const unsigned char *row =
+                                        rgb + (size_t)(wh - 1 - (y * dv + sy)) * ww * 3
+                                            + (size_t)x * dv * 3;
+                                    for (int sx = 0; sx < dv; sx++)
+                                        for (int c = 0; c < 3; c++)
+                                            acc[c] += row[sx * 3 + c];
+                                }
+                                for (int c = 0; c < 3; c++)
+                                    o[x * 3 + c] = (unsigned char)(acc[c] / n);
+                            }
+                        }
+                        snprintf(path, sizeof path, "%s/frame_%05u.png",
+                                 g_framerec_dir, g_framerec_seq++);
+                        gl_framerec_write_png(path, g, dw, dh);
+                        free(g);
+                        g_framerec_n--;
+                    }
+                    free(rgb);
+                }
+            }
+        }
+    }
