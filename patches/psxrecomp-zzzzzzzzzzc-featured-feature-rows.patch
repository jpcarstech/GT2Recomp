+
+/* F1 "Frame rate" rows: the FIRST [runtime] featured_feature_row surfaced
+ * in-game as a choice + an apply action. Applying flips the row's features
+ * through the mod provider (persisted like any Patches-tab toggle) and, in
+ * a multi-title install, restarts the running title through the same
+ * deferred relaunch the disc switch uses — mod plans only commit at launch. */
+static const char kRuntimeFrameRate[]      = "system.frame_rate";
+static const char kRuntimeFrameRateApply[] = "system.frame_rate_apply";
+static int g_f1_framerate_pending = -1;    /* -1 = follow current; 0/1 */
+static const char* g_f1_framerate_choices[2] = {nullptr, nullptr};
+
+/* Current state of the first featured row per the provider. Returns 0/1;
+ * -1 when the row's features aren't all listed for this title (wrong disc /
+ * package missing) — the rows are disabled then. */
+static int f1_featured_row_state(void) {
+    if (g_featured_rows_cfg.empty()) return -1;
+    const RecompLauncherCModProvider* p =
+        PSXRecompV4::mod_runtime_launcher_provider();
+    if (!p || !p->feature_count || !p->feature_get) return -1;
+    const auto& row = g_featured_rows_cfg[0];
+    int found = 0;
+    int first_enabled = 0;
+    const int n = p->feature_count(p->ctx);
+    for (int i = 0; i < n; ++i) {
+        RecompLauncherCModFeature f;
+        if (!p->feature_get(p->ctx, i, &f)) continue;
+        if (row.package != f.package_id) continue;
+        for (size_t k = 0; k < row.features.size(); ++k) {
+            if (row.features[k] != f.id) continue;
+            ++found;
+            if (k == 0) first_enabled = f.enabled ? 1 : 0;
+        }
+    }
+    if (found < (int)row.features.size()) return -1;
+    return first_enabled;
+}
