+float4 admixK(float4 vX, float4 vE) {
+
+    float4 diff = vX - vE;
+
+    float mixFactor = dot(diff.rgb, diff.rgb) * 0.16666 + 0.5;
+
+    return mix(vX,vE,mixFactor);
